package: "http://example.net/structured_datatype/v1.0"
namespaces: [["nc", "http://niem-core"]]
roots: ["PersonName"]

PersonName = Record{1..*}
  1 first PersonFirstName optional
  2 middle PersonMiddleName optional
  3 last PersonLastName optional
  4 partial PartialIndicator optional

PersonFirstName = String
PersonMiddleName = String
PersonLastName = String
PartialIndicator = Boolean