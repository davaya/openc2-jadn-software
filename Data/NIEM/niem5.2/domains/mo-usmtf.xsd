  <xs:simpleType name="CauseAircraftLossCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the proximate cause to which the loss of specific aircraft is attributable.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AD-ARTY">
        <xs:annotation>
          <xs:documentation>Air Defense Artillery. Aircraft aerial loss resulted from action by hostile land or naval air defense artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AD-SAM">
        <xs:annotation>
          <xs:documentation>Air Defense Missile, Surface-To-Air. Aircraft aerial loss resulted from action by hostile land or naval air defense surface-to-air missile(s).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIR-BOMBS">
        <xs:annotation>
          <xs:documentation>Bombs, Aerial. Aircraft ground loss resulted from aerial bombing by enemy aircraft (high explosive and incendiary type free fall and guided bombs).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIR-STRFNG">
        <xs:annotation>
          <xs:documentation>Strafing, Aerial. Aircraft ground loss resulted from strafing by enemy aircraft using forward firing ordnance (bullets, shells, or rockets).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSN-OBSTL">
        <xs:annotation>
          <xs:documentation>Collision, Obstacle. Aircraft loss resulted from damage sustained during inflight collision with natural or man-made object (fixed or mobile) located on the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRASH">
        <xs:annotation>
          <xs:documentation>Impact, Surface. Aircraft loss resulted from crashing against a land or water surface.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FIELD-ARTY">
        <xs:annotation>
          <xs:documentation>Field Artillery. Aircraft ground loss resulted from artillery shelling.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FRND-FIRE">
        <xs:annotation>
          <xs:documentation>Friendly Fire. Aircraft loss resulted from friendly fire.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GND-ACDNT">
        <xs:annotation>
          <xs:documentation>Accident, Ground. Aircraft loss resulted from damage sustained during ground operations or maintenance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GUN-AA">
        <xs:annotation>
          <xs:documentation>Gunnery, Air-to-Air. Aircraft loss resulted from hostile bullet or shell fire during air-to-air combat.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
