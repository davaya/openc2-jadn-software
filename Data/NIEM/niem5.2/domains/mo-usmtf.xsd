    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="EmitterNameSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for an assigned name of a particular emitter, operation or station.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[\-\.,\(\)\?A-Z0-9&amp;#x20;]{1,10}">
        <xs:annotation>
          <xs:documentation>If the emitter nickname exceeds the field length, abbreviate with recognized abbreviations. If no nickname is assigned, report the nomenclature if known. If reporting AN/XXX-XX equipment, omit the initial "AN/" e.g., use "FPS 2" for "AN/FPS 2." If necessary, use a free-text set to enter the emitter.</xs:documentation>
        </xs:annotation>
      </xs:pattern>
    </xs:restriction>
  </xs:simpleType>
