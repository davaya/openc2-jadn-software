        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="R">
        <xs:annotation>
          <xs:documentation>Right Direction. The defined orbit is to the right of the line connecting the first and second points. Plotting instruction: start at first point. Go to the second point. Turn right for 180 degrees with an arc radius of 1/2 of the orbit width. Complete the pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
