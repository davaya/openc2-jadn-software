  <xs:simpleType name="GraphicShapeCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the shape of the graphic to be displayed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AREA">
        <xs:annotation>
          <xs:documentation>Area. Sequence of grid ref describes an area clockwise; the first field may not be repeated at the end to close the line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARROW">
        <xs:annotation>
          <xs:documentation>Arrow. The first grid ref describes the beginning (arrow head or point) and the second grid ref describes the end of the arrow.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CIRCLE">
        <xs:annotation>
          <xs:documentation>Circle. Each pair of grid ref define the center of a circle (first point) and one point on the radius of this circle (second point).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ELL">
        <xs:annotation>
          <xs:documentation>Ellipse. The first grid ref describes the center of the ellipse; the second grid ref describes the end of the semi-major axis; the third grid ref describes the end of the semi-minor axis of the ellipse.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LINE">
        <xs:annotation>
          <xs:documentation>Line. Sequence of grid ref describes a line from rear to front and from left to right facing the front.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POINT">
        <xs:annotation>
          <xs:documentation>Point. Each grid ref is displayed as a dot.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SECTOR">
        <xs:annotation>
          <xs:documentation>Sector. The first grid ref describes the left end of the sector (facing the front); each subsequent pair of grid ref describes the center and the right end of the portions of circle defining the sector.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
