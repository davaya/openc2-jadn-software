  <xs:simpleType name="CargoHandlingEquipmentCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of machines for hoisting cargo and heavy weights, moving them horizontally, and lowering them to new locations.</xs:documentation>
