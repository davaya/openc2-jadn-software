  <xs:simpleType name="AbbreviatedActionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for an indicator of action to be taken upon receipt of the message.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:documentation>Add Event Information. Used for initial report. Event information to be added to data base.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation>
          <xs:documentation>Delete Event Information. Used to cancel previous report. Event information is to be deleted from data base.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="R">
        <xs:annotation>
          <xs:documentation>Revise Event Information. Used to revise previous report. Event information in data base is incorrect and is to be updated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
