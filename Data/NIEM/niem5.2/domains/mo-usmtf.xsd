  <xs:simpleType name="ReceiverFuelCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of fuel for the receiver aircraft.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:documentation>100/130 Grade.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AA">
        <xs:annotation>
          <xs:documentation>115/145 Grade.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:documentation>80/87 Grade.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DF">
        <xs:annotation>
          <xs:documentation>Diesel Fuel. General classification of diesel fuels.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F18">
        <xs:annotation>
          <xs:documentation>F-18 Aviation Grade Gasoline. F-18 is aviation grade 100/130 gasoline. Equivalent to grade 100 gasoline low lead (blue). (STANAG 1135; MIL-STD-3004)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F24">
        <xs:annotation>
          <xs:documentation>F-24 Aviation Turbine Fuel. F-24 is commercial Jet A containing the jet fuel system icing inhibitor (FSII) S-1745, lubricity improving additive (LIA) S-1747, and static dissipater additive (SDA) dissipater additive (SDA) Stadis 450. Equivalent to Jet A. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F27">
        <xs:annotation>
          <xs:documentation>F-27 Aviation Turbine Fuel. F-27 is F-24 containing the jet fuel thermal stability improver additive S-1749. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F34">
        <xs:annotation>
          <xs:documentation>F-34 Aviation Turbine Fuel. F-34 contains static dissipater additive, corrosion inhibitor/lubricity improver, and fuel system icing inhibitor, and may contain antioxidant and metal deactivator. Equivalent to JP-8. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F35">
        <xs:annotation>
          <xs:documentation>F-35 Aviation Turbine Fuel. F-35 contains a static dissipater additive, and may contain antioxidant, corrosion inhibitor/lubricity improver, and metal deactivator but will not contain fuel system icing inhibitor. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F37">
        <xs:annotation>
          <xs:documentation>F-37 Aviation Turbine Fuel. F-37 is F-34 containing the jet fuel thermal stability improver additive S-1749. Equivalent to JP-8+100. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F40">
        <xs:annotation>
          <xs:documentation>F-40 Aviation Turbine Fuel. F-40 is a wide cut aviation turbine fuel containing the fuel system icing inhibitor (FSII) S1745. Equivalent to JP-4. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F44">
        <xs:annotation>
          <xs:documentation>F-44 Aviation Turbine Fuel. F-44 is a high flash point, aviation turbine fuel containing the fuel system icing inhibitor S1745. Equivalent to JP-5. (STANAG 1135; AFLP-3747)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="J">
        <xs:annotation>
          <xs:documentation>Jet Fuel, Type Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JETA">
        <xs:annotation>
          <xs:documentation>Jet A Aviation Turbine Fuel. Jet A is commercial Jet A containing the corrosion inhibitor/lubricity improver (CI/LI), fuel system inhibitor (FSII), and conductivity additives. Equivalent to NATO F-24. (MIL-STD-1518)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JETAA1">
        <xs:annotation>
          <xs:documentation>Jet A/Jet A1 Aviation Turbine Fuel. Jet A/Jet A1 are commercial aviation turbine engine fuels. (MIL-STD-1518)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JP4">
        <xs:annotation>
          <xs:documentation>JP-4 Aviation Turbine Fuel. JP-4 is a wide cut aviation turbine fuel. Equivalent to NATO F-40. (MIL-DTL-5624</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JP5">
        <xs:annotation>
          <xs:documentation>JP-5 Aviation Turbine Fuel. JP-5 is a high flash point aviation turbine fuel containing both fuel system inhibitor (FSII) and corrosion inhibitor/lubricity improver (CI/LI). Equivalent to NATO F-44. (MIL-STD-1518)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JP7">
        <xs:annotation>
          <xs:documentation>JP-7 Aviation Turbine Fuel. JP-7 is a low volatility aviation turbine fuel. (MIL-DTL-38219)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JP8">
        <xs:annotation>
          <xs:documentation>JP-8 Aviation Turbine Fuel. JP-8 is the standard fuel for US Army and USAF turbine engine powered aircraft and for some shore based Navy aircraft. JP-8 is similar to commercial Jet A-1 with the addition of corrosion inhibitor/lubricity improver (CI/LI), fuel system inhibitor (FSII), and conductivity additives. JP-8 is the standard fuel for NATO use in Europe. Equivalent to NATO F-34. (MIL-STD-1518)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JP8100">
        <xs:annotation>
          <xs:documentation>JP-8+100 Aviation Turbine Fuel. JP-8+100 is JP-8 containing a thermal stability additive. Equivalent to NATO F-37. (MIL-STD-1518)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TA">
        <xs:annotation>
          <xs:documentation>Jet Fuel ASTM Type A.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TA1">
        <xs:annotation>
          <xs:documentation>Jet Fuel ASTM Type A-1 With Ice Inhibitor.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TA2">
        <xs:annotation>
          <xs:documentation>Jet Fuel ASTM Type A-1 Without Ice Inhibitor.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TAP">
        <xs:annotation>
          <xs:documentation>Jet A Fuel Type, Kerosene With Icing Inhibitor, (FLIP A+).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TB">
        <xs:annotation>
          <xs:documentation>Jet Fuel ASTM Type B.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TBP">
        <xs:annotation>
          <xs:documentation>Jet B Fuel Type, With Icing Inhibitor, (FLIP B+).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
