  <xs:simpleType name="FunctionalDamageAssessmentCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for an estimate of the degradation or destruction of the functional/operational capability of a target to perform its intended mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABN">
        <xs:annotation>
          <xs:documentation>Abandoned. The primary target has departed, withdrawn, or no longer exists.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DES">
        <xs:annotation>
          <xs:documentation>Functionally Destroyed. The critical element(s) of the target has sustained damage rendering the target unusable for its original purpose. Target is incapable of supporting combat or production operations without repair or replacement of critical elements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LT">
        <xs:annotation>
          <xs:documentation>Light Functional Damage. The critical element(s) of the target has sustained damage, causing less than a 15 percent decrease in normal operational capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOD">
        <xs:annotation>
          <xs:documentation>Moderate Functional Damage. The critical element(s) of the target has sustained damage, causing 15 to 45 percent decrease in normal operational capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NO">
        <xs:annotation>
          <xs:documentation>No Functional Damage. The target is undamaged or has sustained no or minimal damage to critical element(s) causing no decrease in normal functional capability. The target is fully operational or capable of action (e.g., mission ready).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SVR">
        <xs:annotation>
          <xs:documentation>Severe Functional Damage. The critical element(s) of the target has sustained damage, causing greater than 45 percent decrease in normal operational capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown Functional Damage.</xs:documentation>
        </xs:annotation>
