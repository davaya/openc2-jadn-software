  <xs:simpleType name="FireMethodCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the firing method used in a fire mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AF">
        <xs:annotation>
          <xs:documentation>Adjust Fire. A method of fire in which an observer observes and corrects the fall of shot onto a target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNIL">
        <xs:annotation>
          <xs:documentation>Continuous Illumination. A method of fire in which illuminating rounds are fired to provide continuous illumination of the target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRIL">
        <xs:annotation>
          <xs:documentation>Coordinated Illumination. A method of fire in which rounds of illuminating ammunition are fired in coordination with the explosive rounds to provide optimum illumination at the time of impact of high explosive rounds.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FFE">
        <xs:annotation>
          <xs:documentation>Fire for Effect. A method of fire in which the type and quantity of ammunition authorized is to be fired as quickly as possible. Fire for effect is commonly referred to as FFE.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FM">
        <xs:annotation>
          <xs:documentation>Fire Mission. A required warning order to call for Naval Surface Fire (NSF) support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFFE">
        <xs:annotation>
          <xs:documentation>Repeat Fire for Effect. A method of fire in which Fire for Effect (FFE) is fired again.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SFFE">
        <xs:annotation>
          <xs:documentation>Spreading Fire, Fire for Effect. A method of fire used in Naval Surface Fire (NSF) in which the NSF ship is informed that Fire for Effect (FFE) will be adjusted and repeated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
