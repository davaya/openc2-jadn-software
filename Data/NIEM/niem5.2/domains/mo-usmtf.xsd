  <xs:simpleType name="PhysicalStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the physical condition or state of being of a facility, installation or place.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABN">
        <xs:annotation>
          <xs:documentation>Abandoned. No longer occupied, used or maintained and not in condition to be of use without major renovation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARM">
        <xs:annotation>
          <xs:documentation>Armed. Weapon has been armed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COM">
        <xs:annotation>
          <xs:documentation>Complete. All construction of the facility has been accomplished. Equipment may or may not be present.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DMG">
        <xs:annotation>
          <xs:documentation>Damaged. Facility has been rendered inoperable but may be repaired or restored to a usable condition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DST">
        <xs:annotation>
          <xs:documentation>Destroyed. Cannot function as intended nor be repaired or restored to an operational status.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ELM">
        <xs:annotation>
          <xs:documentation>Eliminated. Buildings and other man-made facilities have been razed or removed and the location is returning to or has returned to a natural state.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MAN">
        <xs:annotation>
          <xs:documentation>Maintained. Kept in repair to receive equipment with minimum of maintenance. Facility not operational.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEG">
        <xs:annotation>
          <xs:documentation>Negated. Presence of a facility has not been established at or near the reported coordinates.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NTR">
        <xs:annotation>
          <xs:documentation>Neutralized. Rendered physically incapable of performing its intended function.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UCO">
        <xs:annotation>
          <xs:documentation>Under Construction. Construction, repair, or structural modification is in progress. Facility is not operational.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. The physical condition of a facility has not been determined.</xs:documentation>
        </xs:annotation>
