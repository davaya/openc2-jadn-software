        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HED">
        <xs:annotation>
          <xs:documentation>Dual Purpose ICM (Applicable 155MM, 203MM, MLRS). Dual purpose ICM projectile is to be used.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HEI">
        <xs:annotation>
          <xs:documentation>Improved Conventional Munition (ICM) (Applicable 105MM, 155MM, 203MM, and Lance). Improved conventional high explosive munition is to be used.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HEO">
        <xs:annotation>
          <xs:documentation>Rocket-Assisted Projectile, Rocket Off (Applicable 105MM, 155MM, 203MM). Rocket-assisted high explosive projectile is to be used with rocket off.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HER">
        <xs:annotation>
          <xs:documentation>Rocket-Assisted Projectile, Rocket On (Applicable 105MM, 155MM, 203MM). Rocket-assisted high explosive projectile is to be used with rocket on.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HES">
        <xs:annotation>
          <xs:documentation>HE Spotting (Applicable 203MM). Projectile, HE spotting is to be used.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ILL">
