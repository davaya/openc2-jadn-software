  <xs:simpleType name="ArmyEchelonLevelCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the lowest structural level, echelon, or point at which army organization control of authority of the subject unit is concentrated.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AIRARMY">
        <xs:annotation>
          <xs:documentation>Air Army.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRCMD">
        <xs:annotation>
          <xs:documentation>Air Command.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRCONP">
        <xs:annotation>
          <xs:documentation>Air Control Party.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRCRPS">
        <xs:annotation>
          <xs:documentation>Air Corps.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRDET">
        <xs:annotation>
          <xs:documentation>Air Detachment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRDIV">
        <xs:annotation>
          <xs:documentation>Air Division.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRELMT">
        <xs:annotation>
          <xs:documentation>Air Element.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRFLT">
        <xs:annotation>
          <xs:documentation>Airflight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRGP">
        <xs:annotation>
          <xs:documentation>Air Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRRGT">
        <xs:annotation>
          <xs:documentation>Air Regiment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRSQ">
        <xs:annotation>
          <xs:documentation>Air Squadron.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRWG">
        <xs:annotation>
          <xs:documentation>Air Wing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMY">
        <xs:annotation>
          <xs:documentation>Army. The Army is the largest administrative and tactical organization capable of independent operations. It consists of two or more Corps, service and support units, and may include other separate tactical organizations including divisions and combat units. (In the zone of the interior an army area may be administered by a numbered army headquarters, which is charged primarily with recruiting, equipping, and training reserve personnel and units.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMYGP">
        <xs:annotation>
          <xs:documentation>Army Group. The army group is organized to direct the strategic and tactical operations of two or more field armies and supporting units. May consist of field armies as well as separate corps and/or divisions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASG">
        <xs:annotation>
          <xs:documentation>Area Support Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BDE">
        <xs:annotation>
          <xs:documentation>Brigade. An army unit usually smaller than a division to which are attached groups, regiments, and/or battalions and smaller units tailored to meet anticipated requirements. Equates to the combat command of an armored division.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BDEHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Brigade.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BN">
        <xs:annotation>
          <xs:documentation>Battalion. A tactical and administrative unit consisting of two or more companies or batteries, normally subordinate to a group, regiment, or brigade, but may be employed separately, operating as an independent unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BNGP">
        <xs:annotation>
          <xs:documentation>Battalion Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BNGPHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Battalion Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BNHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Battalion.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRDHQ">
        <xs:annotation>
          <xs:documentation>Border District Headquarters. A territorial command or headquarters of the former USSR organized along the frontier and under the control of the main directorate of border troops or the Committee of State Security.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BTY">
        <xs:annotation>
          <xs:documentation>Battery. A tactical and administrative artillery unit usually equating to a company or similar unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BTYHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Battery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMD">
        <xs:annotation>
          <xs:documentation>Command. A regional or area command (as a Military District Command) which is configured and manned in accordance with an official authorization or directive. May also be an organizational or unit Command (as a logistics Command) which is part of a superior organization.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CO">
        <xs:annotation>
          <xs:documentation>Company. The basic administrative and tactical unit in most army ground forces, on a command level below a battalion and above a platoon. It is usually equivalent to a battery of artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COGP">
        <xs:annotation>
          <xs:documentation>Company Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COGPHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Company Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Company.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORPS">
        <xs:annotation>
          <xs:documentation>Corps. A unit organized to operate tactically as part of a field army, or tactically and administratively as a separate or independent Corps. Consists of two or more divisions, service and support units, and may include other separate tactical organizations (such as separate brigades, armored cavalry regiments, etc.). (in the zone of the interior of a corps area, which is usually part of an army area, may be administered by a corps headquarters which is charged primarily with recruiting, equipping, and training reserve personnel and units.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORPSHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Corps.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DAG">
        <xs:annotation>
          <xs:documentation>Divisional Artillery Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DARTYHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Division Artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DET">
        <xs:annotation>
          <xs:documentation>Detachment. Part of a unit separated from its main organization for duty elsewhere--may be any independent unit so designated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIV">
        <xs:annotation>
          <xs:documentation>Division. In the U.S. Army the division is the basic self-contained tactical and administrative ground combat unit. Usually the subordinate echelon of a Corps, it consists of two or more regiments plus service and supporting units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIVHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Division.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation>
          <xs:documentation>Fleet.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FRNT">
        <xs:annotation>
          <xs:documentation>Front. Used in conjunction with ground forces of the former USSR.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GP">
        <xs:annotation>
          <xs:documentation>Group. An administrative and tactical unit consisting of two or more battalions. Usually smaller than a regiment or brigade and may be subordinate to either.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GPFRCS">
        <xs:annotation>
          <xs:documentation>Group of Forces. Used in conjunction with ground forces of the former USSR.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GPFRNT">
        <xs:annotation>
          <xs:documentation>Group of Fronts. Used in conjunction with ground forces of the former USSR.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="KMDTR">
        <xs:annotation>
          <xs:documentation>Komendatura. A tactical unit of the former USSR with a strength varying from 200- 500 men. Subordinate to the Otryad.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MC">
        <xs:annotation>
          <xs:documentation>Mission Command.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEF">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEFFWD">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Force Forward.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEU">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MFLEET">
        <xs:annotation>
          <xs:documentation>Major Fleet. Permanent organization of ships, aircraft, marines, and shore-based support activities under a single command exercising both operational and administrative control.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVDET">
        <xs:annotation>
          <xs:documentation>Naval Detachment. A part of a naval organization that is separated from its main organization for special duty elsewhere.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVDIV">
        <xs:annotation>
          <xs:documentation>Naval Division. A number of naval ships (two or more) of similar type grouped together for operational and administrative control.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVFOR">
        <xs:annotation>
          <xs:documentation>Naval Force. A major subdivision or task force of a numbered fleet, consisting of ships, marines, aircraft, or a combination thereof. Naval forces do not ordinarily have their own shore establishments.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVGP">
        <xs:annotation>
          <xs:documentation>Naval Group. A flexible administrative or tactical organization composed of two or more squadrons of ships, but not necessarily ships of the same type. A naval group may be a subdivision of a naval force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVSEC">
        <xs:annotation>
          <xs:documentation>Naval Section. A tactical subdivision of a naval division of ships. It is normally one-half of a division of ships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAVSQ">
        <xs:annotation>
          <xs:documentation>Naval Squadron. An organizational element consisting of two or more divisions of ships and assigned tenders. It is normally, but not necessarily, composed of ships of the same type.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NDHQ">
        <xs:annotation>
          <xs:documentation>National Defense Headquarters. The highest echelon in a national government exercising command control over a nation's military establishment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NFLT">
        <xs:annotation>
          <xs:documentation>Numbered Fleet. A major tactical command immediately subordinate to a major fleet Command and comprised of various task forces, groups, and support elements for the purpose of prosecuting specific naval operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NTE">
        <xs:annotation>
          <xs:documentation>Naval Task Element.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NTF">
        <xs:annotation>
          <xs:documentation>Naval Task Force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NTG">
        <xs:annotation>
          <xs:documentation>Naval Task Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NTU">
        <xs:annotation>
          <xs:documentation>Naval Task Unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTRYD">
        <xs:annotation>
          <xs:documentation>Otryad. A regimental-size unit of the former USSR directly subordinate to the Border District Headquarters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLT">
        <xs:annotation>
          <xs:documentation>Platoon. A tactical unit usually subordinate to a company or battery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLTHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Platoon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PTRL">
        <xs:annotation>
          <xs:documentation>Patrol. A tactical unit designed for a specific mission or purpose, and sometimes organized officially by an authorized table of organization. May be subordinate to a platoon, company, or battalion. The size varies with the mission or purpose for which organized.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAG">
        <xs:annotation>
          <xs:documentation>Regimental Artillery Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAGHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Regimental Artillery Group.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RCTHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Regimental Combat Team.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RGT">
        <xs:annotation>
          <xs:documentation>Regiment. An administrative and tactical unit on a level of command that is usually below a division or brigade and above a battalion.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RGTHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Regiment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEC">
        <xs:annotation>
          <xs:documentation>Section. A tactical unit usually smaller than a platoon and larger than a squad. In some organizations the section, rather than the squad, is the basic tactical unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQ">
        <xs:annotation>
          <xs:documentation>Squadron. A tactical and administrative unit usually equating to a battalion, and composed of two or more troops (units).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQD">
        <xs:annotation>
          <xs:documentation>Squad. A small, basic, tactical unit usually subordinate to a platoon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Squadron.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TA">
        <xs:annotation>
          <xs:documentation>Theater Army Area Command.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="THTA">
        <xs:annotation>
          <xs:documentation>Theater Army. A Theater Army is the senior army headquarters in a theater of operations. In a theater where the forces of a single nation comprise the theater command, the Theater Army is the senior headquarters and is charged with the command and control of all army elements in the theater. When the theater is organized as a combined command, the Theater Army of a nation becomes the senior administrative headquarters in the theater for that nation's forces only.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TM">
        <xs:annotation>
          <xs:documentation>Team.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TROOP">
        <xs:annotation>
          <xs:documentation>Troop. A subordinate tactical and administrative unit of a cavalry squadron, equivalent to a company or battery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TROOPHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Troop.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSKELMT">
        <xs:annotation>
          <xs:documentation>Task Element. A component of a task group organized to accomplish a specific task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSKFOR">
        <xs:annotation>
          <xs:documentation>Task Force. A component of a fleet organization by the commander of a task fleet or higher authority for accomplishment of a specific task or tasks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSKGP">
        <xs:annotation>
          <xs:documentation>Task Group. A component of a naval task force organized by the Commander of a task force or higher authority.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSKUNIT">
        <xs:annotation>
          <xs:documentation>Task Unit. A component of a task element.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNITHQ">
        <xs:annotation>
          <xs:documentation>Headquarters, Unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ZASTRV">
        <xs:annotation>
          <xs:documentation>Zastrova. Basic operational unit of the former USSR border troops, with a strength from 30-65 men, subordinate to the Komendatura.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="ArmyEchelonLevelCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the lowest structural level, echelon, or point at which army organization control of authority of the subject unit is concentrated.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:ArmyEchelonLevelCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="ArmyOrganizationCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the army table of organization type which identifies the subject military unit.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AAM">
        <xs:annotation>
          <xs:documentation>Air-to-Air Missile. An AAM unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AAW">
        <xs:annotation>
          <xs:documentation>Antiair Warfare. A unit organized for antiair warfare.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABNCMDO">
