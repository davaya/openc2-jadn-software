  <xs:simpleType name="TargetNominatingAuthorityCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the command and control agency that provides the target nomination.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACC">
        <xs:annotation>
          <xs:documentation>Air Control Center. None</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AEW">
        <xs:annotation>
          <xs:documentation>Airborne Early Warning Aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRSOC">
        <xs:annotation>
          <xs:documentation>Air Sovereignty Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOC">
        <xs:annotation>
          <xs:documentation>Air Operations Center. (U.S.) The principal air operations installation from which aircraft and air warning functions of combat air operations are directed, controlled, and executed. It is the senior agency of the Air Force Component Commander from which command and control of air operations are coordinated with other components and services.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOCCL">
        <xs:annotation>
          <xs:documentation>Air Operations Coordination Center (Land).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOCCM">
        <xs:annotation>
          <xs:documentation>Air Operations Coordination Center (Maritime).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARE">
        <xs:annotation>
          <xs:documentation>Air Control Center (ACC), Recognized Air Picture Production Center (RPC), Sensor Fusion Post (SFP).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASOC">
        <xs:annotation>
          <xs:documentation>Air Support Operations Center. (U.S.) An agency of a tactical air control system collocated with a corps headquarters or an appropriate land force headquarters, which coordinates and directs close air support and other tactical air support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AWACS">
        <xs:annotation>
          <xs:documentation>Airborne Warning and Control System. (U.S.) The E-3 sentry is an Airborne Warning and Control System (AWACS) aircraft that provides all-weather surveillance, command, control, and communications needed by Commanders of U.S. and NATO air defense forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C2M">
        <xs:annotation>
          <xs:documentation>Command and Control Mobile.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAOC">
        <xs:annotation>
          <xs:documentation>Combined Air Operations Center. (U.S.) A facility, staffed by members of more than one nation, established for planning, directing, and executing combined air operations in support of the combined force commander's operation or campaign objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CARS">
        <xs:annotation>
          <xs:documentation>Combined Air Operations Center (CAOC), Air Control Center (ACC), Recognized Air Picture Production Center (RPC), Sensor Fusion Post (SFP).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CJOC">
        <xs:annotation>
          <xs:documentation>Combined Joint Operations Center. The CJOC is responsible for the direction and control of current operations. It exercises command and control over joint operations in the Northern Region. It provides the current situation and operations within regional Command North AOR, air, AII and NATO led operations. It monitors and implements the NATO Precautionary System, the military response options, and rules of engagement. It prepares and executes procedures for peacetime, crisis, peace support, and war operations (AIRNORTH).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRC">
        <xs:annotation>
          <xs:documentation>Control and Reporting Center. (U.S.) The CRC serves as the senior ground radar element of the Theater Air Control System (TACS). Mission is to detect, identify, and verify airborne targets in assigned area. CRC also provides decentralized execution of air defense and airspace control, provides early warning to air and ground elements and manages subordinate radar units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRP">
        <xs:annotation>
          <xs:documentation>Control and Reporting Post.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DARS">
        <xs:annotation>
          <xs:documentation>Deployable ARS.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DASA">
        <xs:annotation>
          <xs:documentation>Direct Air Support Center, Airborne. (U.S.) An airborne aircraft equipped with the necessary staff personnel, communications, and operations facilities to function as a Direct Air Support Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DASC">
        <xs:annotation>
          <xs:documentation>Direct Air Support Center. (U.S.) The principal air control agency of the U.S. Marine Air Command and Control System responsible for the direction and control of air operations directly supporting the ground combat element. It processes and coordinates requests for immediate air support and coordinates air missions requiring integration with ground forces and other supporting arms. It normally collocates with the senior fire support coordination center within the ground combat element and is subordinate to the Tactical Air Command Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DCAOC">
        <xs:annotation>
          <xs:documentation>Deployable CAOC.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DCARS">
        <xs:annotation>
          <xs:documentation>Deployable CARS.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DSAMOC">
        <xs:annotation>
          <xs:documentation>Deployable Surface-to-Air-Missile Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EWC">
        <xs:annotation>
          <xs:documentation>Marine Early Warning/Control Site. (U.S.) U.S. Marine manned site that is subordinate to the Tactical Air Operations Center (TAOC), and provides the TAOC with extended radar coverage and control of anti-air warfare aircraft and surface-to-air weapons.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FAC">
        <xs:annotation>
          <xs:documentation>Forward Air Controller. (U.S.) A member of the Tactical Air Control Party who, from a forward ground or airborne position, controls aircraft in close air support of ground troops. (AAP-06) A qualified individual who, from a forward position on the ground or in the air, directs the action of combat aircraft engaged in close air support of land forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FACA">
        <xs:annotation>
          <xs:documentation>Forward Air Controller, Airborne. (U.S.) A specifically trained and qualified aviation officer who exercises control from the air of aircraft engaged in close air support of ground troops. The Forward Air Controller (Airborne) is normally an airborne extension of the Tactical Air Control Party.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GBADOC">
        <xs:annotation>
          <xs:documentation>Ground Based Air Defense Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JAOC">
        <xs:annotation>
          <xs:documentation>Joint Air Operations Center. (U.S.) A jointly staffed facility established for planning, directing, and executing joint air operations in support of the Joint Force Commander's operation or campaign objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JOC">
        <xs:annotation>
          <xs:documentation>Joint Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MAOC">
        <xs:annotation>
          <xs:documentation>Maritime Air Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MATC">
        <xs:annotation>
          <xs:documentation>Marine Air Traffic Control Detachment. (U.S.) Subordinate to the U.S. Marine TACC, the MATC controls local airspace/aircraft in and around a Marine Air Ground Task Force (MAGTF) airfields and provides precision approach control for MAGTF aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MCE">
        <xs:annotation>
          <xs:documentation>Maritime Coordination Element. The MCE is a Navy liaison element to a CAOC.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAOC">
        <xs:annotation>
          <xs:documentation>Regional Air Operations Center. The RAOC is continuously monitoring and reporting the tactical air defense situation and readiness of the air forces in its AOR. It is monitoring the air activity, relaying, and implementing all phases of the NATO Precautionary System (NPS). It is developing and promulgating crisis management procedures. It is continuously monitoring the status of assigned nuclear forces. It is providing continuity of command and control during crisis and transition to war.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROC">
        <xs:annotation>
          <xs:documentation>Regional Operations Center. The ROC is responsible for the direction and control of current operations. It exercises command and control over joint operations in the Southern Region. It provides the current situation and operations within regional Command North AOR, air, AII, and NATO led operations. It monitors and implements the NATO Precautionary System, the military response options and rules of engagement. It prepares and executes procedures for peacetime, crisis, peace support, and war operations (AIRSOUTH).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RPC">
        <xs:annotation>
          <xs:documentation>Recognized Air Picture Production Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAMOC">
        <xs:annotation>
          <xs:documentation>Surface-to-Air-Missile Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SFP">
        <xs:annotation>
          <xs:documentation>Sensor Fusion Post.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SOC">
        <xs:annotation>
          <xs:documentation>Shape Operations Center. The SOC is to provide SACEUR, and DSACEUR as the EU OPDCR and strategic coordinator, with the means, capabilities, and staff coordination mechanism to exercise command and control over assigned forces in order to meet the requirements of the full spectrum of alliance military missions (Article 5 and non-Article 5) to include NATO support for EU-led operations, with joint and combined force structures. The SOC has to maintain a 24-hours crisis response and crisis management capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQOC">
        <xs:annotation>
          <xs:documentation>Squadron Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACA">
        <xs:annotation>
          <xs:documentation>Tactical Air Coordinator, Airborne. An officer who coordinates, from an aircraft, the action of combat aircraft engaged in close support of ground or sea forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACACC">
        <xs:annotation>
          <xs:documentation>Tactical Air Control Center. (OOA) (UK) The tactical air control center (TACACC) provides facilities to exercise tactical control of deployed air defense, offensive support, support helicopter, and other air assets operating out of area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACC">
        <xs:annotation>
          <xs:documentation>Marine Tactical Air Command Center. (U.S.) The senior U.S. Marine command and control agency providing centralized command for MAGTF forces, and serves as the command post for the Aviation Combat Element (ACE) Commander.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TADC">
        <xs:annotation>
          <xs:documentation>Marine Tactical Air Direction Center. (U.S.) An air operations installation under the overall control of the Tactical Air Control Center (Afloat) or Tactical Air Command Center, from which aircraft and air warning service functions of tactical air operations in an area of concern are directed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TAOC">
        <xs:annotation>
          <xs:documentation>Marine Tactical Air Operations Center. (U.S.) The principal air control agency of the U.S. Marine Air Command and Control System responsible for airspace control and management. It provides real-time surveillance, direction, positive control, and navigational assistance for friendly aircraft. It performs real-time direction and control of all anti-air warfare operations, to include manned interceptors and surface-to-air weapons. It is subordinate to the Tactical Air Command Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TATCU">
        <xs:annotation>
          <xs:documentation>Tactical Air Traffic Control Unit. (UK) A TATCU provides a 24 hours visual flight rules (VFR) Air Traffic Control (ATC) service for covert and overt operations in austere and bare base conditions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WOC">
        <xs:annotation>
          <xs:documentation>Wing Operations Center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
