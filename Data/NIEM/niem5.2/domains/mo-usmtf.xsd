  <xs:simpleType name="RepairFacilityCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the combination of tools, equipment, and storage space required to inspect and repair ships and boats.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="DRYDOCK">
        <xs:annotation>
          <xs:documentation>Drydock. A general term for structures which can receive a floating vessel and then be drained, leaving the ship's hull exposed for repair, overhaul, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLOATING DRYDOCK">
        <xs:annotation>
          <xs:documentation>Floating Drydock. A large, buoyant structure specially designed to submerge by flooding, receive a ship, and then be pumped dry, thus lifting the ship above water level for repair and overhaul.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRAVING DOCK">
        <xs:annotation>
          <xs:documentation>Graving Dock. An elongated basin of masonry or concrete that is fitted with gates or a caisson at the entrance. It is designed so that a ship may be floated in and the water pumped out, leaving the ship's hull exposed for repair, overhaul, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARINE RAILWAY">
        <xs:annotation>
          <xs:documentation>Marine Railway. Tracks, cradle, and winding mechanism used to draw ships out of the water onto the land for inspection and repair. Principal types are "end haul" (most common) and "side haul."</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNKNOWN">
        <xs:annotation>
          <xs:documentation>Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WET DOCK">
        <xs:annotation>
          <xs:documentation>Wet Dock. An artificial basin in which water is retained by caissons or gates and kept at a certain level so that ships always remain afloat, irrespective of the level of water outside the dock.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
