        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="SexCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the gender of an individual.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:SexCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="ShipCategoryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the basic design, configuration, or primary function for which a ship was designed and constructed or converted.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AA">
        <xs:annotation>
          <xs:documentation>Auxiliary Type Ship, General. General designator for all naval auxiliary ship types.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AAR">
        <xs:annotation>
          <xs:documentation>Auxiliary Rescue Craft. Vessel designed for local rescue operations inshore or offshore.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AAV">
        <xs:annotation>
          <xs:documentation>Assault Vehicle, Amphibious. Tracked or wheeled vehicle designed to carry assault troops in amphibious operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AB">
        <xs:annotation>
          <xs:documentation>Depot Ship/Tender. Usually a large ship designed to provide support and depot facilities to other vessels of a specific type.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABU">
        <xs:annotation>
          <xs:documentation>Buoy Tender. Ship 40 meters or more employed for the placing and tending of buoys and aids to navigation in coastal and adjoining waters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABUD">
        <xs:annotation>
          <xs:documentation>Buoy Tender, Heavy Lift. Same as for ABU but with heavy lift capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ACM">
        <xs:annotation>
          <xs:documentation>Auxiliary-Mine Warfare Support Ship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AD">
        <xs:annotation>
          <xs:documentation>Destroyer Tender. Ships of any size but usually large, employed primarily to furnish facilities and services for the support and repair of destroyer type ships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADG">
        <xs:annotation>
          <xs:documentation>Deperming Ship. Ship designed for deperming operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AE">
        <xs:annotation>
          <xs:documentation>Ammunition Ship. Ship about 120 meters or more capable of transporting 5000 or more tons of ammunition and capable of providing underway replenishment of ammunition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AEL">
        <xs:annotation>
          <xs:documentation>Ammunition Ship, Small. Same as for AE but between 40-120 meters handling less than 5000 tons of ammunition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AEM">
        <xs:annotation>
          <xs:documentation>Missile Support Ship. Ship larger than 40 meters employed primarily to transport missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AET">
        <xs:annotation>
          <xs:documentation>Ammunition Ship, Transport. Ship capable of transporting 5000 or more tons of ammunition but lacking sophisticated underway replenishment capabilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AETL">
        <xs:annotation>
          <xs:documentation>Ammunition Ship, Transport, Small. Same as for AET but handling less than 5000 tons of ammunition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AF">
        <xs:annotation>
          <xs:documentation>Stores Ship. Ship 60 meters or more capable of underway replenishment of ships with refrigerated and dry provisions. May carry ammunition and POL but main emphasis is on dry provisions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFDB">
        <xs:annotation>
          <xs:documentation>Large Auxiliary Floating Drydock. Floating dock capable of docking ships of all sizes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFDL">
        <xs:annotation>
          <xs:documentation>Small Auxiliary Floating Drydock. Floating dock capable of docking small ships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFDM">
        <xs:annotation>
          <xs:documentation>Medium Auxiliary Floating Drydock. Floating dock capable of docking small ships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFL">
        <xs:annotation>
          <xs:documentation>Stores Ship, Small. Same as for AF but under 60 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFS">
        <xs:annotation>
          <xs:documentation>Combat Stores Ship (Naval). Large ship, usually over 165 meters capable of underway alongside replenishment of ships with refrigerated and dry provisions, technical spares, ammunition, and general stores.  May carry POL but main emphasis is on mixed replenishment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFT">
        <xs:annotation>
          <xs:documentation>Stores Ship, Transport. Same as for AET but used for transporting refrigerated and dry provisions, technical spares, and general stores.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AG">
        <xs:annotation>
          <xs:documentation>Miscellaneous Auxiliary. Ship 40 meters or more employed in general or multi-purpose functions of support, training, R&amp;D, or a testing nature.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGB">
        <xs:annotation>
          <xs:documentation>Icebreaker. Armed ship in size range 70 meters or more used primarily for icebreaking duties.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGBL">
        <xs:annotation>
          <xs:documentation>Icebreaker, Small. Same as for AGB but under 70 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGBN">
        <xs:annotation>
          <xs:documentation>Icebreaker, Nuclear Powered. Same as for AGB but with nuclear power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGCL">
        <xs:annotation>
          <xs:documentation>Communications Ship, Small. Small auxiliary optimized for communications duties.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGDS">
        <xs:annotation>
          <xs:documentation>Deep Submergence Support Ship. Ship with special facilities to support deep submergence diving operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGE">
        <xs:annotation>
          <xs:documentation>Research Ship. Ship 49 meters or more used to conduct tests, experiments, and/or research.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGEH">
        <xs:annotation>
          <xs:documentation>Research Ship, Hydrofoil.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGF">
        <xs:annotation>
          <xs:documentation>Auxiliary Flag or Command Ship. Ship 55 meters or more used to provide afloat communications facilities and accommodation for a force commander and his operations staff.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGFF">
        <xs:annotation>
          <xs:documentation>Research Ship, Frigate.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGH">
        <xs:annotation>
          <xs:documentation>Instrumentation Ship, Hydroacoustic Range. Ship specially fitted with instrumentation for hydroacoustic range operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGI">
        <xs:annotation>
          <xs:documentation>Intelligence Collector. Ship specially fitted for and primarily employed in the collection of electronic intelligence.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGM">
        <xs:annotation>
          <xs:documentation>Missile Range Instrumentation Ship. Ship employed at sea to provide telemetry and recover missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGMS">
        <xs:annotation>
          <xs:documentation>Support Ship, Missile Range. Ship employed in missile range support operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGOB">
        <xs:annotation>
          <xs:documentation>Oceanographic Research Ship, Polar. Same as for AGOR but specially fitted for ice operations. Must have icebreaker bow.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGOR">
        <xs:annotation>
          <xs:documentation>Oceanographic Research Ship. Ship which conducts multi-discipline research at sea in oceanographic radiomagnetics, meteorology, and oceanography.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGOS">
        <xs:annotation>
          <xs:documentation>Surveillance Ship, Ocean.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGP">
        <xs:annotation>
          <xs:documentation>Patrol/Torpedo Boat Support Ship, Tender. Ship of any size employed primarily to furnish facilities and services for the support and repair of small patrol craft, the primary function being support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGR">
        <xs:annotation>
          <xs:documentation>Radar Picket Ship, Unarmed. Unarmed surface ship employed for radar picket duty. Any armed ship so employed would be typed DDR, FFR, or PPR.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGS">
        <xs:annotation>
          <xs:documentation>Survey Ship. Ship 40 meters or more employed to conduct hydrographic and limited oceanographic surveys.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGSA">
        <xs:annotation>
          <xs:documentation>Survey Ship, Polar. Ship used for surveying Arctic/Antarctic areas.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGSC">
        <xs:annotation>
          <xs:documentation>Survey Ship, Coastal. Same as for AGS but only in coastal and inshore waters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGSL">
        <xs:annotation>
          <xs:documentation>Launching Ship, Satellite. Ship employed in monitoring satellite launching operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGSS">
        <xs:annotation>
          <xs:documentation>Auxiliary Research Submarine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGT">
        <xs:annotation>
          <xs:documentation>Service Ship, Target. Ship employed in servicing surface targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AGTT">
        <xs:annotation>
          <xs:documentation>Service Ship, Torpedo-Target. Ship employed in servicing torpedoes and sub-surface targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AH">
        <xs:annotation>
          <xs:documentation>Hospital Ship. Ship of at least 40 meters which provides 3rd line medical and surgical care.  Declared to and protected by the ICRC (Int. Committee of the Red Cross/Red Crescent (TU ships only)) and marked accordingly.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AK">
        <xs:annotation>
          <xs:documentation>Cargo Ship, Naval. Ship at least 80 meters employed to transport general cargo and provisions.  No underway replenishment facilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AKL">
        <xs:annotation>
          <xs:documentation>Cargo Ship, Light, Naval. Same as for AK but in size range 40-80 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AKR">
        <xs:annotation>
          <xs:documentation>Cargo Ship, RO/RO, Naval. Ship at least 40 meters overall designed to transport vehicles, guns, and tanks in a non-combatant situation.  Must have roll-on/roll-off capability for vehicles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AKS">
        <xs:annotation>
          <xs:documentation>Stores Ship, Issue, Naval. Ship 40 meters or more used to provide supplies and services.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AKSL">
        <xs:annotation>
          <xs:documentation>Stores Ship, Issue, Small, Naval. Same as for AKS but less than 40 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AKV">
        <xs:annotation>
          <xs:documentation>Aircraft Ferry/Cargo Ship. Same as for AK but employed to transport aircraft and aircraft spares.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ALS">
        <xs:annotation>
          <xs:documentation>Light Ship. Ship actually moored or anchored in a fixed position showing navigational aiding light(s).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AN">
        <xs:annotation>
          <xs:documentation>Cable, Net Laying Ship. Ship equipped for cable or net laying.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ANL">
        <xs:annotation>
          <xs:documentation>Cable/Net Laying Ship, Small. Same as for AN but smaller.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AO">
        <xs:annotation>
          <xs:documentation>Oiler/Tanker, General. General designator for oilers.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOE">
        <xs:annotation>
          <xs:documentation>Combat Support Ship, Fast (Naval). Large ship over 230 meters, capable of speeds of 25 knots or more and/or providing rapid and simultaneous underway replenishment of ships at sea with POL, ammunition, refrigerated and dry provisions, spare parts, and general stores.  Primary emphasis is on POL replenishment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOG">
        <xs:annotation>
          <xs:documentation>Gasoline Tanker.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOL">
        <xs:annotation>
          <xs:documentation>Oiler, Small, Naval. Ship in size range 60-100 meters capable of furnishing underway replenishment of POL products.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOR">
        <xs:annotation>
          <xs:documentation>Oiler Replenishment (Naval). Ship of at least 140 meters capable of providing rapid replenishment of POL and solid store products.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AORL">
        <xs:annotation>
          <xs:documentation>Oiler, Replenishment, Small, Naval. Same as for AOR but in size range 40-140 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOS">
        <xs:annotation>
          <xs:documentation>Special Liquid Ship. Ship 40 meters or more designed to transport a special kind of propellant or other non-nuclear associated liquid cargo.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOSR">
        <xs:annotation>
          <xs:documentation>Radiological Liquid Ship. Ship 40 meters or more designed to transport radioactive liquids.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOT">
        <xs:annotation>
          <xs:documentation>Oiler-Transport. Ship usually exceeding 120 meters capable of transporting POL products but not specially fitted to provide underway replenishment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOTL">
        <xs:annotation>
          <xs:documentation>Oiler, Transport, Small. Same as for AOT but in size range 40-120 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AP">
        <xs:annotation>
          <xs:documentation>Personnel Transport. Ship of at least 120 meters employed to transport troops, their supplies and equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APB">
        <xs:annotation>
          <xs:documentation>Barracks Ship. Self-propelled ship of any size employed as a mobile base facility and support ship for the crews of other vessels (usually small craft).  Has no repair facilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APCR">
        <xs:annotation>
          <xs:documentation>Primary Casualty Receiving Ship. Ship of at least 40 meters whose primary purpose is to provide 3rd line medical and surgical care.  Not declared by ICRC/Red Crescent (TU ships only). May be armed and carrying secure communications.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APCT">
        <xs:annotation>
          <xs:documentation>Casualty Transport Ship. Ship of at least 40 meters whose primary purpose is sustaining post operative casualties during transport out of theatre.  Not declared by ICRC/Red Crescent (TU ships only).  May be armed and carrying secure communications.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APL">
        <xs:annotation>
          <xs:documentation>Barracks Craft. Same as for AP but also with capability of providing barrack facilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AQ">
        <xs:annotation>
          <xs:documentation>Merchant Cruise/Raider, Armed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AR">
        <xs:annotation>
          <xs:documentation>Repair Ship. Ship of at least 120 meters or more employed as a mobile repair facility providing limited support to various types of ships. Not a lifting ship. Repair primary function, support secondary.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARB">
        <xs:annotation>
          <xs:documentation>Repair Ship, Battle Damage. Same as for AR but optimized for repair of battle damage.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARC">
        <xs:annotation>
          <xs:documentation>Repair Ship, Cable. Ship 40 meters or more employed to lay, retrieve, and maintain submarine cables.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARD">
        <xs:annotation>
          <xs:documentation>Auxiliary Repair Dock. Dry dock with repair facilities for all ship sizes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARDM">
        <xs:annotation>
          <xs:documentation>Drydock, Auxiliary, Repair, Medium. Same as for AR but for medium and small ships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARH">
        <xs:annotation>
          <xs:documentation>Repair Ship, Heavy Hull. Same as for AR but optimized for extensive repairs to ships hulls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARL">
        <xs:annotation>
          <xs:documentation>Repair Ship, Small. Ship 40-120 meters capable of providing mobile repair facilities and possible limited support to smaller boats.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARR">
        <xs:annotation>
          <xs:documentation>Repair Ship, Radiological. Ship optimized to provide mobile repairs to radiological installations and facilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARS">
        <xs:annotation>
          <xs:documentation>Salvage Ship. Ship at least 40 meters used to provide mobile salvage, repairs, diving, and rescue services.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARSD">
        <xs:annotation>
          <xs:documentation>Salvage Ship, Lifting. Same as for ARS but must have heavy lifting capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARV">
        <xs:annotation>
          <xs:documentation>Aircraft Repair Ship. Ship of any size used to repair helicopters, aircraft and aircraft engines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AS">
        <xs:annotation>
          <xs:documentation>Submarine Tender. Ship of at least 120 meters or more which provides mobile base facilities and support for submarines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASL">
        <xs:annotation>
          <xs:documentation>Submarine Tender, Small. Same as for AS but between 40-120 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASR">
        <xs:annotation>
          <xs:documentation>Submarine Rescue Ship. Any ship equipped to rescue personnel entrapped in a sunken submarine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASVR">
        <xs:annotation>
          <xs:documentation>Space Vehicle Recovery Ship. Any ship equipped to recover space capsules following space flights.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AT">
        <xs:annotation>
          <xs:documentation>Tug, Ocean Going. General designator for tugs capable of operating in open ocean waters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATA">
        <xs:annotation>
          <xs:documentation>Tug, Oceangoing, Auxiliary. Seagoing tug employed to tow navy ships and craft, usually about 40-50 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATC">
        <xs:annotation>
          <xs:documentation>Mini-Armored Troop Carrier.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATF">
        <xs:annotation>
          <xs:documentation>Tug, Oceangoing, Fleet. Same as for ATA but equipped to operate with fleets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATR">
        <xs:annotation>
          <xs:documentation>Tug, Oceangoing, Rescue. Same as for ATA or ATF but extensively equipped for fire fighting and rescue operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATS">
        <xs:annotation>
          <xs:documentation>Tug, Oceangoing, or Ship Salvage/Rescue. Ship which can provide salvage, repair, diving and rescue services, and tow ships and craft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AU">
        <xs:annotation>
          <xs:documentation>Fishing Vessel, Trawler or Junk, General.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AV">
        <xs:annotation>
          <xs:documentation>Seaplane Tender. General designator for vessels which have repair and support facilities for aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AVB">
        <xs:annotation>
          <xs:documentation>Aviation Logistic Support Ship. Large ship equipped to provide aviation logistic support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AVM">
        <xs:annotation>
          <xs:documentation>Aviation Tender Guided Missile Supply Ship. Ship with supply and support facilities for airborne guided missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AVR">
        <xs:annotation>
          <xs:documentation>Aircraft Rescue Vessel. Any ship equipped to rescue personnel trapped in a sunken aircraft.  May also have facilities to salvage sunken aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AVS">
        <xs:annotation>
          <xs:documentation>Aviation Supply Ship. Ship equipped to carry and supply aviation stores.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AVT">
        <xs:annotation>
          <xs:documentation>Auxiliary Aircraft Landing Training Ship. Training carrier for command and fleet carrier qualification requirements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AWT">
        <xs:annotation>
          <xs:documentation>Water Tender, Naval. Ship used primarily for transporting potable water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AWW">
        <xs:annotation>
          <xs:documentation>Distilling Ship, Naval. Ship capable of distilling and transporting potable water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AX">
        <xs:annotation>
          <xs:documentation>Training Ship, Naval. Large oceangoing ship designed to serve as a training ship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AXL">
        <xs:annotation>
          <xs:documentation>Training Ship, Small, Naval. Same as for AX but not oceangoing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AXS">
        <xs:annotation>
          <xs:documentation>Training Ship, Sail, Naval. Naval sail training ship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AXT">
        <xs:annotation>
          <xs:documentation>Training Ship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AY">
        <xs:annotation>
          <xs:documentation>Hydrographic/Oceanographic Vessel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BB">
        <xs:annotation>
          <xs:documentation>Battleship, General. Capital surface ship designed for surface action with a reasonable compromise between speed, protection, and armament which may include guided missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLK">
        <xs:annotation>
          <xs:documentation>Cargo, Bulk.</xs:documentation>
