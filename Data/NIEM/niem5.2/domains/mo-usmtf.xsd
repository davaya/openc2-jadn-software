  <xs:simpleType name="CMShapeCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the shape of the Coordination Measure (CM) to be displayed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CIRCLE">
        <xs:annotation>
          <xs:documentation>Circle. Each pair of grid ref define the center of a circle (first point) and one point on the radius of this circle (second point).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORRIDOR">
        <xs:annotation>
          <xs:documentation>Corridor. A series of points with an equal width either side of center line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRID">
        <xs:annotation>
          <xs:documentation>Area Reference System Grid. An area reference system grid, for example, Global Area Reference System (GARS).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LINE">
        <xs:annotation>
          <xs:documentation>Line. Sequence of grid ref describes a line from rear to front and from left to right facing the front.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORBIT">
        <xs:annotation>
          <xs:documentation>Orbit. The orbit is maintained with either left or right turns to stay within the space allotted.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POINT">
        <xs:annotation>
          <xs:documentation>Point. Each grid ref is displayed as a dot.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POLYARC">
        <xs:annotation>
          <xs:documentation>Polyarc. The first point is the point of origin followed by a radius with a beginning and ending radial measured in true bearing. This forms the arc. The polygon portion is drawn with a sequence of points that are to be plotted clockwise.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POLYGON">
        <xs:annotation>
          <xs:documentation>Polygon. A polygon contains at least three sides and drawn clockwise. The first point and the last point are the same. The last point may be omitted but is understood to enclose the polygon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RADARC">
        <xs:annotation>
          <xs:documentation>Radarc. The first point is the point of origin followed by an inner radius (may be equal to "0") and an outer radius. The beginning and ending radials are measured in true bearing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRACK">
        <xs:annotation>
          <xs:documentation>Track. Similar to a corridor except the width can vary on either side of center line and each leg can have a separate altitude/altitude block.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
