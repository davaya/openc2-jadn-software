  <xs:simpleType name="ArtilleryFuzeCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the artillery fuze type.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BD">
        <xs:annotation>
          <xs:documentation>Base Detonating. Used with projectiles AAC, APP, COM, and HCP that are used by 5in38, 5in54, 6in47, 8in55, and 16in50 NSF weapons.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CP">
        <xs:annotation>
          <xs:documentation>Concrete Piercing (Applicable 105MM, 155MM, 203MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CVT">
        <xs:annotation>
          <xs:documentation>Variable Time (Proximity) (Naval). Used with projectile HCP that is used by 5in38, 5in54, 8in55, and 16in50 NSF weapons.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRD">
        <xs:annotation>
          <xs:documentation>Multi-Role Fuze, Delay (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRF">
        <xs:annotation>
          <xs:documentation>Multi-Role Fuze (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRP">
        <xs:annotation>
          <xs:documentation>Multi-Role Fuze, Point Detonation (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRT">
        <xs:annotation>
          <xs:documentation>Multi-Role Fuze, Time (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRV">
        <xs:annotation>
          <xs:documentation>Multi-Role Fuze, Variable Time (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MTSQ">
        <xs:annotation>
          <xs:documentation>Fuze Mechanical Time (Naval). Used with projectiles AAC, HCP, ILL, and SMP that are used by 5in38, 5in54, 8in55, and 16in50 NSF weapons.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set. For further U.S. implementation guidance, see Repository of USMTF Program Items Document, items 41 and 260.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PD">
        <xs:annotation>
          <xs:documentation>Point Detonating (Applicable 105MM, 155MM, 175MM, 203MM, 5In38 and 5In54 NSF Weapons With Projectiles AAC, COM, HCP, and SMP). Point Detonating (PD) fuzes function upon impact.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PDD">
        <xs:annotation>
          <xs:documentation>Point Detonating and Delay (Applicable 105MM and 155MM). Fuze can function as Point Detonating or Delay (PDD) action. For NATO applications only. For further U.S. implementation guidance, see Repository of USMTF Program Items Document, item 250.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TI">
        <xs:annotation>
          <xs:documentation>Fuze Time (Applicable 105MM, 155MM, 175MM, 203MM, and MLRS).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TIN">
        <xs:annotation>
          <xs:documentation>Time Action, Nuclear (Applicable 155MM and 203MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VT">
        <xs:annotation>
          <xs:documentation>Variable Time (Proximity, Applicable 105MM, 155MM, 175MM, and 203MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VTD">
        <xs:annotation>
          <xs:documentation>Variable Time (Proximity) Desensitized (Applicable 105MM and 155MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VTN">
        <xs:annotation>
          <xs:documentation>Variable Time Nuclear (Applicable 155MM and 203MM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
