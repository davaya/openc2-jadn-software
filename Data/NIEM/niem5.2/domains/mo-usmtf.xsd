  <xs:simpleType name="WeatherDescriptorsCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code which amplifies the atmospheric conditions with respect to precipitation or other weather phenomena.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BC">
        <xs:annotation>
          <xs:documentation>Patches. The descriptor used to describe for when it covers portions of the station and the apparent visibility in the fog patch or bank is less than 5/8 SM and visibility over the uncovered portions of the station is 5/8 SM or greater.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BL">
        <xs:annotation>
          <xs:documentation>Blowing. The descriptor used to further describe the condition of dust, sand, snow, and/or spray which is raised by the wind to a height of 6 feet or more and reduces the prevailing visibility.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DR">
        <xs:annotation>
          <xs:documentation>Low Drifting. The descriptor used to further describe the condition of dust, sand, or snow which is raised by the wind to a height of less than 6 feet and does not reduce the prevailing visibility.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FZ">
        <xs:annotation>
          <xs:documentation>Freezing. The descriptor used to describe the effect of fog, drizzle, and/or rain which freezes upon contact with exposed surfaces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MI">
        <xs:annotation>
          <xs:documentation>Shallow. The descriptor which is used to further describe fog with a vertical extent of less than 6 feet.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PR">
        <xs:annotation>
          <xs:documentation>Partial. The descriptor used to describe fog when it covers a substantial part of the station and visibility in the fog is less then 5/8 SM and visibility over the uncovered parts of the station is 5/8 SM or more.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SH">
        <xs:annotation>
          <xs:documentation>Showers. The descriptor used to describe precipitation as characterized by the suddenness with which they start and stop, by the rapid changes in intensity, and usually by rapid changes in the appearance in the sky.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TS">
        <xs:annotation>
          <xs:documentation>Thunderstorm. A local storm produced by a cumulonimbus that is accompanied by lighting and/or thunder, usually with gusty winds, heavy rain, and sometimes, with hail.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
