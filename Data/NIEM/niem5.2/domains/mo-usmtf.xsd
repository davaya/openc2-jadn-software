  <xs:simpleType name="CommunicationsEventCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the event causing communications status change.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACTIVATION">
        <xs:annotation>
          <xs:documentation>Activation. To put a communication facility into existence by official order, so it can function in its assigned capacity.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ALTERNATE">
        <xs:annotation>
          <xs:documentation>Alternate. Refers to the change or location of wartime headquarters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BACKLOG">
        <xs:annotation>
          <xs:documentation>Backlog. The point at which the communication system(s) have reached their capacity and can no longer process traffic as it is generated by the users of the system(s).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEACTIVATE">
        <xs:annotation>
          <xs:documentation>Deactivate. Placing a communication facility in an inactive status.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DESTRUCTION">
        <xs:annotation>
          <xs:documentation>Destruction. The placing of communications facilities/equipment in an unusable and irreparable condition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DISRUPTION">
        <xs:annotation>
          <xs:documentation>Disruption. Indicates the communications service normally provided by a communication facility has been disrupted by some cause.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JAMMING">
        <xs:annotation>
          <xs:documentation>Jamming. Indicates the communication facility/service is experiencing difficulty or loss of service due to radiation, reradiation, or reflection of electromagnetic energy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTHER">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OUTAGE">
        <xs:annotation>
          <xs:documentation>Outage. Indicates the communication facility/service has suffered or will suffer a loss of service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RECONFIG">
        <xs:annotation>
          <xs:documentation>Reconfiguration. Indicates the communication facility/service has been or is reconfigured to provide/delete a communication service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RELOCATION">
        <xs:annotation>
          <xs:documentation>Relocation. Indicates the communication facility/service has been/will be relocated to a new area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESTORATION">
        <xs:annotation>
          <xs:documentation>Restoration. Indicates the disrupted communications service has been restored to an active status after a temporary outage.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
