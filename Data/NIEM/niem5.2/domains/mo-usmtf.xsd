  <xs:simpleType name="BattlefieldGeometryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the identification of the battlefield geometry type.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACA">
        <xs:annotation>
          <xs:documentation>Airspace Coordination Area. An airspace coordination area (ACA) is a three-dimensional area or corridor (a volume) of airspace established for the protection of friendly aircraft from surface delivered fires.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BDY">
        <xs:annotation>
          <xs:documentation>Boundary. A line by which areas of responsibility between adjacent units/formations are defined.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CFL">
        <xs:annotation>
          <xs:documentation>Coordinated Fire Line. Message used to designate a line beyond which conventional surface fire support means (mortars, field artillery, naval surface fire ships) may fire at any time within the zone of the establishing HQ without additional coordination. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHA">
        <xs:annotation>
          <xs:documentation>Chemical Hazardous Area. An area of chemical contamination which constitutes a hazard to friendly operations in the area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DAA">
        <xs:annotation>
          <xs:documentation>Damage Avoidance Area. An area in which undesirable materiel damage or personnel casualties produced by the effects of friendly nuclear weapons are to be avoided.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FCA">
        <xs:annotation>
          <xs:documentation>Fire Coordination Area. An area with specified restraints into which fires in excess of those restraints will not be delivered without approval of the authority establishing the restraints.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FEBA">
        <xs:annotation>
          <xs:documentation>Forward Edge of the Battle Area. The foremost limits of a series of areas in which ground combat units are deployed, excluding the areas in which the covering forces are operating, designated to coordinate fire support, the positioning of forces or the maneuver of units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FFA">
        <xs:annotation>
          <xs:documentation>Free Fire Area. Message used to delineate a specific, designated area into which any weapon system may fire without additional coordination from the establishing HQ. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLOT">
        <xs:annotation>
          <xs:documentation>Forward Line of Own Troops. A line which indicates the most forward positions of the friendly forces in any kind of military operation at a specific time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSA">
        <xs:annotation>
          <xs:documentation>Fire Support Area (Naval). A sea area assigned to a fire support unit or individual fire support ship in which to operate when executing fire support missions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSCL">
        <xs:annotation>
          <xs:documentation>Fire Support Coordination Line. Message used to designate a line beyond which all targets may be attacked by any weapon system (including aircraft and special weapons), without endangering or requiring additional coordination with establishing headquarters. (NATO/US use)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSS">
        <xs:annotation>
          <xs:documentation>Fire Support Station (Naval). A point within a fire support area where a fire support ship would be stopped for conduct of Naval Surface Fire (NSF).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOD">
        <xs:annotation>
          <xs:documentation>Line of Departure. A line parallel with the beach (off-shore) which marks the beginning of the boat lanes for an amphibious assault.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MA">
        <xs:annotation>
          <xs:documentation>Mined Area. An area declared dangerous due to the presence of mines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MFLD">
        <xs:annotation>
          <xs:documentation>Minefield. In land warfare, an area of ground containing mines laid with or without a pattern. in naval warfare, an area of water containing mines laid with or without a pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NFA">
        <xs:annotation>
          <xs:documentation>No Fire Area. Message used to delineate an area into which no fire or effects of fire are allowed. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NFL">
        <xs:annotation>
          <xs:documentation>No Fire Line. A line short of which artillery or ships do not fire except on request or approval of the supported commander, but beyond which they may fire at any time without danger to friendly troops. (NATO only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFA">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Area. Message used to delineate an area in which specific restrictions are imposed and into which fires that exceed those restrictions will not be delivered without coordination with establishing HQ. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFL">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Line. Message used to define a line established between converging friendly forces, one or both may be moving, that prohibits fires or effects from fires across the line without coordination with the affected force. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TAREA">
        <xs:annotation>
          <xs:documentation>Target Area. An area designated and numbered for future firing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ZOF">
        <xs:annotation>
          <xs:documentation>Zone of Fire. An area within which a designated ground unit or fire support ship delivers, or is prepared to deliver, fire support. Fire may or may not be observed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
