  <xs:simpleType name="LostCrewStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the status of lost crew of a downed aircraft.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AKIA">
        <xs:annotation>
          <xs:documentation>Assumed Killed in Action. Due to the nature of the destruction of the aircraft, all crewmen were assumed dead.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHUT">
        <xs:annotation>
          <xs:documentation>Parachuted. Crew member(s) were observed parachuting from the plane prior to destruction or ground impact. Number of parachutes may be reported in free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CPTI">
        <xs:annotation>
          <xs:documentation>Capture Appears Imminent. Crew member(s) were observed in or near vicinity of enemy personnel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CPTP">
        <xs:annotation>
          <xs:documentation>Probable Captured. Capture not confirmed, but situation such that crew member(s) were believed to have been captured.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MIA">
        <xs:annotation>
          <xs:documentation>Missing in Action. Location and condition of crew member(s) unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOCH">
        <xs:annotation>
          <xs:documentation>No Chutes. Aircraft crash observed, but no chute(s) sighted.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. Disposition of aircraft crew is unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
