  <xs:simpleType name="TroopSafetyVulnerabilityCategoryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the vulnerability of personnel to nuclear effects, based on their state of warning and condition of protection.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="UNEXP">
        <xs:annotation>
          <xs:documentation>Unwarned/Exposed Category. Personnel in this category are assumed to be standing in the open with areas of bare skin exposed at the time of detonation, but will have dropped to a prone position by the time the blast wave arrives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WEXP">
        <xs:annotation>
          <xs:documentation>Warned/Exposed Category. Personnel in this category are assumed to be prone on open ground with skin areas covered or protected from thermal effects by at least the equivalent of a two-layer summer uniform.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WPROT">
        <xs:annotation>
          <xs:documentation>Warned/Protected Category. Personnel in this category are assumed to have significant protection against blast, thermal, and nuclear radiation effects. Personnel in tanks, armored personnel carriers (APC), weapon emplacements, foxholes, and shelters are in this category.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
