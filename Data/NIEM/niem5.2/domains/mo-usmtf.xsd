  <xs:simpleType name="MilitaryDayTimeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a day of a month and timekeeping in hours and minutes of a calendar day, using the 24-hour clock system and an associated time zone.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|(1|2)[0-9]|3(0|1))((0|1)[0-9]|2[0-3])[0-5][0-9][A-IK-Z0-9]">
        <xs:annotation>
          <xs:documentation>The first element is a 2-digit number representing the day, in values from 01 to 31. The second element is a 2-digit number representing the hour, in values from 00 to 23. The third element is a 2-digit number representing the minute, in values from 00 to 59. The fourth element is a single alphanumeric character representing one of the 35 time zones, to include 10 half-hour increment time zones based upon the local standard time, Greenwich, England (UTC). The time zones UTC Plus 1 Hour through UTC Plus 12 Hours are represented by the letters A through M, respectively, omitting the letter J; the time zones UTC Minus 1 Hour through UTC Minus 12 Hours are represented by the letters N through Y, respectively; time zone UTC is represented by the letter Z; the half-hour increment time zones UTC Plus 3:30 Hours through UTC Plus 6:30 Hours are represented by the numbers 0 through 3, respectively; UTC Plus 9:30 Hours through UTC Plus 11:30 Hours are represented by the numbers 4 through 6, respectively; UTC Minus 3:30 Hours is represented by the number 7, and UTC Minus 8:30 Hours and UTC Minus 9:30 Hours are represented by the numbers 8 and 9, respectively.</xs:documentation>
        </xs:annotation>
      </xs:pattern>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MilitaryDayTimeTenthOfSecondZuluType">
    <xs:annotation>
      <xs:documentation>A data type for the day of the month and time keeping in hours, minutes, and tenths of seconds of a calendar day using the 24-clock system and an associated Zulu time zone.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="usmtf:DayDate" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HourTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MinuteTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:SecondTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:DecimalCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:TenthsOfSecondTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:TimeZoneZuluCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MilitaryDayTimeTenthOfSecondZuluAugmentationPoint" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MilitaryDayTimeToSecondZuluType">
    <xs:annotation>
      <xs:documentation>A data type for the day of the month and time keeping in hours, minutes, and seconds of a calendar day using the 24-clock system and an associated Zulu time zone.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="usmtf:DayDate" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HourTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MinuteTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:SecondTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:TimeZoneZuluCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MilitaryDayTimeToSecondZuluAugmentationPoint" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="MilitaryDayTimeType">
    <xs:annotation>
      <xs:documentation>A data type for a day of a month and timekeeping in hours and minutes of a calendar day, using the 24-hour clock system and an associated time zone.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MilitaryDayTimeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="MilitaryDayTimeZuluType">
    <xs:annotation>
      <xs:documentation>A data type for the day of a month, and time keeping in hours and minutes of a calendar day using the 24-hour clock system and an associated Zulu time zone.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="usmtf:DayDate" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HourTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MinuteTime" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:TimeZoneZuluCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:MilitaryDayTimeZuluAugmentationPoint" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="MilitaryLoadClassificationSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a number, or number and letter, assigned to vehicles, bridges, and routes to signify the load capacity rating based on vehicle type, weight, and effect on routes and bridges.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:complexType name="MilitaryLoadClassificationType">
    <xs:annotation>
      <xs:documentation>A data type for a number, or number and letter, assigned to vehicles, bridges, and routes to signify the load capacity rating based on vehicle type, weight, and effect on routes and bridges.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MilitaryLoadClassificationSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="MilitaryOccupationalSpecialtyIDSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for an identifier of a military occupational specialty skill.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{3,5}">
        <xs:annotation>
          <xs:documentation>For further U.S. implementation guidance, see Repository of USMTF Program Items Document, item 282.</xs:documentation>
        </xs:annotation>
      </xs:pattern>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MilitaryOccupationalSpecialtyIDType">
    <xs:annotation>
      <xs:documentation>A data type for an identifier of a military occupational specialty skill.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MilitaryOccupationalSpecialtyIDSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="MilitaryOrganizationCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the principal table of organization type in which the subject military unit is identified.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AAA">
        <xs:annotation>
          <xs:documentation>Air Defense Artillery. A unit of antiaircraft artillery weapons and fire control equipment employed in engaging air targets from the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AAM">
        <xs:annotation>
          <xs:documentation>Air-to-Air Missile. An AAM unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AARMMSL">
        <xs:annotation>
          <xs:documentation>Antiarmor Missile. A unit organized and equipped to employ missiles against tanks and other armored vehicles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AAW">
        <xs:annotation>
          <xs:documentation>Antiair Warfare. A unit organized for antiair warfare.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABN">
        <xs:annotation>
          <xs:documentation>Airborne. A unit trained and equipped for airborne operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABNCMDO">
        <xs:annotation>
          <xs:documentation>Airborne Commando. A commando unit with an airmobile capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABNINF">
        <xs:annotation>
          <xs:documentation>Airborne Infantry. An infantry unit organized and equipped for parachute and airlanded operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AD">
        <xs:annotation>
          <xs:documentation>Air Defense. A unit of artillery anti-aircraft artillery weapons and fire control equipment employed in engaging air targets from the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADMIN">
        <xs:annotation>
          <xs:documentation>Administrative. A unit performing those functions that are primarily of a management or administrative nature.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRCAV">
        <xs:annotation>
          <xs:documentation>Air Cavalry. A cavalry unit specially equipped to combine movement by air with reconnaissance in depth. (Also see Cavalry, below.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMBLINF">
        <xs:annotation>
          <xs:documentation>Airmobile Infantry. An infantry unit, trained and equipped for airlanded operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMOB">
        <xs:annotation>
          <xs:documentation>Airmobile. A unit trained and equipped to move about the battlefield by aircraft to engage in ground combat.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMPHASLT">
        <xs:annotation>
          <xs:documentation>Amphibious Assault. An infantry unit organized, equipped and trained for amphibious operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMPHENG">
        <xs:annotation>
          <xs:documentation>Amphibious Engineers. An engineer unit trained and equipped to operate as part of an amphibious force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMPHTK">
        <xs:annotation>
          <xs:documentation>Amphibious Tank. A unit of heavily-armored vehicles designed to carry out a combat mission on land or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMDARTY">
        <xs:annotation>
          <xs:documentation>Armored Artillery. A unit equipped with (mobile) armored artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMDCAV">
        <xs:annotation>
          <xs:documentation>Armored Cavalry. An armored cavalry unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMOR">
        <xs:annotation>
          <xs:documentation>Armor. A unit of combat tanks and armored motor vehicles heavily protected with metal plates.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARMYAVN">
        <xs:annotation>
          <xs:documentation>Army Aviation. A ground unit of organic aviation limited to fixed and rotary-wing, light aircraft, such as liaison and observation types, which are dedicated to ground support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARTY">
        <xs:annotation>
          <xs:documentation>Artillery. An artillery unit of unknown type.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASLTENG">
        <xs:annotation>
          <xs:documentation>Assault Engineers. A combat engineer unit that may fight as foot infantry.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASLTLAND">
        <xs:annotation>
          <xs:documentation>Assault Landing. A special forces unit trained and equipped to support amphibious forces in landing operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASM">
        <xs:annotation>
          <xs:documentation>Air-to-Surface Missile. An ASM unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASW">
        <xs:annotation>
          <xs:documentation>Antisubmarine Warfare.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AT">
        <xs:annotation>
          <xs:documentation>Anti-Tank. A unit trained and equipped for operations against armored vehicles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BIO">
        <xs:annotation>
          <xs:documentation>Biological Ordnance Capable Unit. A unit capable of delivering biological ordnance on a target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BMBR">
        <xs:annotation>
          <xs:documentation>Bomber.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAV">
        <xs:annotation>
          <xs:documentation>Cavalry. A unit moving in lightly armored vehicles and structured primarily to perform ground reconnaissance and security missions. (Also see Air Cavalry, above.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHEM">
        <xs:annotation>
          <xs:documentation>Chemical. A unit employing chemical and/or biological agents to prosecute warfare. Performs massive decontamination functions as required by the tactical situation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMBARM">
        <xs:annotation>
          <xs:documentation>Combined Arms. A military unit of the former Soviet Union composed of tank and motorized equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMBT">
        <xs:annotation>
          <xs:documentation>Combat Type Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMBTENG">
        <xs:annotation>
          <xs:documentation>Combat Engineers. A unit of engineers who are also trained to fight as infantry when required by the tactical situation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMDO">
        <xs:annotation>
          <xs:documentation>Commando. A highly mobile unit trained in counterinsurgency and operations behind enemy lines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CSS">
        <xs:annotation>
          <xs:documentation>Combat Service Support. A combat service support unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CWC">
        <xs:annotation>
          <xs:documentation>Composite Warfare Commander. The command directing naval warfare areas in a naval task force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DMTDCAV">
        <xs:annotation>
          <xs:documentation>Dismounted Cavalry. A cavalry unit that fights as foot infantry.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EA">
        <xs:annotation>
          <xs:documentation>Electronic Attack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ENG">
        <xs:annotation>
          <xs:documentation>Engineer. A unit that accomplishes major construction, demolition, and extensive camouflage projects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ES">
        <xs:annotation>
          <xs:documentation>Electronic Warfare Support. A unit capable of performing electronic warfare support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EW">
        <xs:annotation>
          <xs:documentation>Electronic Warfare. A unit having multiple/general electronic warfare capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EWC">
        <xs:annotation>
          <xs:documentation>EW Coordinator. The command directing electronic warfare in a naval task force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLDARTY">
        <xs:annotation>
          <xs:documentation>Field Artillery. A unit or artillery mounted on carriages and mobile enough to accompany infantry or armored units in the field.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FROG">
        <xs:annotation>
          <xs:documentation>Frog SSM Unit. A unit equipped with Frog SSM.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FTR">
        <xs:annotation>
          <xs:documentation>Fighter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FTRBMBR">
        <xs:annotation>
          <xs:documentation>Fighter Bomber.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FW">
        <xs:annotation>
          <xs:documentation>Fixed Wing. A unit operating fixed wing aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HELO">
        <xs:annotation>
          <xs:documentation>Helicopter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HOWTZR">
        <xs:annotation>
          <xs:documentation>Gun-Howitzer. An artillery unit having gun-howitzers as principal weapons. Usually part of tube artillery units of regimental size.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HTK">
        <xs:annotation>
          <xs:documentation>Heavy Tank.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INF">
        <xs:annotation>
          <xs:documentation>Infantry. A unit consisting primarily of foot soldiers. The basic infantry mission is to close with and destroy the opposition by fire, maneuver, and shock effect. Mobility may be increased by the use of motorized or mechanized equipment for transport.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INFONFT">
        <xs:annotation>
          <xs:documentation>Infantry on Foot. An infantry unit moving primarily on foot, and equipped with a minimum of vehicles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INTEL">
        <xs:annotation>
          <xs:documentation>Intelligence. A unit that performs analysis and testing of enemy equipment, translates enemy documents, and interrogates enemy personnel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LTK">
        <xs:annotation>
          <xs:documentation>Light Tank.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MAINT">
        <xs:annotation>
          <xs:documentation>Maintenance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARN">
        <xs:annotation>
          <xs:documentation>Navy Infantry/Marines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MECHENG">
        <xs:annotation>
          <xs:documentation>Mechanized Engineer. An engineer unit equipped with organic machinery/vehicles for increased support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MECHINF">
        <xs:annotation>
          <xs:documentation>Mechanized Infantry. An infantry unit equipped with organic armored and/or mechanized vehicles for increased mobility and support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MED">
        <xs:annotation>
          <xs:documentation>Medical. A unit that provides medical treatment and/or medical evacuation services.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEF">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEFFWD">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Force Forward.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="METOC">
        <xs:annotation>
          <xs:documentation>Meteorological and Oceanographic.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEU">
        <xs:annotation>
          <xs:documentation>Marine Expeditionary Unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MINE">
        <xs:annotation>
          <xs:documentation>Mining. A unit organized for mine laying or mine clearing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MORT">
        <xs:annotation>
          <xs:documentation>Mortar. An artillery unit having mortars as principal weapons. May be organic part of larger infantry or artillery unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MP">
        <xs:annotation>
          <xs:documentation>Military Police. A military police unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRFLTRP">
        <xs:annotation>
          <xs:documentation>Motorized Rifle Troops. An infantry unit whose organic motorized vehicles and armor facilitate attack from march column.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MTINF">
        <xs:annotation>
          <xs:documentation>Mountain Infantry. An infantry unit specially trained and equipped for warfare in mountainous terrain.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MTK">
        <xs:annotation>
          <xs:documentation>Medium Tank.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NBC">
        <xs:annotation>
          <xs:documentation>Nuclear, Biological, Chemical. A unit trained and equipped for NBC defense/cleanup operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NUC">
        <xs:annotation>
          <xs:documentation>Nuclear Ordnance Capable Unit. A unit capable of delivering nuclear ordnance on a target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORD">
        <xs:annotation>
          <xs:documentation>Ordnance. A unit responsible for the supply and maintenance of weapons, weapon system components, ammunition, and related equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PARAMIL">
        <xs:annotation>
          <xs:documentation>Paramilitary.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PKT">
        <xs:annotation>
          <xs:documentation>Picket. A ship or ships accomplishing picket duty.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PONT">
        <xs:annotation>
          <xs:documentation>Pontoon. A pontoon bridging unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RCKTARTY">
        <xs:annotation>
          <xs:documentation>Rocket Artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RCNARM">
        <xs:annotation>
          <xs:documentation>Reconnaissance, Armor. An armed information-gathering unit equipped to conduct deep probes, harass, or make diversionary attacks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RCP">
        <xs:annotation>
          <xs:documentation>Rear Command Post. Those staff activities concerned primarily with Combat Service Support (CSS) of the force, administrative support of the headquarters, and other activities not immediately concerned with current operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RECON">
        <xs:annotation>
          <xs:documentation>Reconnaissance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RNGR">
        <xs:annotation>
          <xs:documentation>Ranger. Similar to commando unit in training but usually employed in hit-run raids.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RRTRPS">
        <xs:annotation>
          <xs:documentation>Railroad Troops.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAM">
        <xs:annotation>
          <xs:documentation>Surface-to-Air Missile. A unit organized and equipped to perform air defense missions by employing surface-launched missiles against hostile aircraft and missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAP">
        <xs:annotation>
          <xs:documentation>Sapper (Mine). A unit responsible for infiltration operations involving use of satchel charges, mines, and small arms.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCH">
        <xs:annotation>
          <xs:documentation>Military School or Academy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCUD">
        <xs:annotation>
          <xs:documentation>Scud SSM Unit. A unit equipped with Scud SSM.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SIGCOMM">
        <xs:annotation>
          <xs:documentation>Signal/Communications.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SIGELECT">
        <xs:annotation>
          <xs:documentation>Signal/Electronic. A unit that provides communication electronic support for forces in the field. Constructs communication lines and terminals. Installs and maintains early warning and target acquisition radar.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPFORCE">
        <xs:annotation>
          <xs:documentation>Special Forces. A unit organized into small multipurpose detachments designed to organize, train, supply, direct, and control indigenous forces in guerrilla and counter-insurgency operations, and to conduct unconventional warfare operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSM">
        <xs:annotation>
          <xs:documentation>Surface-to-Surface Missile. An SSM unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUPLY">
        <xs:annotation>
          <xs:documentation>Supply. A unit that procures, stores and distributes supplies and equipment necessary for the maintenance and operations of military organizations. It usually handles two or more classes of supplies.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUR">
        <xs:annotation>
          <xs:documentation>Surveillance. A unit organized for surveillance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SVC">
        <xs:annotation>
          <xs:documentation>Service. A unit providing supply, maintenance, transport, evacuation, medical, and other services.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACAIRC">
        <xs:annotation>
          <xs:documentation>Tactical Air Control.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACMSLS">
        <xs:annotation>
          <xs:documentation>Tactical Missiles. A unit organized primarily to launch independent tactical (short-range) missile attacks or to furnish nuclear fires in support of ground operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TK">
        <xs:annotation>
          <xs:documentation>Tank. A unit of armor combat tanks or tank destroyer vehicles that provide mobile firepower and crew protection for combat operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TKDSTR">
        <xs:annotation>
          <xs:documentation>Tank Destroyer.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TKRCVY">
        <xs:annotation>
          <xs:documentation>Tank Recovery. A unit of heavily armored vehicles that recovers and removes disabled, salvageable tanks for repair.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TNG">
        <xs:annotation>
          <xs:documentation>Training.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRANSP">
        <xs:annotation>
          <xs:documentation>Transportation. A unit responsible for providing vehicles to facilitate the movement of personnel and conventional and special cargo within the capabilities of the transport available.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRNSP">
        <xs:annotation>
          <xs:documentation>Transport.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
