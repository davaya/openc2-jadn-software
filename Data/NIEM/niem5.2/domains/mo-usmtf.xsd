  <xs:simpleType name="RoutePointCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a specific type of route point, characterized by the action to take place at that point.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="EOM">
        <xs:annotation>
          <xs:documentation>End of Mission. The mission will terminate at the specific point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EOR">
        <xs:annotation>
          <xs:documentation>End of Route. Identifies the end point of a route.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IP">
        <xs:annotation>
          <xs:documentation>Initial Point. Identifies the initial point of a route or mission flight path.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LND">
        <xs:annotation>
          <xs:documentation>Land. The aircraft will land at the route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NVP">
        <xs:annotation>
          <xs:documentation>Navigation Point. The aircraft will change course, speed, and/or altitude at this point. The ship will change course and/or speed at this point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORB">
        <xs:annotation>
          <xs:documentation>Orbit. The aircraft will orbit around the route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDZ">
        <xs:annotation>
          <xs:documentation>Rendezvous Point. The point established as a rendezvous.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REF">
        <xs:annotation>
          <xs:documentation>Refueling Point. The aircraft will aerial refuel at this point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RP">
        <xs:annotation>
          <xs:documentation>Release Point. The aircraft will be released at the route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STP">
        <xs:annotation>
          <xs:documentation>Start Point. The aircraft will start at the route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TGT">
        <xs:annotation>
          <xs:documentation>Target. The target of the aircraft is at this point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TKF">
        <xs:annotation>
          <xs:documentation>Takeoff. The aircraft will take off from the route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRM">
        <xs:annotation>
          <xs:documentation>Termination. The aircraft will terminate its mission at this route point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRN">
        <xs:annotation>
          <xs:documentation>Turning Point. The aircraft will change direction at this point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
