  <xs:simpleType name="EmitterLocationDataCategoryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a code which represents the category of emitter location data.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Single Bearing to Emitter (LOB). Represents a "LOB" or a single bearing to the emitter from the sensor. (less accurate than "cut" category.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:documentation>Circular Area of Probability (CAP). Represents a probable circular area within which the emitter is located. (more accurate than "ELP" but less accurate than "fix.")</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation>
          <xs:documentation>Emitter Location (Fix). Represents a "fix" or point where the emitter has been located. (most accurate category.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="P">
        <xs:annotation>
          <xs:documentation>Elliptical Area of Probability (ELP). Represents a probable elliptical area within which the emitter is located. (less accurate than "fix" but more accurate than "cut" or "LOB.")</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="EmitterLocationDataCategoryCodeType">
    <xs:annotation>
