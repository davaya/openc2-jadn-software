  <xs:simpleType name="VegetationAbbreviatedCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the predominant form of vegetation which exists at a specific location or in a specific area.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BARE">
        <xs:annotation>
          <xs:documentation>Bare of Vegetation. Terrain has no apparent vegetation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BM">
        <xs:annotation>
          <xs:documentation>Brambles. Thick bushes or vines with sharp thorns.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BR">
        <xs:annotation>
          <xs:documentation>Brush. An assemblage of brushes, commonly 15 feet or less in height and including, in places, small trees and woody vines. Does not include brambles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CP">
        <xs:annotation>
          <xs:documentation>Coconut Palm Grove. A tropical grove or stand of tall, branchless, pinnate-leaved trees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FD">
        <xs:annotation>
          <xs:documentation>Forest, Dense. A large tract of land, covered with trees, with or without underbrush, whose foliage is continuous, or nearly continuous and covers or nearly covers 85 percent or more of the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FO">
        <xs:annotation>
          <xs:documentation>Forest, Open. Trees growing in groups so that the foliage is not continuous throughout a zone, and covers approximately 35-85 percent of the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FS">
        <xs:annotation>
          <xs:documentation>Forest, Scattered. Trees so widely scattered that foliage is not continuous throughout a zone, and covers less than 35 percent of the ground. Scattered forest may include widely spaced groups of trees, dense or open.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GH">
        <xs:annotation>
          <xs:documentation>Grassland, High. Grassland 3 feet or more in height.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GS">
        <xs:annotation>
          <xs:documentation>Grassland, Short. Grassland with growth less than 3 feet high.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HR">
        <xs:annotation>
          <xs:documentation>Field Crops, High. Agricultural cultivated vegetation greater than 3 feet in height.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JNGLD">
        <xs:annotation>
          <xs:documentation>Jungle, Double Canopy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JNGLS">
        <xs:annotation>
          <xs:documentation>Jungle, Single Canopy. Inland tropical jungle with a single canopy cover.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JNGLT">
        <xs:annotation>
          <xs:documentation>Jungle, Triple Canopy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LR">
        <xs:annotation>
          <xs:documentation>Field Crops, Low. Agricultural cultivated vegetation 3 feet or less in height.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MG">
        <xs:annotation>
          <xs:documentation>Mangrove Forest. Tropical trees which grow in dense stands in coastal swamps, typically those near river mouths in brackish water. At high tide, mangrove trees stand above water level on prop roots. At low tide the interlacing roots of the trees, covered with algae and standing in mud constitute a virtually impenetrable barrier.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NP">
        <xs:annotation>
          <xs:documentation>Nipa Palm Stand. A stand of low, dense palm found in brackish, tropical swamps, typically bordering tidal streams or areas commonly submerged at high tide. Mature trees have feathery leaves 10-15 feet long. In conjunction with their swamp environment, nipa palms impose serious obstacles to movement.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OR">
        <xs:annotation>
          <xs:documentation>Orchard. An area of cultivated fruit or nut trees characterized by planting of trees in rows, at regular intervals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PA">
        <xs:annotation>
          <xs:documentation>Paddy (Wet Rice). Wet rice in an irrigated field bounded by low ridges or dikes. Completely covered by slowly moving shallow water for considerable periods of time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PM">
        <xs:annotation>
          <xs:documentation>Palmetto Growth. A growth of low, thick palm with tough vine-like root systems, usually found in tropical, well drained soil.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PS">
        <xs:annotation>
          <xs:documentation>Pasture. An area, usually of grassland, used for the grazing of livestock.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PT">
        <xs:annotation>
          <xs:documentation>Plantation. An area of cultivated crops and trees, usually in a tropical or semi-tropical region, such as a sugar or rubber plantation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SA">
        <xs:annotation>
          <xs:documentation>Savanna. An area of grassland and scattered trees with grass cover usually 1-4 feet in height, but reaching 12 feet in some tropic areas. Savannas occur in low rainfall areas, especially on plains to the leeward of mountains.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCRUB">
        <xs:annotation>
          <xs:documentation>Scrubby Vegetation. Terrain is generally covered with low bushes or shrubs such that personnel traversing would brush against the foliage and be contaminated with liquid chemical agent.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SR">
        <xs:annotation>
          <xs:documentation>Trees, Scattered. Widely separated trees not considered to be forest.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SU">
        <xs:annotation>
          <xs:documentation>Sugarcane Field. An area in which a very tall, perennial tropical grass, with jointed stems, is cultivated as a source of sugar.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TC">
        <xs:annotation>
          <xs:documentation>Cultivation, Terraced. A natural or man-made shelf, that interrupts a rolling or steep slope (sometimes in a series), which is used for growing agricultural crops.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TU">
        <xs:annotation>
          <xs:documentation>Tundra. Low, dense vegetation consisting of grass, herbs, moss, and lichens covering the nearly level, treeless plains of the arctic.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="URBAN">
        <xs:annotation>
          <xs:documentation>Urban Area. Built-up area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VY">
        <xs:annotation>
          <xs:documentation>Vineyard. Land devoted to the cultivation of grapevines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WOODS">
        <xs:annotation>
          <xs:documentation>Wooded Terrain. Terrain is thickly wooded.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
