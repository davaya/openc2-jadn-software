  <xs:simpleType name="IncidentCategoryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the classification of Explosive Ordnance Disposal (EOD) incidents in relation to the threat they pose to critical combat resources/facilities.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:documentation>Immediate. Assigned to EOD incidents that are a grave and immediate threat. Category A incidents are to be given priority over all other incidents. EOD procedures will be started immediately.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Indirect. Assigned to EOD incidents that are an indirect threat. A safe waiting period will normally be observed prior to attempting EOD procedures.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:documentation>Minor. Assigned to EOD incidents that are a minor threat. Will be handled by EOD personnel after categories A and B.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation>
          <xs:documentation>No Threat. Assigned to EOD incidents that are no threat at present.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="IncidentCategoryCodeType">
    <xs:annotation>
