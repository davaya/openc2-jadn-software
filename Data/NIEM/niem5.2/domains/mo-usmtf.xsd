  <xs:simpleType name="VegetationCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the predominant type of plants or plant life of a place or area.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BARE">
        <xs:annotation>
          <xs:documentation>Bare. Terrain is void of vegetation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRUSH">
        <xs:annotation>
          <xs:documentation>Brush. An assemblage of bushes, commonly 5 m (16 ft) or less in height and including, in places, small trees and woody vines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COCONUT PALM">
        <xs:annotation>
          <xs:documentation>Coconut Palm. A tropical grove or stand of tall, branchless, pinnate-leaved trees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CROPS, HIGH">
        <xs:annotation>
          <xs:documentation>Crops, High. Agricultural cultivation greater than 1 m (3.3 ft) or less in height.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CROPS, LOW">
        <xs:annotation>
          <xs:documentation>Crops, Low. Agricultural cultivation 1 m (3.3 ft) or less in height.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CULTIVATED, TERRACE">
        <xs:annotation>
          <xs:documentation>Cultivated, Terrace. A natural or man-made shelf that interrupts a rolling or steep slope in a series, which is used for growing agricultural crops.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, DENSE">
        <xs:annotation>
          <xs:documentation>Forest, Dense. A large tract of land, covered with trees and underbrush, whose foliage is continuous, and covers or nearly covers 85 percent or more of the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, MOSS">
        <xs:annotation>
          <xs:documentation>Forest, Moss. A wet tropical upland forest characterized by the presence of abundant mosses and ferns.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, OPEN">
        <xs:annotation>
          <xs:documentation>Forest, Open. Trees growing in groups so that the foliage is not continuous throughout a zone, and covers approximately 35 to 85 percent of the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, RAIN">
        <xs:annotation>
          <xs:documentation>Forest, Rain. A tropical woodland that has an annual rainfall of 2.5 m (8.3 ft), is restricted almost always to certain lowland areas, is characterized by lofty, broad-leaved evergreen trees forming a continuous canopy, and by nearly complete absence of low-growing ground-sooted vegetation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, SCATTERED">
        <xs:annotation>
          <xs:documentation>Forest, Scattered. Trees so widely separated that foliage is not continuous throughout a zone and covers less than 35 percent of the ground. Scattered forest may include widely spaced groups of trees, dense or open.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOREST, SWAMP">
        <xs:annotation>
          <xs:documentation>Forest, Swamp. Wet, spongy terrain that is saturated, and sometimes partially or intermittently covered with water.  Such terrain has natural vegetation predominantly of shrubs and trees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRASS, HIGH">
        <xs:annotation>
          <xs:documentation>Grass, High. Grass over 1 m (3.3 ft) high.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRASS, SHORT">
        <xs:annotation>
          <xs:documentation>Grass, Short. Grass 1 m (3.3 ft) in height or less.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JUNGLE">
        <xs:annotation>
          <xs:documentation>Jungle. Terrain that is impenetrable, with an overgrown, tangled mass of tropical vegetation.  May or may not be inhabited.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MANGROVE TREES">
        <xs:annotation>
          <xs:documentation>Mangrove Trees. A tropical tree which grows in dense stands in coastal swamps, typically those near river mouths in brackish water.  At high tide, mangrove trees stand above water level on prop roots.  At low tide, the interlacing roots of the trees, covered with algae, and standing in mud, constitute a virtually impenetrable barrier.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NIPA PALM">
        <xs:annotation>
          <xs:documentation>Nipa Palm. A low palm found in dense stands, in brackish tropical swamps, typically bordering tidal streams or areas commonly submerged at high tide. Mature trees have feathery leaves 3 m (9.8 ft) to 5 m (16 ft) long. In conjunction with their swamp environment, nipa palms impose serious obstacles to movement.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORCHARD">
        <xs:annotation>
          <xs:documentation>Orchard. An area of cultivated fruit or nut trees characterized by planting trees in rows, at regular intervals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PADDY (WET RICE)">
        <xs:annotation>
          <xs:documentation>Paddy (Wet Rice). An irrigated field devoted to rice cultivation by hand methods.  It is bound by low ridges or dikes, and is completely covered by slowly moving shallow water for considerable periods of time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PASTURE">
        <xs:annotation>
          <xs:documentation>Pasture. An area, usually of grassland, used for grazing of livestock.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLANTATION">
        <xs:annotation>
          <xs:documentation>Plantation. An area cultivated crops and trees, usually in a tropical or semi-tropical region, such as a sugar or rubber plantation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAVANNA">
        <xs:annotation>
          <xs:documentation>Savanna. An area of grassland and scattered trees with grass cover usually 0.3 to 1.2 m (1 to 4 ft) in height, but reaching 4 m (13.2 ft) in some tropical areas. Savannas occur in low rainfall areas, especially on plains to the leeward of mountains.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCRUB">
        <xs:annotation>
          <xs:documentation>Scrub. Land covered with thick growth of short, stunted tree, bush, or shrub, commonly associated with brush and characteristic of cut over land and areas of poor soil.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEE REMARKS">
        <xs:annotation>
          <xs:documentation>An appropriate entry must be made in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUGARCANE">
        <xs:annotation>
          <xs:documentation>Sugarcane. A very tall, perennial tropical grass, with jointed leaves, cultivated as a source of sugar.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TREES, SCATTERED">
        <xs:annotation>
          <xs:documentation>Trees, Scattered. Widely separated trees not considered to be forest.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TUNDRA">
        <xs:annotation>
          <xs:documentation>Tundra. Low, dense vegetation consisting of grass, herbs, moss, and lichens covering the nearly level, treeless plains of the arctic.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VINEYARD">
        <xs:annotation>
          <xs:documentation>Vineyard. Land devoted to the cultivation of grapevines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
