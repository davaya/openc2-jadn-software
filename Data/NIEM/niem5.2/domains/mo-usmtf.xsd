  <xs:simpleType name="SeaStateCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code which describes water turbulence and wave height with associated wind speed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="0">
        <xs:annotation>
          <xs:documentation>Calm, Glassy (Sea State), 0 (Height of Waves in Feet).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="1">
        <xs:annotation>
          <xs:documentation>Rippled (Sea State), 0-1 (Height of Waves in Feet).</xs:documentation>
        </xs:annotation>
