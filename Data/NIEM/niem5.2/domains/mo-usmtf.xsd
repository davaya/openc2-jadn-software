  <xs:simpleType name="ExitCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the particular kind of line of communication that offers an ingress or egress area.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BREAK IN SEAWALL">
        <xs:annotation>
          <xs:documentation>Break in Seawall. A man-made or natural opening in a seawall through which an exit is possible.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANYON">
        <xs:annotation>
          <xs:documentation>Canyon. A deep, narrow valley with steep sides and often with a stream flowing through it. Includes a gorge.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CROSS-COUNTRY">
        <xs:annotation>
          <xs:documentation>Cross-Country. Movement into adjacent terrain without the use of roads, tracks, or trails from any point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXPLANATION">
        <xs:annotation>
          <xs:documentation>See Explanation. Enter this code when the exit type is not covered by a code. An explanatory entry must be made in a free text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GULLY">
        <xs:annotation>
          <xs:documentation>Gully. A trench worn in the earth by running water from rain. Includes a ravine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PARTIAL CROSS-COUNTRY">
        <xs:annotation>
          <xs:documentation>Partial Cross-Country. Exiting into adjacent terrain between trees, walls, fences, along an unprepared opening, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAILROAD">
        <xs:annotation>
          <xs:documentation>Railroad. A permanent road having a line of rails fixed to ties providing a track for rolling stock which is designed to be drawn by a locomotive.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAMP">
        <xs:annotation>
          <xs:documentation>Ramp. A strip of stone or concrete built on a beach to facilitate landing, unloading, and/or hauling up of small craft or equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER VALLEY">
        <xs:annotation>
          <xs:documentation>River Valley. An elongated depression on the earth's surface usually between ranges of hills or mountains, the bottom of which slopes continuously downward and contains a natural stream or river.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROAD, HARD SURFACED">
        <xs:annotation>
          <xs:documentation>Road, Hard-Surfaced. A road with a consolidated protective cover that is intended to provide all-weather use near maximum capacity throughout the year.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROAD, LOOSE SURFACED">
        <xs:annotation>
          <xs:documentation>Road, Loose-Surfaced. A road with an unconsolidated protective cover of gravel or crushed rock that generally provides continuous use, but varies in capacity according to weather conditions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROAD, UNSURFACED">
        <xs:annotation>
          <xs:documentation>Road, Unsurfaced. A dry weather road that it is graded or drained, but does not have the protective cover of a hard-surface or loose-surface road.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STEPS">
        <xs:annotation>
          <xs:documentation>Steps. Successive shelves or ledges cut into a slope to facilitate ascent or descent.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STREAM BED">
        <xs:annotation>
          <xs:documentation>Stream Bed. The channel occupied or formerly occupied by a stream.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STREET">
        <xs:annotation>
          <xs:documentation>Street. A thoroughfare, especially in a town, city, or village, that is wider than an alley or lane and usually includes sidewalks along one or both sides.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRACK">
        <xs:annotation>
          <xs:documentation>Track. An upgraded, unsurfaced road, usually passable only in dry weather; commonly a single pair of ruts on the natural land surface.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRAIL">
        <xs:annotation>
          <xs:documentation>Trail. A blazed or otherwise marked path through a wilderness or wild region which is usually passable by troops, pack animals, and small vehicles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TUNNEL">
        <xs:annotation>
          <xs:documentation>Tunnel. A nearly horizontal passageway through or under terrain or an obstruction.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
