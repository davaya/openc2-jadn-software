  <xs:simpleType name="MotionImageryStreamIDSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a Universal Unique Identifier (UUID) that identifies the source video stream expressed in hexadecimal.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-F]{32,32}">
        <xs:annotation>
          <xs:documentation>The hexadecimal numbers are 0-9 and then use the letters A-F, where the digits are 0 - 9 and A - F, with 'A' representing 10, 'B' representing 11, and so on up to 'F' for 15.</xs:documentation>
        </xs:annotation>
      </xs:pattern>
    </xs:restriction>
  </xs:simpleType>
