  <xs:complexType name="HFDFLineOfBearingType">
    <xs:annotation>
      <xs:documentation>A data type for a line of bearing measured by an HFDF capable unit participating in U.S. Navy HFDF operations. It consists of a two-character reference point identifier, the HFDF unit's location in degrees and minutes of latitude and longitude, the measured bearing indicating the direction of the target signal source from the HFDF unit relative to true north, and bearing quality, target accuracy, and bearing disposition codes which provide information pertinent to the quality of the measured bearing.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="usmtf:ReferencePointID" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:BlankSpaceCharacterText" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LatitudeDegreesValue" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LatitudeMinuteAngularValue" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LatitudinalHemisphereCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LongitudeDegreesValue" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LongitudeMinuteAngularValue" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:LongitudinalHemisphereCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:BlankSpaceCharacterTwoText" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HFDFBearingValue" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:AngularMeasurementReferenceCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:BlankSpaceCharacterThreeText" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:BearingQualityCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:TargetAccuracyCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:BearingDispositionCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HFDFLineOfBearingAugmentationPoint" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
