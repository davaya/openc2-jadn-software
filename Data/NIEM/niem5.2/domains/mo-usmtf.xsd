  <xs:simpleType name="CoordinationMeasureCategoryCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a measure employed to facilitate planning and efficient execution of operations while simultaneously providing safeguards for friendly forces. (JP 3-52)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACA">
        <xs:annotation>
          <xs:documentation>Airspace Coordination Area. A Fire Support Coordination Measure that defines a three-dimensional block of airspace in a target area, established by the appropriate ground commander, in which friendly aircraft are reasonably safe from friendly surface fires. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ACP">
        <xs:annotation>
          <xs:documentation>Air Control Point. An Air Reference Measure that identifies a point that is defined and used for navigation, command and control, and communications. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADIZ">
        <xs:annotation>
          <xs:documentation>Air Defense Identification Zone. An Air Defense Measure that defines an airspace of defined dimensions within which the ready identification, location, and control of airborne vehicles are required. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADVRTE">
        <xs:annotation>
          <xs:documentation>Advisory Route. An Air Traffic Control Measure that defines a designated route along which air traffic advisory services is available. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADZ">
        <xs:annotation>
          <xs:documentation>Amphibious Defense Zone. A Maritime Defense Measure that defines the area encompassing the amphibious objective area and the adjoining airspace required by accompanying naval forces for the purpose of air defense. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRCOR">
        <xs:annotation>
          <xs:documentation>Air Corridor. An Airspace Coordinating Measure that defines a restricted air route of travel specified for use by friendly aircraft established for the purpose of preventing friendly aircraft from being fired upon by friendly forces. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ALERTA">
        <xs:annotation>
          <xs:documentation>Alert Area. An Air Traffic Control Measure that defines an airspace that may contain a high volume of pilot training activities or an unusual type of aerial activity, neither of which is hazardous to aircraft. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ALTRV">
        <xs:annotation>
          <xs:documentation>Altitude Reservation. An Air Traffic Control Measure that defines a block of altitude reserved for aircraft to transit or loiter. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AOA">
        <xs:annotation>
          <xs:documentation>Amphibious Objective Area. A Maneuver Control Measure that defines a geographical area (delineated for command and control purposes in the initiating directive) within which is located the objective(s) to be secured by the amphibious force. This area must be of sufficient size to ensure accomplishment of the amphibious force’s mission and must provide sufficient area for conducting necessary sea, air, and land operations. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="APPCOR">
        <xs:annotation>
          <xs:documentation>Approach Corridor. A Maritime Defense Measure that defines an airspace established for the safe passage of land based aircraft joining or departing a maritime force. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARWY">
        <xs:annotation>
          <xs:documentation>Airway. An Air Traffic Control Measure that defines a control area or portion thereof established in the form of a corridor equipped with radio navigational aids. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BDZ">
        <xs:annotation>
          <xs:documentation>Base Defense Zone. An Air Defense Measure that defines an air defense zone established around an air base and limited to the engagement envelope of short-range air defense weapons systems defending that base. Base defense zones have specific entry, exit, and identification, friend or foe procedures established. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BNDRY">
        <xs:annotation>
          <xs:documentation>Boundary. A Maneuver Control Measure that defines a line that delineates surface areas for the purpose of facilitating coordination and deconfliction of operations between adjacent units, formations, or areas. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BULL">
        <xs:annotation>
          <xs:documentation>Bullseye. An Air Reference Measure that defines an established reference point from which the position of an object can be referenced. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BZ">
        <xs:annotation>
          <xs:documentation>Buffer Zone. An Air Reference Measure that defines an airspace designed specifically to provide a buffer between various airspace coordinating measures. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CA">
        <xs:annotation>
          <xs:documentation>Coordinating Altitude. An Airspace Coordinating Measure that uses altitude to separate users and as the transition between different airspace control elements. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CADA">
        <xs:annotation>
          <xs:documentation>Coordinated Air Defense Area. An Air Defense Measure that identifies a mutually defined block of airspace between a land-based air commander and a naval commander when their forces are operating in close proximity to one another. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CCZONE">
        <xs:annotation>
          <xs:documentation>Carrier Control Zone. A Maritime Defense Measure that defines the airspace within a circular limit defined by five miles horizontal radius from the carrier, extending upward from the surface to and including 2,500 feet unless otherwise designated for special operations, and is under the cognizance of an air officer during visual meteorological conditions. (JP 3-52) An area around a ship operating fixed-/rotary-wing aircraft. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CDR">
        <xs:annotation>
          <xs:documentation>Conditional Route. An Air Traffic Control Measure that defines a non-permanent air traffic service route or portion thereof that can be planned and used only under certain conditions. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CFA">
        <xs:annotation>
          <xs:documentation>Controlled Firing Area. An Air Traffic Control Measure that defines airspace wherein activities are conducted under conditions so controlled as to eliminate hazards to nonparticipating aircraft and to ensure the safety of persons and property on the ground. (FAAO JO 7110.10)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CFL">
        <xs:annotation>
          <xs:documentation>Coordinated Fire Line. A Fire Support Coordination Measure that defines a line beyond which conventional surface-to-surface direct fire and indirect fire support means may fire at any time within the boundaries of the establishing headquarters without additional coordination. (JP 3-52) A line beyond which conventional or improved indirect fire means, such as mortars, field artillery, and naval gunfire, may fire without additional coordination (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CL">
        <xs:annotation>
          <xs:documentation>Coordination Level. An Airspace Coordinating Measure that defines a procedural method to separate fixed- and rotary-wing aircraft by determining an altitude below which fixed-wing aircraft normally will not fly. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSA">
        <xs:annotation>
          <xs:documentation>Class A Airspace. An Air Traffic Control Measure that generally defines airspace from 18,000 feet mean sea level (MSL) up to and including flight level 600, including airspace overlying the waters within 12 nautical miles of the congruous states and Alaska. Visual flight rules (VFR) operations are not permitted in CLSA. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSB">
        <xs:annotation>
          <xs:documentation>Class B Airspace. An Air Traffic Control Measure that generally defines airspace from the surface to 10,000 feet MSL surrounding the nations busiest airports in terms of airport operations or passenger enplanements. Air Traffic Control (ATC) provides separation between all aircraft inside CLSB. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSC">
        <xs:annotation>
          <xs:documentation>Class C Airspace. An Air Traffic Control Measure that generally defines airspace from the surface to 4,000 feet above the airport elevation (charted in MSL) surrounding those airports that have an operational control tower, are serviced by radar approach control, and have a certain number of instrument flight rules (IFR) operations or passenger enplanements. ATC provides separation between VFR and IFR inside CLSC. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSD">
        <xs:annotation>
          <xs:documentation>Class D Airspace. An Air Traffic Control Measure that generally defines airspace from the surface to 2,500 feet above the airport elevation (charted in MSL) surrounding those airports having an operational control tower. The configuration of each CLSD is individually tailored and when instrument procedures are published, the airspace will normally be designated to contain the procedures. Prior to entering CLSD airspace, two-way radio communication must be established and maintained with the ATC facility providing air traffic service. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSE">
        <xs:annotation>
          <xs:documentation>Class E Airspace. An Air Traffic Control Measure used to define controlled airspace that has not been defined as Class A, B, C, or D. Also includes federal airways. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSF">
        <xs:annotation>
          <xs:documentation>Class F Airspace. An Air Traffic Control Measure that generally defines airspace in which IFR and VFR flights are permitted; all participating flights receive an air traffic advisory service, and all flights receive flight information service, if requested. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSG">
        <xs:annotation>
          <xs:documentation>Class G Airspace. An Air Traffic Control Measure used to define uncontrolled airspace that has not been defined as Class A, B, C, D, or E. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CONTZN">
        <xs:annotation>
          <xs:documentation>Control Zone. An Air Defense Measure that defines a controlled airspace extending upward from the surface of the earth to a specified upper limit. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COZ">
        <xs:annotation>
          <xs:documentation>Crossover Zone. A maritime defense that defines a Maritime Control Measure which overlaps a missile engagement zone and a fighter engagement zone. (JP 3-52) Airspace beyond the missile engagement zone into which fighters may pursue targets to complete interception. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CP">
        <xs:annotation>
          <xs:documentation>Contact Point. When referenced to air operations, is an Air Reference Measure that defines the position of which a mission leader makes radio contact with an air control agency. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DA">
        <xs:annotation>
          <xs:documentation>Danger Area. An Air Traffic Control Measure that defines an airspace of defined dimensions within which activities dangerous to the flight of aircraft may exist at specified times. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FADIZ">
        <xs:annotation>
          <xs:documentation>Fleet Air Defense Identification Zone. A Maritime Defense Measure that defines a specified area established for identification and flight following of aircraft in the vicinity of a fleet-defended area. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FEZ">
        <xs:annotation>
          <xs:documentation>Fighter Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines an airspace of defined dimensions within which the responsibility for engagement of air threats normally rests with fighter aircraft. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FFA">
        <xs:annotation>
          <xs:documentation>Free Fire Area. A Fire Support Coordination Measure that defines a specific designated area into which any weapons system may fire without additional coordination with the establishing headquarters. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FIR">
        <xs:annotation>
          <xs:documentation>Flight Information Region. An Air Traffic Control Measure that defines an airspace within which flight information service and alerting service are provided. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FIRUB">
        <xs:annotation>
          <xs:documentation>Fire-Power Umbrella. A Maritime Defense Measure that defines an area of specified dimensions defining the airspace over a naval force at sea within which the fire of ships antiaircraft weapons can endanger aircraft, and within which special procedures have been established for identification and operations of friendly aircraft. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLOT">
        <xs:annotation>
          <xs:documentation>Forward Line of Own Troops. A Maneuver Control Measure that defines a line that indicates the most forward positions of friendly forces during linear operations at a specific time. (JP 3-52) A line which indicates the most forward positions of friendly forces in any kind of military operation at a specific time. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSA">
        <xs:annotation>
          <xs:documentation>Fire Support Area. A Maneuver Control Measure that defines an appropriate maneuver area assigned to fire support ships by the naval force commander from which they deliver gunfire support to an amphibious operation. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSCL">
        <xs:annotation>
          <xs:documentation>Fire Support Coordination Line. A Fire Support Coordination Measure established by the land or amphibious force commander to support common objectives within an area of operations; beyond which all fires must be coordinated with affected commanders prior to engagement, and short of the line, all fires must be coordinated with the establishing commander prior to engagement. (JP 3-52) Within an assigned area of operations, a line established by a land or amphibious force commander to denote coordination requirements for fires by other force elements which may affect the commanders current and planned operations. The fire support coordination line applies to fires of air, ground, or sea weapons using any type of ammunition against surface or ground targets. Note: In the context of this definition, the term surface targets applies to those in littoral or inland waters within the designated area of operations. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HIDACZ">
        <xs:annotation>
          <xs:documentation>High-Density Airspace Control Zone. An Airspace Coordinating Measure that defines an airspace designated in an Airspace Control Plan (ACP) or Airspace Control Order (ACO), in which there is a concentrated employment of numerous and varied weapons and airspace users. A HIDACZ has defined dimensions, which usually coincide with geographical features or navigational aids. Access to a HIDACZ is normally controlled by the maneuver commander. The maneuver commander can also direct a more restrictive weapons status within the HIDACZ. (JP 3-52) Airspace of defined dimensions, designated by the airspace control authority, in which there is a concentrated employment of numerous and varied weapons/airspace users. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HIMEZ">
        <xs:annotation>
          <xs:documentation>High-Altitude Missile Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines an airspace of defined dimensions within which the responsibility for engagement of air threats normally rests with high altitude surface-to-air missiles. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IFFOFF">
        <xs:annotation>
          <xs:documentation>Identification, Friend or Foe Switch Off Line. An Air Reference Measure that defines the line demarking where friendly aircraft stop emitting an identification, friend or foe (IFF) signal. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IFFON">
        <xs:annotation>
          <xs:documentation>Identification, Friend or Foe Switch On Line. An Air Reference Measure that defines the line demarking where friendly aircraft start emitting an identification, friend or foe (IFF) signal. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ISP">
        <xs:annotation>
          <xs:documentation>Identification Safety Point. A Maritime Defense Measure that defines a point at which aircraft, on joining a maritime force, will attempt to establish two-way communications with the surface forces and commence identification procedures. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ISR">
        <xs:annotation>
          <xs:documentation>Identification Safety Range. A Maritime Defense Measure that defines the minimum range to which aircraft may close to a maritime force without having been positively identified as friendly to ensure that the maritime force does not mistake the aircraft for hostile. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JEZ">
        <xs:annotation>
          <xs:documentation>Joint Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines airspace of defined dimensions within which multiple air defense systems (surface-to-air missiles and aircraft) are simultaneously employed to engage air threats. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JOA">
        <xs:annotation>
          <xs:documentation>Joint Operations Area. A Maneuver Control Measure that defines an area of land, sea, and airspace defined by a geographic combatant commanders or subordinate unified commander, in which a joint force commander (usually a joint task force commander) conducts military operations to accomplish a specific mission. (JP 3-52) A temporary area defined by the Supreme Allied Commander Europe, in which a designated joint commander plans and executes a specific mission at the operational level of war. A joint operations area and its defining parameters, such as time, scope of the mission, and geographical area, are contingency- or mission-specific and are normally associated with combined joint task force operations. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JSOA">
        <xs:annotation>
          <xs:documentation>Joint Special Operations Area. A Maneuver Control Measure that defines an area of land, sea, and airspace assigned by a joint force commander to the commander of a joint special operations force to conduct special operations activities. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="KILLBX">
        <xs:annotation>
          <xs:documentation>Kill Box. A Fire Support Coordination Measure that defines a three-dimensional permissive fire support coordination measure with an associated airspace coordination measure used to facilitate the integration of Joint fires. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOMEZ">
        <xs:annotation>
          <xs:documentation>Low-Altitude Missile Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines that airspace of defined dimensions within which the responsibility for engagement of air threats normally rests with low-to-medium-altitude surface-to-air missiles. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEZ">
        <xs:annotation>
          <xs:documentation>Missile Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines airspace of defined dimensions within which the responsibility for engagement of air threats normally rests with a surface-to-air missile systems. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MISARC">
        <xs:annotation>
          <xs:documentation>Missile Arc. An Air Defense Measure that defines an area of 10 degrees or as large as ordered by the officer in tactical command, centered on the bearing of the target with a range that extends to the maximum range of the surface-to-air missile. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOA">
        <xs:annotation>
          <xs:documentation>Military Operations Area. An Air Traffic Control Measure that defines an airspace designated outside CLSA area to separate or segregate certain nonhazardous military activities from IFR Traffic and to identify for VFR traffic where these activities are conducted. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NFA">
        <xs:annotation>
          <xs:documentation>No Fire Area. A Fire Support Coordination Measure that defines an area designated by the appropriate commander into which fires or their effects are prohibited. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOFLY">
        <xs:annotation>
          <xs:documentation>No Fly Area. An Airspace Coordinating Measure that defines airspace of specific dimensions set aside for a specific purpose in which no aircraft operations are permitted, except as authorized by the appropriate commander and controlling agency. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PL">
        <xs:annotation>
          <xs:documentation>Phase Line. A Maneuver Control Measure that defines a line utilized for control and coordination of military operations, usually an easily identified feature in the operational area. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PROHIB">
        <xs:annotation>
          <xs:documentation>Prohibited Area. An Air Traffic Control Measure that defines a specified area within the land areas of a state or its internal waters, archipelagic waters, or territorial sea adjacent thereto over which the flight of aircraft is prohibited. (JP 3-52) An airspace of defined dimensions, above the land areas or territorial waters of a state within which the flight of aircraft is prohibited. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RA">
        <xs:annotation>
          <xs:documentation>Restricted Area. When referenced to air, is an Air Traffic Control Measure that defines designated areas established by appropriate authority over which flight of aircraft is restricted. (JP 3-52) An airspace of defined dimensions, above the land areas or territorial waters of a state, within which the flight of aircraft is restricted in accordance with certain specified conditions. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFA">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Area. A Fire Support Coordination Measure that defines an area in which specific restrictions are imposed and into which fires that exceed those restrictions will not be delivered without coordination with the establishing headquarters. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFL">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Line. A Fire Support Coordination Measure that defines a line between converging friendly surface forces that prohibits fires or their effects across that line. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROZ">
        <xs:annotation>
          <xs:documentation>Restricted Operations Zone. An Airspace Coordinating Measure that defines an airspace reserved for specific activities in which the operations of one or more airspace users is restricted. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RTF">
        <xs:annotation>
          <xs:documentation>Return To Force. A Maritime Defense Measure that defines planned route profiles for use by friendly aircraft returning to an aviation-capable ship. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAFES">
        <xs:annotation>
          <xs:documentation>Safety Sector. A Maritime Defense Measure that is established to route friendly aircraft to maritime forces with minimum risk. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SARDOT">
        <xs:annotation>
          <xs:documentation>Search And Rescue Point. An Air Reference Measure that defines a pre-designated specific location, relative to which isolated personnel provide their position to recovery forces. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCZ">
        <xs:annotation>
          <xs:documentation>Ship Control Zone. A Maritime Defense Measure that defines an area activated around a ship operating aircraft, which is not to be entered by friendly aircraft without permission, in order to prevent friendly interference. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHORADEZ">
        <xs:annotation>
          <xs:documentation>Short-Range Air Defense Engagement Zone. When referenced to air defense, is an Air Defense Measure that defines airspace of defined dimensions within which the responsibility for engagement of air threats normally rests with short-range air defense weapons and may be established within a low- or high-altitude missile engagement zone. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SL">
        <xs:annotation>
          <xs:documentation>Safe Lane. An Air Defense Measure that defines a bi-directional lane connecting an airbase, landing site and/or base defense zone to adjacent routes/corridors. Safe lanes may also be used to connect adjacent activated routes/corridors. (AJP-3.3.5)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TFR">
        <xs:annotation>
          <xs:documentation>Temporary Flight Restriction. An Air Traffic Control Measure that defines regulatory action issued by the FAA via the U.S. NOTAM System, under the authority of Title 49, United States Code. TFRs are issued within the sovereign airspace of the U.S. and its territories to restrict certain aircraft from operating within a defined area on a temporary basis to protect persons or property in the air or on the ground. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TL">
        <xs:annotation>
          <xs:documentation>Traverse Level. An Air Defense Measure that defines vertical displacement above low-level air defense systems, expressed both as a height and an altitude, at which aircraft can cross that area. (AAP-06)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WARN">
        <xs:annotation>
          <xs:documentation>Warning Area. An Air Traffic Control Measure that defines airspace of defined dimensions extending from three nautical miles outward from the coast of the U.S. that contains activity that may be hazardous to nonparticipating aircraft. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WFZ">
        <xs:annotation>
          <xs:documentation>Weapons Free Zone. An Air Defense Measure that defines an air defense zone established for the protection of key assets or facilities, other than air bases, where weapons systems may be fired at any target not positively recognized as friendly. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ZF">
        <xs:annotation>
          <xs:documentation>Zone of Fire. A Fire Support Coordination Measure that defines an area into which a designated ground unit or fire support ship delivers, or is prepared to deliver, fire support. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="CoordinationMeasureCategoryCodeType">
    <xs:annotation>
      <xs:documentation>A data type for a measure employed to facilitate planning and efficient execution of operations while simultaneously providing safeguards for friendly forces. (JP 3-52)</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:CoordinationMeasureCategoryCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="CoordinationMeasureCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of coordination measure.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ACM">
        <xs:annotation>
          <xs:documentation>Airspace Coordinating Measure. A measure employed to facilitate the efficient use of airspace to accomplish missions and simultaneously provide safeguards for friendly forces. ACMs are approved by the Airspace Control Authority (ACA) and promulgated via the Airspace Control Order (ACO). Transit of an ACM requires coordination with the owning airspace control element. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADM">
        <xs:annotation>
          <xs:documentation>Air Defense Measure. A measure planned, coordinated, and employed to facilitate responsibilities for identification, detection, and tracking to engage enemy air and missile threats as directed by the Area Air Defense Commander (AADC). ADMs are restrictive. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARM">
        <xs:annotation>
          <xs:documentation>Air Reference Measure. A measure used for command and control purposes that defines a point over the ground or a volume of airspace. ARMs do not require coordination to pass over or through. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATCM">
        <xs:annotation>
          <xs:documentation>Air Traffic Control Measure. A measure established by civilian (including host nation) or military air traffic control for the purpose of expeditious and safe movements of aircraft. ATCMs are directive and restrictive and are established in conjunction with the civil and military airspace control authorities and International Civil Aviation Organization (as appropriate). (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSCM">
        <xs:annotation>
          <xs:documentation>Fire Support Coordination Measure. A measure employed by commanders to facilitate the rapid engagement of targets and simultaneously provide safeguards for friendly forces. FSCMs may be permissive or restrictive. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MCM">
        <xs:annotation>
          <xs:documentation>Maneuver Control Measure. A measure established by the supported/supporting commander on the surface to define lines of responsibility in support of movement and maneuver of friendly forces. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MDM">
        <xs:annotation>
          <xs:documentation>Maritime Defense Measure. A measure planned, coordinated, and employed by maritime commander to facilitate maritime offensive and defensive actions. MDMs may be restrictive or permissive. (JP 3-52)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="CoordinationMeasureCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the type of coordination measure.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:CoordinationMeasureCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="CoordinationMeasureDesignatorRangeType">
    <xs:annotation>
      <xs:documentation>A data type for a means to specify a contiguous block of predefined coordination measures as a range from lower bound to upper bound of the block inclusive.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="structures:ObjectType">
        <xs:sequence>
          <xs:element ref="usmtf:CoordinationMeasureDesignatorLowerBoundText" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:HyphenCode" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:CoordinationMeasureDesignatorUpperBoundText" minOccurs="1" maxOccurs="1"/>
          <xs:element ref="usmtf:CoordinationMeasureDesignatorRangeAugmentationPoint" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="CoordinationMeasureDesignatorSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a designator assigned to the type of airspace control applied to a defined airspace.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:complexType name="CoordinationMeasureDesignatorType">
    <xs:annotation>
      <xs:documentation>A data type for a designator assigned to the type of airspace control applied to a defined airspace.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:CoordinationMeasureDesignatorSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="CoordinationMeasureNameSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a specific name by which the coordination measure is identified. The name should include where possible the country code and FAA/ICAO Flight Information Region code for the airspace.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:complexType name="CoordinationMeasureNameType">
    <xs:annotation>
