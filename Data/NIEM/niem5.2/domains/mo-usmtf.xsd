  <xs:simpleType name="SoilCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the predominant type of soil composition at a specific location or in a specified area.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BLD">
        <xs:annotation>
          <xs:documentation>Boulder. A solid rocky formation larger than 256 mm in diameter. (an area may consist of two or more boulders.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY">
        <xs:annotation>
          <xs:documentation>Clay. Fine-grained sediments with particle sizes smaller than 0.004 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY-G">
        <xs:annotation>
          <xs:documentation>Clay, Gravelly. Clay soil mixed with gravel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY-O">
        <xs:annotation>
          <xs:documentation>Clay, Organic. Clay soil mixed with decaying vegetation. Particle sizes are smaller than 0.004 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY-S">
        <xs:annotation>
          <xs:documentation>Clay, Sandy. Clay soil mixed with sand.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLK">
        <xs:annotation>
          <xs:documentation>Chalk. Earthy limestone of marine origin composed chiefly of minute shells.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORL">
        <xs:annotation>
          <xs:documentation>Coral. Extensive limestone formations consisting of the hard calcerous skeletons of tiny marine animals, located above mean high water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR">
        <xs:annotation>
          <xs:documentation>Gravel. A loose detrital material consisting of fragments ranging in size from 2.0 to 76.0 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR-CL">
        <xs:annotation>
          <xs:documentation>Gravel, Clayey. Gravelly soil with clay mix.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR-CL-S">
        <xs:annotation>
          <xs:documentation>Gravel, Clayey, Sandy. Gravelly soil with clay and sand mix.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR-CR">
        <xs:annotation>
          <xs:documentation>Gravel, Coarse. A loose detrital material consisting of fragments ranging in size from 20.0 to 76.0 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR-F">
        <xs:annotation>
          <xs:documentation>Gravel, Fine. A loose detrital material consisting of fragments ranging in size from 2.0 to 20.0 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR-S">
        <xs:annotation>
