  <xs:simpleType name="MissionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type of mission being requested or tasked.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AAW">
        <xs:annotation>
          <xs:documentation>Anti-Air Warfare. Measures taken to defend a maritime force against attacks by airborne weapons launched from aircraft, ships, submarines, and land-based sites.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ADMLF">
        <xs:annotation>
          <xs:documentation>Administrative Lift. An aerial airlift normally provided by specifically identifiable aircraft assigned to organizations or commands for internal administration.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AEW">
        <xs:annotation>
          <xs:documentation>Airborne Early Warning. Air surveillance and control provided by airborne early warning aircraft which are equipped with search and height finding radar and communication equipment for controlling weapon systems.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AH">
        <xs:annotation>
          <xs:documentation>Attack Helicopter. A helicopter specifically designed to employ various weapons to attack and destroy enemy targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AI">
        <xs:annotation>
          <xs:documentation>Air Interdiction. Air operations conducted to destroy, neutralize, or delay the enemy's military potential before it can be brought to bear effectively against friendly forces at such distance from friendly forces that detailed integration of each air mission with the fire and movement of friendly forces is not required.  Does not include battlefield interdiction for this usage.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMC">
        <xs:annotation>
          <xs:documentation>Airborne Mission Commander. An aerial mission in which the commander serves as an airborne extension of the executing component's Rescue Coordination Center (RCC) and coordinates the Combat Search and Rescue (CSAR) effort between the Combat Search and Rescue Task Force (CSARTF) and the RCC (or Joint Search and Rescue Center) by monitoring the status of all CSARTF elements, requesting additional assets when needed, and ensuring the recovery and supporting forces arrive at their designated areas to accomplish the CSAR mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AME">
        <xs:annotation>
          <xs:documentation>Aeromedical Evacuation. The movement of patients under medical supervision to and between medical treatment facilities by air transportation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AR">
        <xs:annotation>
          <xs:documentation>Aerial Refueling. Refueling aircraft in flight, which extends presence, increases range, and serves as a force multiplier. May include bladder drop and refuel operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASARS">
        <xs:annotation>
          <xs:documentation>Advanced Synthetic Aperture Radar System. An aerial mission type which focuses of the use of a multimode real-time, high-resolution reconnaissance system carried on the U-2 with all-weather, day-night, and long-range mapping capabilities. ASARS detects and accurately locates stationary and moving ground targets to satisfy the mission goal.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASW">
        <xs:annotation>
          <xs:documentation>Anti-Submarine Warfare. Operations conducted with the intention of denying the enemy the effective use of submarines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATK">
        <xs:annotation>
          <xs:documentation>Attack. Any aerial mission meant to disrupt, neutralize, or destroy enemy forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BCAP">
        <xs:annotation>
          <xs:documentation>Boat Cap.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRCAP">
        <xs:annotation>
          <xs:documentation>Barrier Combat Air Patrol. An aerial mission which use of one or more divisions or elements of fighter aircraft between a force and an objective area as a barrier across the probable direction of enemy attack. It is used as far from the force as control conditions permit, giving added protection against raids that use the most direct routes of approach.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAP">
        <xs:annotation>
          <xs:documentation>Combat Air Patrol. An aircraft patrol provided over an objective area, the force protected, the critical area of a combat zone, or in an air defense area, for the purpose of intercepting and destroying hostile aircraft before they reach their targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAS">
        <xs:annotation>
          <xs:documentation>Close Air Support. Air action against hostile targets which are in close proximity to friendly forces and which require detailed integration of each air mission with the fire and movement of those forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CDS">
        <xs:annotation>
          <xs:documentation>Container Delivery System. An aerial mission, which focuses on the use of a system where containers are airdropped into a forward operating location.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHANL">
        <xs:annotation>
          <xs:documentation>Channel Mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CINT">
        <xs:annotation>
          <xs:documentation>Communication, Intelligence, Collection. An aerial mission which focuses on gathering communication intelligence in order to meet current operational requirements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMD">
        <xs:annotation>
          <xs:documentation>Command and Control. An aerial mission in which a properly designated Commander exercises authority and direction over assigned and attached forces in the accomplishment of the task, command and control functions are performed through an arrangement of personnel, equipment, communications, facilities, and procedures employed by a commander in planning, directing, coordinating, and controlling forces and operations in the accomplishment of the mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNTNG">
        <xs:annotation>
          <xs:documentation>Contingency. An aerial emergency mission involving military force caused by natural disasters, terrorists, subversives, or by required military operations. Due to the uncertainty of the situation, contingencies require plans, rapid response, and special procedures to ensure the safety and readiness of personnel, installations, and equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COMM">
        <xs:annotation>
          <xs:documentation>Communications Relay. Airborne operations where aircraft serve as a communications relay extending existing capabilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CSAR">
        <xs:annotation>
          <xs:documentation>Combat Search and Rescue. The detection, location, identification and rescue of downed aircrew in hostile territory in time of crisis or war and, when appropriate, isolated military personnel in distress, who are trained and equipped to receive combat search and rescue support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CURFT">
        <xs:annotation>
          <xs:documentation>Courier Flight. An aerial mission conducted to carry mail, information, or supplies.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DCA">
        <xs:annotation>
          <xs:documentation>Defensive Counterair. An aerial mission, which focuses on all defensive measures designed to detect, identify, intercept, and destroy or negate enemy forces attempting to attack or penetrate the friendly air environment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DVSPT">
        <xs:annotation>
          <xs:documentation>Distinguished Visitor Support. Air operations where military aircraft are used to transport distinguished visitors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EA">
        <xs:annotation>
          <xs:documentation>Electronic Attack. An aerial mission conducted by a division of electronic warfare involving the use of electromagnetic energy, directed energy, or anti-radiation weapons to attack personnel, facilities, or equipment with the intent of degrading, neutralizing, or destroying enemy combat capability and is considered a form of fires.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ELECT">
        <xs:annotation>
          <xs:documentation>Electronic. An aerial mission, which is primarily for the purpose of collecting data on electronic emitters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EO">
        <xs:annotation>
          <xs:documentation>Electro-Optical. An aerial mission which focuses on the use of imaging sensors that collect imagery in or just beyond the visible spectrum.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ES">
        <xs:annotation>
          <xs:documentation>Electronic Support. An aerial mission, which provides information, required for decisions involving electronic warfare operations and other tactical actions such as threat avoidance, targeting, and homing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ESC">
        <xs:annotation>
          <xs:documentation>Escort. Aircraft assigned to protect other aircraft during a mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EW">
        <xs:annotation>
          <xs:documentation>Electronic Warfare. Military action to exploit the electromagnetic spectrum encompassing: the search for, interception and identification of electromagnetic emissions, the employment of electromagnetic energy, included directed energy, to reduce or prevent hostile use of the electromagnetic spectrum, and actions to ensure its effective use by friendly forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EWS">
        <xs:annotation>
          <xs:documentation>Electronic Warfare Support (ES). An aerial mission conducted by a division of electronic warfare involving actions tasked by, or under direct control of, an operational Commander to search for, intercept, identify, and locate or localize sources of intentional and unintentional radiated electromagnetic energy for the purpose of immediate threat recognition, targeting, planning and conduct of future operations. Thus, electronic warfare support provides information required for decisions involving electronic warfare operations and other tactical actions such as threat avoidance, targeting, and homing. Electronic warfare support data can be used to produce signals intelligence, provide targeting for electronic or destructive attack, and produce measurement and signature intelligence.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXER">
        <xs:annotation>
          <xs:documentation>Exercise. A military maneuver or simulated wartime operation involving planning, preparation, and execution. It is carried out for the purpose of training and evaluation. It may be a combined, joint, or single-service exercise, depending on participating organizations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FACA">
        <xs:annotation>
          <xs:documentation>Forward Air Controller.  A specifically trained and qualified aviation officer, normally an airborne extension of the tactical air control party, who exercises control from the air of aircraft engaged in close air support of ground troops.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FCF">
        <xs:annotation>
          <xs:documentation>Functional Check Flight. A flight conducted to confirm operational readiness of the flight crew or aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLR">
        <xs:annotation>
          <xs:documentation>Forward Looking Infrared. An aerial mission, which focuses on an airborne, electro-optical thermal imaging device that detects far-infrared energy, converts the energy into an electronic signal, and provides a visible image for day or night viewing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAAW">
        <xs:annotation>
          <xs:documentation>Ground Alert Anti-Air Warfare. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform anti-air operations to defend a maritime force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAEW">
        <xs:annotation>
          <xs:documentation>Ground Alert Airborne Early Warning. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform early warning operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAH">
        <xs:annotation>
          <xs:documentation>Ground Alert Attack Helicopter. The status in which rotary-wing aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform attack operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAI">
        <xs:annotation>
          <xs:documentation>Ground Alert Air Interdiction. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform interdiction operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAME">
        <xs:annotation>
          <xs:documentation>Ground Alert Aeromedical Evacuation. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform aeromedical evacuation operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAML">
        <xs:annotation>
          <xs:documentation>Ground Alert Troop/Cargo Helicopter Operation. The status in which helicopter aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform transportation operations for troops or cargo.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAR">
        <xs:annotation>
          <xs:documentation>Ground Alert Aerial Refueling. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform aerial refueling operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GASW">
        <xs:annotation>
          <xs:documentation>Ground Alert Anti-Submarine Warfare. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform anti-submarine operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GATK">
        <xs:annotation>
          <xs:documentation>Ground Alert Attack. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and are ready to employ various weapons to destroy enemy targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GBAR">
        <xs:annotation>
          <xs:documentation>Ground Alert Barrier Combat Air Patrol. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform barrier combat air patrol operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GCAP">
        <xs:annotation>
          <xs:documentation>Ground Alert Combat Air Patrol. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform combat air patrol operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GCAS">
        <xs:annotation>
          <xs:documentation>Ground Alert Close Air Support. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform close air support operations. See close air support.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GCOM">
        <xs:annotation>
          <xs:documentation>Ground Alert Communications Relay. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform airborne operations where aircraft serve as a communications relay extending existing capabilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GDCA">
        <xs:annotation>
          <xs:documentation>Ground Alert Defensive Counterair. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform defensive counterair operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GESC">
        <xs:annotation>
          <xs:documentation>Ground Alert Escort. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform escort operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GEW">
        <xs:annotation>
          <xs:documentation>Ground Alert Electronic Warfare. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform electronic warfare operations. See electronic warfare.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GFACA">
        <xs:annotation>
          <xs:documentation>Ground Alert Forward Air Controller. The status in which a specifically trained and qualified aviation officer, who exercises control from the air of aircraft engaged in close air support of ground troops, in his aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform forward air control operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GILL">
        <xs:annotation>
          <xs:documentation>Ground Alert Flare Illumination. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform battlefield illumination by airdropping high-powered flares.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GJCP">
        <xs:annotation>
          <xs:documentation>Ground Alert Joint Airborne Communications Control/Command Post. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform joint command and control operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GMINL">
        <xs:annotation>
          <xs:documentation>Ground Alert Minelaying. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform airdrops of encased explosive over ground or in water and that are set to explode when disturbed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GMINS">
        <xs:annotation>
          <xs:documentation>Ground Alert Minesweeping. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and once airborne will locate minefields and neutralize them by dropping ordnance over the area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GOCA">
        <xs:annotation>
          <xs:documentation>Ground Alert Offensive Counterair. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform offensive counterair operations. See offensive counterair.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GREC">
        <xs:annotation>
          <xs:documentation>Ground Alert Reconnaissance. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform reconnaissance operations. See reconnaissance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSA">
        <xs:annotation>
          <xs:documentation>Ground Alert Strategic Attack. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform any long range air operation meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSAL">
        <xs:annotation>
          <xs:documentation>Ground Alert Strategic Airlift. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform strategic airlift operations. See strategic airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSAR">
        <xs:annotation>
          <xs:documentation>Ground Alert Search and Rescue. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform search and rescue operations. See search and rescue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSCAR">
        <xs:annotation>
          <xs:documentation>Ground Alert Reconnaissance Strike Control Coordination and Reconnaissance (GSCAR). The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and conduct reconnaissance strike control coordination and reconnaissance operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSEAD">
        <xs:annotation>
          <xs:documentation>Ground Alert Defense Suppression Enemy Air Defense. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform SEAD operations that will attempt to neutralize, destroy, or temporarily degrade surface-based enemy air defenses by destructive and/or disruptive means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSEC">
        <xs:annotation>
          <xs:documentation>Ground Alert Security. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform security operations. See security.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSPT">
        <xs:annotation>
          <xs:documentation>Ground Alert Support Mission. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform air missions that include movement of personnel or equipment other than via tactical airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSRI">
        <xs:annotation>
          <xs:documentation>Ground Alert Sensor Implant. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, airdrop sensors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSUCAP">
        <xs:annotation>
          <xs:documentation>Ground Alert Surface Combat Air Patrol (SUCAP). The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform a combat air patrol in support of surface vessels conducting maritime operations. ATO mission that represents ground alert variations of five specific AOMSW missions: surface surveillance coordination (SSC), armed reconnaissance (AR)/strike coordination and reconnaissance (SCAR), war-at-sea (WAS) strike, counter-fast attack craft (FAC)/fast inshore attack craft (FIAC), and airborne maritime mining (AMM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GTAL">
        <xs:annotation>
          <xs:documentation>Ground Alert Theater Airlift. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform theater airlift operations. See theater airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GTPQ">
        <xs:annotation>
          <xs:documentation>Ground Alert Ground Control Radar Bombing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HEADP">
        <xs:annotation>
          <xs:documentation>Heavy Equipment Airdrop. An aerial mission to unload heavy equipment from an aircraft in flight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HEL">
        <xs:annotation>
          <xs:documentation>Helicopter Mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HLOG">
        <xs:annotation>
          <xs:documentation>Troop/Cargo Helicopter Operation. Helicopter transportation operations airlifting troops or cargo.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ILLUM">
        <xs:annotation>
          <xs:documentation>Flare Illumination. An aerial mission which focuses on battlefield illumination by airdropping high-powered flares.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INT">
        <xs:annotation>
          <xs:documentation>Interdiction. Operations conducted to divert, disrupt, delay, or destroy the enemys military surface capability before it can be used effectively against friendly forces, or to achieve enemy objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INTEL">
        <xs:annotation>
          <xs:documentation>Intelligence. An aerial mission that's product results from the collection, processing, integration, analysis, evaluation, and interpretation of available information concerning foreign countries or areas or information and knowledge about an adversary obtained through observation, investigation, analysis, or understanding.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JAATT">
        <xs:annotation>
          <xs:documentation>Joint Airborne Air Transportability Training. Training operations or exercises involving airborne and appropriate troop carrier units. This training includes: a. air delivery of personnel and equipment; b. assault operations by airborne troops and/or air transportable units; c. loading exercises and local orientation fights of short duration; and d. maneuvers and/or exercises as agreed upon by services concerned and/or as authorized by the Joint Chiefs of Staff.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JCP">
        <xs:annotation>
          <xs:documentation>Joint Airborne Communications Center/Command Post (JACC/CP). A suitably equipped aircraft used by the commander for conduct of operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MINL">
        <xs:annotation>
          <xs:documentation>Minelaying. An aerial mission which permits airdrops of encased explosive over ground or in water that are set to explode when disturbed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MSP">
        <xs:annotation>
          <xs:documentation>Minesweeping. The technique of searching for, or clearing mines using mechanical or explosion gear, which physically removes or destroys the mine, or produces, in the area, the influence fields necessary to actuate it.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OBSFL">
        <xs:annotation>
          <xs:documentation>Observation Flight. The airborne surveillance of aerospace, surface, or subsurface areas, places, persons, or things, by visual, aural, electronic, photographic, or other means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OCA">
        <xs:annotation>
          <xs:documentation>Offensive Counterair. Offensive operations to destroy, disrupt, or neutralize enemy aircraft, missiles, launch platforms, and their supporting structures and systems both before and after launch, but as close to their source as possible. Offensive counterair operations range throughout enemy territory and are generally conducted at the initiative of friendly forces. These operations include attack operations, fighter sweep, escort, and suppression of enemy air defenses.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Indicates the mission is something other than any of the missions listed. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PADP">
        <xs:annotation>
          <xs:documentation>Personnel Airdrop. An aerial mission, which focuses on the delivery of personnel from an aircraft in flight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PCAP">
        <xs:annotation>
          <xs:documentation>Point CAP. Combat Air Patrol flown in support of a rendezvous or a break-up point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PJCRE">
        <xs:annotation>
          <xs:documentation>Pararescue Jumper Combat Rescue Exfiltration. The removal of personnel from areas under enemy control by specially trained personnel qualified to penetrate to the site of an incident by land or parachute, render medical aid, accomplish survival methods, and rescue survivors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PJCRI">
        <xs:annotation>
          <xs:documentation>Pararescue Jumper Combat Rescue Infiltration. The movement through or into an area or territory occupied by either friendly or enemy troops or organizations specially trained personnel qualified to penetrate to the site of an incident by land or parachute, render medical aid, accomplish survival methods, and rescue survivors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PSYCH">
        <xs:annotation>
          <xs:documentation>Psychological Operations. Planned psychological activities designed to influence attitudes and behavior affecting the achievement of political and military objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDREC">
        <xs:annotation>
          <xs:documentation>Armed Road Recce. An aerial mission with the primary purpose of locating and attacking targets of opportunity such as enemy troop movements along lines of communication.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REC">
        <xs:annotation>
          <xs:documentation>Reconnaissance. A mission undertaken to obtain, by visual observation or other detection methods, information about the activities and resources of an enemy or potential enemy, or to secure data concerning the meteorological, hydrographic, or geographic characteristics of a particular area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAAM">
        <xs:annotation>
          <xs:documentation>Special Assignment Airlift Mission. An aerial mission which focuses on specific airlift requirements, that requires special consideration due to the number of passengers involved, weight or size of cargo, urgency of movement, sensitivity, or other valid factors that preclude the use of channel airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SADP">
        <xs:annotation>
          <xs:documentation>Strategic Airdrop. An aerial mission, which focuses on long range airdrop operations, meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAL">
        <xs:annotation>
          <xs:documentation>Strategic Airlift. The carriage of passengers and cargo between theatres by means of: a. scheduled service; b. special flight; c. air logistic support; d. aeromedical evacuation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAR">
        <xs:annotation>
          <xs:documentation>Search and Rescue. The use of aircraft, surface craft (land or water), submarines, specialized rescue teams, and equipment to search for and rescue personnel in distress on land or at sea.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCAR">
        <xs:annotation>
          <xs:documentation>Strike Coordination and Reconnaissance (SCAR). An aerial mission to conduct reconnaissance strike coordination and reconnaissance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAD">
        <xs:annotation>
          <xs:documentation>Suppression Enemy Air Defense. An aerial mission conducted to neutralize, destroy, or temporarily degrade surface-based enemy air defenses by destructive and/or disruptive means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEC">
        <xs:annotation>
          <xs:documentation>Security. The measures necessary to achieve protection against espionage, sabotage, subversion, and terrorism, as well as against loss or unauthorized disclosure.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SMSN">
        <xs:annotation>
          <xs:documentation>Support Mission. This mission type includes movement of personnel or equipment other than via tactical airlift, security services missions, UHF relay, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPECL">
        <xs:annotation>
          <xs:documentation>Special. An aerial mission which may be further described in a free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SRI">
        <xs:annotation>
          <xs:documentation>Sensor Implant. An aerial mission, which focuses on operations where aircraft are tasked to airdrop sensors over a given geographic area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUCAP">
        <xs:annotation>
          <xs:documentation>Surface Combat Air Patrol (SUCAP). Combat air patrol flown in support of surface vessels conducting maritime operations. ATO mission that represents five specific AOMSW missions: surface surveillance coordination (SSC), armed reconnaissance (AR)/strike coordination and reconnaissance (SCAR), war-at-sea (WAS) strike, counter-fast attack craft (FAC)/fast inshore attack craft (FIAC), and airborne maritime mining (AMM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SWEP">
        <xs:annotation>
          <xs:documentation>Fighter Sweep. An aerial offensive mission conducted by fighter aircraft to seek out and destroy enemy aircraft or targets of opportunity in an allotted area of operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACA">
        <xs:annotation>
          <xs:documentation>Tactical Aircraft Coordinator (Airborne). An officer who coordinates, from an aircraft, the actions of other aircraft engaged in air support of ground or sea forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TADP">
        <xs:annotation>
          <xs:documentation>Tactical Airdrop. An aerial mission, which focuses on airdrop of troops or cargo into a hostile environment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TAL">
        <xs:annotation>
          <xs:documentation>Theater Airlift. That airlift assigned or attached to a Combatant Commander other than Commander, US Transportation Command, that provides air movement and delivery of personnel and equipment directly into objective areas through air landing, airdrop, extraction, or other delivery techniques; and the air logistic support of all theater forces, including those engaged in combat operations, to meet specific theater objectives and requirements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TALD">
        <xs:annotation>
          <xs:documentation>Tactical Airland (Assault). An aerial mission, which focuses on cargo and/or passengers delivered by air-landing the aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TARL">
        <xs:annotation>
          <xs:documentation>Tactical Air Reconnaissance (Land). The use of air vehicles to obtain information concerning terrain, weather, and the disposition, composition, movement, installations, lines of communications, electronic, and communication emissions of enemy forces.  Also included are artillery and naval gunfire adjustment, and systematic and random observation of ground battle areas, targets, and/or sectors of airspace.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TARM">
        <xs:annotation>
          <xs:documentation>Tactical Air Reconnaissance (Maritime). Includes MRR.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRNG">
        <xs:annotation>
          <xs:documentation>Operational Training. Training that develops, maintains or improves the operational readiness of individuals or units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRNSF">
        <xs:annotation>
          <xs:documentation>Transfer.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UTLTY">
        <xs:annotation>
          <xs:documentation>Utility Flight. An aerial mission in which the aircraft has the capability of performing multiple missions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VIPLF">
        <xs:annotation>
          <xs:documentation>Very Important Person (VIP) Lift. An aerial mission, which focuses on the air transport of high ranking and/or important individuals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WAS">
        <xs:annotation>
          <xs:documentation>War at Sea Strike.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WXREC">
        <xs:annotation>
          <xs:documentation>Weather Reconnaissance (Recce). An aerial mission to obtain, by visual observation or other detection methods, information concerning the meteorological or hydrographic characteristics of a particular area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAAW">
        <xs:annotation>
          <xs:documentation>Airborne Alert Anti-Air Warfare. A state of aircraft readiness wherein aircraft are airborne and ready to perform anti-air operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAEW">
        <xs:annotation>
          <xs:documentation>Airborne Alert Airborne Early Warning. A state of aircraft readiness wherein aircraft are airborne and ready to perform early warning operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAH">
        <xs:annotation>
          <xs:documentation>Airborne Alert Attack Helicopter. A state of aircraft readiness wherein rotary-wing aircraft are airborne and ready to perform attack operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAI">
        <xs:annotation>
          <xs:documentation>Airborne Alert Interdiction. A state of aircraft readiness wherein aircraft are airborne and ready to perform interdiction operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAIM">
        <xs:annotation>
          <xs:documentation>Armed Reconnaissance (Maritime). A mission with the primary purpose of locating and attacking enemy maritime targets of opportunity.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAME">
        <xs:annotation>
          <xs:documentation>Airborne Alert Aeromedical Evacuation. A state of aircraft readiness wherein aircraft are airborne and ready to perform aeromedical evacuation operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAML">
        <xs:annotation>
          <xs:documentation>Airborne Alert Troop/Cargo Helicopter Operation. A state of aircraft readiness wherein helicopter aircraft are airborne and ready to perform transportation operations for troops or cargo.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAR">
        <xs:annotation>
          <xs:documentation>Airborne Alert Aerial Refueling. A state of aircraft readiness wherein aircraft are airborne and ready to perform aerial refueling operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XASW">
        <xs:annotation>
          <xs:documentation>Airborne Alert Anti-Submarine Warfare. A state of aircraft readiness wherein aircraft are airborne and ready to perform anti-submarine operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XATK">
        <xs:annotation>
          <xs:documentation>Airborne Alert Attack. A state of aircraft readiness wherein aircraft are airborne and ready to employ various weapons to destroy enemy targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XBAR">
        <xs:annotation>
          <xs:documentation>Airborne Alert Barrier Combat Air Patrol. A state of aircraft readiness wherein aircraft are airborne and ready to perform barrier combat air patrol operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XCAP">
        <xs:annotation>
          <xs:documentation>Airborne Alert Combat Air Patrol. A state of aircraft readiness wherein aircraft are airborne and ready to perform combat air patrol operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XCAS">
        <xs:annotation>
          <xs:documentation>Airborne Alert Close Air Support. A state of aircraft readiness wherein aircraft are airborne and ready to perform close air support operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XCOM">
        <xs:annotation>
          <xs:documentation>Airborne Alert Communications Relay. A state of aircraft readiness wherein aircraft are airborne and fitted with communication relay stations for the purpose of increasing the range, flexibility, or physical security of communications systems.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XDCA">
        <xs:annotation>
          <xs:documentation>Airborne Alert Defensive Counterair. A state of aircraft readiness wherein aircraft are airborne and ready to perform defensive counterair operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XESC">
        <xs:annotation>
          <xs:documentation>Airborne Alert Escort. A state of aircraft readiness wherein aircraft are airborne and ready to perform escort operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XEW">
        <xs:annotation>
          <xs:documentation>Airborne Alert Electronic Warfare. A state of aircraft readiness wherein aircraft are airborne and ready to perform electronic warfare operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XFACA">
        <xs:annotation>
          <xs:documentation>Airborne Alert Forward Air Controller. A state of aircraft readiness wherein aircraft are airborne and ready to perform forward air control operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XILL">
        <xs:annotation>
          <xs:documentation>Airborne Alert Illumination. A state of aircraft readiness wherein aircraft are airborne and ready to perform battlefield illumination by airdropping high-powered flares.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XJCP">
        <xs:annotation>
          <xs:documentation>Airborne Alert Joint Communications Center/Command Post. A state of aircraft readiness wherein aircraft are airborne and ready to perform joint command and control operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XMINL">
        <xs:annotation>
          <xs:documentation>Airborne Alert Minelaying. A state of aircraft readiness wherein aircraft are airborne and ready to airdrop an encased explosive over ground or in water and set to explode when disturbed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XMINS">
        <xs:annotation>
          <xs:documentation>Airborne Alert Minesweeping. A state of aircraft readiness wherein aircraft are airborne and ready to locate minefields and neutralize them by dropping ordnance over the area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XOCA">
        <xs:annotation>
          <xs:documentation>Airborne Alert Offensive Counterair. A state of aircraft readiness wherein aircraft are airborne and ready to perform offensive counterair operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XREC">
        <xs:annotation>
          <xs:documentation>Airborne Alert Reconnaissance. A state of aircraft readiness wherein aircraft are airborne and ready to perform reconnaissance operations. It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSA">
        <xs:annotation>
          <xs:documentation>Airborne Alert Strategic Attack. A state of aircraft readiness wherein aircraft are airborne and ready to perform any long range air operation meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSAR">
        <xs:annotation>
          <xs:documentation>Airborne Alert Search and Rescue. A state of aircraft readiness wherein aircraft are airborne and ready to perform search and rescue operations. It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSEAD">
        <xs:annotation>
          <xs:documentation>Airborne Alert Suppression Enemy Air Defense. A state of aircraft readiness wherein aircraft are airborne and ready to perform activities which neutralizes, destroys, or temporarily degrades enemy air defenses in a specific area by physical attack and/or electronic warfare.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSRI">
        <xs:annotation>
          <xs:documentation>Airborne Alert Sensor Implant. A state of aircraft readiness wherein aircraft are airborne and ready to airdrop sensors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XSUCAP">
        <xs:annotation>
          <xs:documentation>Airborne Alert Surface Combat Air Patrol (SUCAP). A state of aircraft readiness wherein aircraft are airborne and ready to perform a combat air patrol in support of surface vessels conducting maritime operations. ATO mission that represents airborne alert variations of five specific AOMSW missions: surface surveillance coordination (SSC), armed reconnaissance (AR)/strike coordination and reconnaissance (SCAR), war-at-sea (WAS) strike, counter-fast attack craft (FAC)/fast inshore attack craft (FIAC), and airborne maritime mining (AMM).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MissionCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type of mission being requested or tasked.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MissionCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="MissionCommanderCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the commander responsible for managing and harmonizing the efforts of temporarily assigned forces to execute a single mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="MC">
        <xs:annotation>
          <xs:documentation>Mission Commander.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MissionCommanderCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the commander responsible for managing and harmonizing the efforts of temporarily assigned forces to execute a single mission.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MissionCommanderCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="MissionCompletionStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code to indicate the status of a scheduled reconnaissance mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABORT COMPL">
        <xs:annotation>
          <xs:documentation>Abort Complete. The reconnaissance mission is aborted after entering denied airspace or the RRA, or a mission planned outside denied airspace or RRA has completed more than one-half (50%) of the scheduled collection.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ABORT INCOMP">
        <xs:annotation>
          <xs:documentation>Abort Incomplete. The reconnaissance mission is aborted before entering denied airspace or the RRA, or a mission planned outside denied airspace or RRA has completed less than one-half (50%) of the scheduled collection time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AS SCHEDULED">
        <xs:annotation>
          <xs:documentation>As Scheduled. The reconnaissance mission launched within plus or minus thirty minutes of the scheduled departure time or plus or minus thirty minutes of the scheduled arrival time at the scheduled recovery base.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEVIATION">
        <xs:annotation>
          <xs:documentation>Deviation. The reconnaissance mission deviates more than thirty minutes from the scheduled departure or arrival times or the mission launches or recovers at any base other than the scheduled recovery base.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MissionCompletionStatusCodeType">
    <xs:annotation>
      <xs:documentation>A data type for the code to indicate the status of a scheduled reconnaissance mission.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MissionCompletionStatusCodeSimpleType">
        <xs:attributeGroup ref="structures:SimpleObjectAttributeGroup"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="MissionDesignatorCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the designator of a mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ASWX">
        <xs:annotation>
          <xs:documentation>Other ASW Operational Tasking. Includes convoy support, barrier ops, investigations, and water sampling. Assigned tgt level or higher trademark, omitting the words case and desig.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAST">
        <xs:annotation>
          <xs:documentation>Unrestricted Submarine Services. Use last name of submarine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CASW">
        <xs:annotation>
          <xs:documentation>Coordinated ASW Training Operations. Use last name of the OCE and submarine separated by a hyphen (e.g., CASW-FIFE-GURNARD).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ICEX">
        <xs:annotation>
          <xs:documentation>Ice Patrol. Track name or operation name.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INTC">
        <xs:annotation>
          <xs:documentation>Surface Intelligence Collection. Flight tasked against a surface intelligence collection unit. Use last name of unit, or vessel pennant number (e.g., PELENG).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOGX">
        <xs:annotation>
          <xs:documentation>Logistics Support Flight. Use assigned name (e.g., CYNTHIA 14).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MPAT">
        <xs:annotation>
          <xs:documentation>Maritime Air Patrol. Designated track/area name.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NIBX">
        <xs:annotation>
          <xs:documentation>Restricted Submarine Services. Use last name of submarine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OOAX">
        <xs:annotation>
          <xs:documentation>Former Soviet Submarine Prosecution Program. Prosecution program specifically in response to former Soviet submarine patrols on station. Assigned target level or higher trademark. Omit the words case and desig. Use INVEST if no trademark is assigned.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PARP">
        <xs:annotation>
          <xs:documentation>Peacetime Aerial Reconnaissance Program (PARPRO). Track designator or name.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDTE">
        <xs:annotation>
          <xs:documentation>Research, Development, Test, and Evaluation. Research, development, test, and evaluation support tasking. Use RDTE project code or name.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RELO">
        <xs:annotation>
          <xs:documentation>Relocation Mission. Use last name of vessel or class and hull number (e.g., SVERDLOV 382) or ship pendant number (e.g., MB11).</xs:documentation>
