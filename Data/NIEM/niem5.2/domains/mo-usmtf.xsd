        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="09">
        <xs:annotation>
          <xs:documentation>Suspicion Category 9. Vessels not constructed for the prevailing sea state.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="10">
        <xs:annotation>
          <xs:documentation>Suspicion Category 10. Vessels not fitting other codes but warranting special attention.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
