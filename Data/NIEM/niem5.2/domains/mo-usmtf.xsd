  <xs:simpleType name="TidalCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the difference in the relative size of tides concurrent with the times of high and low waters.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="MEAN">
        <xs:annotation>
          <xs:documentation>Mean. The difference in height between mean high water and mean low water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEAP">
        <xs:annotation>
          <xs:documentation>Neap. A tide of minimum range between high and low tide occurring each lunar month around the first and third quarters of the moon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPRING">
        <xs:annotation>
          <xs:documentation>Spring. The average semidiurnal range occurring at the time of spring tides; this is most conveniently computed from the harmonic constants.  it is larger than the mean range where the type of tide is either semidiurnal or mixed, and is of no practical significance where the type of tide is diurnal.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
