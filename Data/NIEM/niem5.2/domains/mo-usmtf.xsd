        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TYPE 2">
        <xs:annotation>
          <xs:documentation>Type 2 Control. Used when the Joint Terminal Attack Controller (JTAC) requires control of individual attacks and certain conditions exist. For further U.S. implementation guidance, see Repository of USMTF Program Items Document, item 56.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TYPE 3">
        <xs:annotation>
