  <xs:complexType name="MissionCategoryCodeType">
    <xs:annotation>
      <xs:documentation>A data type for a code to indicate the overall category for the mission areas.</xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="usmtf:MissionCategoryCodeSimpleType">
