  <xs:simpleType name="OperationalStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the ability of a facility, installation, major item of equipment or military position to perform the function for which it was intended.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABN">
        <xs:annotation>
          <xs:documentation>Abnormal. Operating in other than the normally accepted or expected mode.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEF">
        <xs:annotation>
          <xs:documentation>Defended. Facility, military position, or installation is defended by a military or paramilitary force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LTD">
        <xs:annotation>
          <xs:documentation>Limited Operations. Essential equipment to operate the facility has specified limitations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOP">
        <xs:annotation>
          <xs:documentation>Not Operational. Essential equipment to operate the facility may be present but is unassembled and/or not installed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OPR">
        <xs:annotation>
          <xs:documentation>Fully Operational. Essential equipment to operate the facility is present and in place and the facility may be or can be placed in operation on short notice.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RMV">
        <xs:annotation>
          <xs:documentation>Removed. Equipment essential to operate the facility or military position has been removed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RNO">
        <xs:annotation>
          <xs:documentation>Reported Not Operational. Reported not operational but status has not been confirmed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROP">
        <xs:annotation>
          <xs:documentation>Reported Operational. Reported operational but status has not been confirmed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRN">
        <xs:annotation>
          <xs:documentation>Transitory. Facility or military position is of a transient nature.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UND">
        <xs:annotation>
          <xs:documentation>Undefended. Facility, military position, or installation is not defended by a military or paramilitary force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. Operational status unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
