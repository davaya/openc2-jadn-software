  <xs:simpleType name="OtherWeatherPhenomenaCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for weather phenomena other than normal precipitation and obscuration such as dust storms or severe weather that exists or is forecast to exist in the tactical operations area.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="+FC">
        <xs:annotation>
          <xs:documentation>Tornado or Waterspout. A violent, rotating column of air, forming a pendant and touching the ground or water surface.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DS">
        <xs:annotation>
          <xs:documentation>Duststorm. An unusual, frequently severe weather condition characterized by strong winds and dust-filled air over an extensive area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FC">
        <xs:annotation>
          <xs:documentation>Funnel Cloud. A violent, rotating column of air which does not touch the surface, usually a pendant from a cumulonimbus cloud.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQ">
        <xs:annotation>
          <xs:documentation>Squalls. A strong wind characterized by a sudden onset in which the wind speed increases at least 16 knots and is sustained at 22 knots or more for at least one minute.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SS">
        <xs:annotation>
          <xs:documentation>Sandstorm. Particles of sand that are carried aloft by strong wind. The sand particles are mostly confined to the lowest ten feet, and rarely rise more than fifty feet above the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
