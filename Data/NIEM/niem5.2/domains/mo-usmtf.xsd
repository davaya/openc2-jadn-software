  <xs:simpleType name="MIJICodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of MIJI encountered or employed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="INTERFER">
        <xs:annotation>
          <xs:documentation>Interference. Any electromagnetic or electro-optic disturbance which interrupts, obstructs, or otherwise degrades or limits the effective performance of electronics, electrical, and/or electro-optic equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INTRUS">
        <xs:annotation>
          <xs:documentation>Intrusion. The intentional insertion of electromagnetic energy into transmission paths in any manner with the objective of deceiving operators or of causing confusion.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JAMMING">
        <xs:annotation>
          <xs:documentation>Jamming. The deliberate radiation, reradiation, or reflection of electromagnetic signals with the object of impairing the use of electronic devices.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEACON">
        <xs:annotation>
          <xs:documentation>Meaconing. A system of receiving radio beacon signals and rebroadcasting them on the same frequency to confuse navigation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
