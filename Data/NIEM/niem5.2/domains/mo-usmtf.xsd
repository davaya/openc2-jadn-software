  <xs:simpleType name="HeatStressConditionFlagCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the color of the heat stress condition flag.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BLACK">
        <xs:annotation>
          <xs:documentation>Black. Flag condition for wet bulb globe temperature index of 90F or above. No physical training is to be conducted. Troop work details should proceed with extreme caution.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GREEN">
        <xs:annotation>
          <xs:documentation>Green. Flag condition for wet bulb globe temperature index of 80 to 84.9F. Individuals in charge of unit physical training or work details should monitor the Wet Bulb Globe Temperature Index (WBGTI) hourly, as changes are likely.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RED">
        <xs:annotation>
          <xs:documentation>Red. Flag condition for wet bulb globe temperature index of 88 to 89.9F. Personnel must have been in the immediate geographic area for greater than twelve weeks before they may participate in physical training or strenuous exercise.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="YELLOW">
        <xs:annotation>
          <xs:documentation>Yellow. Flag condition for wet bulb globe temperature index of 85 to 87.9F. In order to participate in physical training or strenuous exercise, personnel must have been in the immediate geographic area for greater than four weeks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
