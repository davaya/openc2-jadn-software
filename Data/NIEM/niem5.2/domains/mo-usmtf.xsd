  <xs:simpleType name="HigherEchelonDesignatorSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a unit designation of a unit superior to another unit or to its parent unit.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[\-\.,\(\)\?A-Z0-9&amp;#x20;]{1,21}">
        <xs:annotation>
          <xs:documentation>The official designation of the unit. If the designation is greater than the number of allowable characters, either employ abbreviations that are easily recognizable or standard (e.g., DIV for division) to reduce characters to accommodate limits, or enter in a following free-text set. If reporting a ship as the unit, omit the government designation. For example, enter the USS ROBERT G. BRADLEY as the BRADLEY RG.</xs:documentation>
        </xs:annotation>
      </xs:pattern>
    </xs:restriction>
  </xs:simpleType>
