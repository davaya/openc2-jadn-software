  <xs:simpleType name="DesignatedAreaCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type of designated area that affects air operations.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AAR">
        <xs:annotation>
          <xs:documentation>Air-to-Air Refueling Area. An area established for refueling aircraft while in flight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ACA">
        <xs:annotation>
          <xs:documentation>Airspace Coordination Area. An Airspace Coordination Area (ACA) is a three-dimensional area or corridor (a volume) of airspace established for the protection of friendly aircraft from surface delivered fires.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AEW">
        <xs:annotation>
          <xs:documentation>Airborne Early Warning Area. An area established for the detection of enemy air or surface units by radar or other equipment carried in an airborne vehicle and the transmitting of a warning to friendly units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIRREF">
        <xs:annotation>
          <xs:documentation>Air Refuel Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASUW">
        <xs:annotation>
          <xs:documentation>Antisurface Warfare Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASW">
        <xs:annotation>
          <xs:documentation>Antisubmarine Warfare Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAP">
        <xs:annotation>
          <xs:documentation>Combat Air Patrol Area. An area established for aircraft to patrol over an objective area, over the force protected, over the critical area of a combat zone, or over an air defense area, for the purpose of intercepting and destroying hostile aircraft before they reach their target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CFL">
        <xs:annotation>
          <xs:documentation>Coordinated Fire Line. Message used to designate a line beyond which conventional surface fire support means (mortars, field artillery, naval surface fire ships) may fire at any time within the zone of the establishing HQ without additional coordination. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNTAREA">
        <xs:annotation>
          <xs:documentation>Controlled Area. An area established for special air operations to be used only by authorized aircraft, e.g., refueling anchor or B-52 drop zone.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CONTAR">
        <xs:annotation>
          <xs:documentation>Contaminated Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DAR">
        <xs:annotation>
          <xs:documentation>Designated Area for Recovery. Designated geographical position adjacent to ingress/egress routes and the designated objective area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEFENSE">
        <xs:annotation>
          <xs:documentation>Defense Sector.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DZ">
        <xs:annotation>
          <xs:documentation>Drop Zone. An area used for airlift cargo/personnel delivery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FARRP">
        <xs:annotation>
          <xs:documentation>Forward Area Rearming Refueling Point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FEBA">
        <xs:annotation>
          <xs:documentation>Forward Edge of the Battle Area. The foremost limits of a series of areas in which ground combat units are deployed, excluding the areas in which the covering forces are operating, designated to coordinate fire support, the positioning of forces or the maneuver of units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FFA">
        <xs:annotation>
          <xs:documentation>Free Fire Area. Message used to delineate a specific, designated area into which any weapon system may fire without additional coordination from the establishing HQ. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLOT">
        <xs:annotation>
          <xs:documentation>Forward Line of Own Troops. A line which indicates the most forward positions of the friendly forces in any kind of military operation at a specific time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FREEFIR">
        <xs:annotation>
          <xs:documentation>Ground Free Fire Zone. An area which can be used by fire support elements without any prior coordination.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FREEPLY">
        <xs:annotation>
          <xs:documentation>Free Play Area. An area established for use as desired by an operational unit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSCL">
        <xs:annotation>
          <xs:documentation>Fire Support Coordination Line. Message used to designate a line beyond which all targets may be attacked by any weapon system (including aircraft and special weapons), without endangering or requiring additional coordination with establishing headquarters. (NATO/US use)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GT">
        <xs:annotation>
          <xs:documentation>Gun-Target Line. An imaginary straight line from an artillery gun or Naval Surface Fire (NSF) unit to a target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JETISON">
        <xs:annotation>
          <xs:documentation>Jettison Area. An area used by aircraft to jettison unused or hung ordnance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LLTR">
        <xs:annotation>
          <xs:documentation>Low Level Transit Route. A route used by aircraft flying low level missions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LZ">
        <xs:annotation>
          <xs:documentation>Landing Zone. A specified zone used for the landing of aircraft and/or helicopters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MFLD">
        <xs:annotation>
          <xs:documentation>Minefield. In land warfare, an area of ground containing mines laid with or without a pattern. In naval warfare, an area of water containing mines laid with or without a pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MRR">
        <xs:annotation>
          <xs:documentation>Minimum Risk Route. A route that has been designated as a minimum risk to aircraft encountering enemy fire.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MSLENG">
        <xs:annotation>
          <xs:documentation>Missile Engagement Zone. A zone that has been designated for missile firings at specific targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NFA">
        <xs:annotation>
          <xs:documentation>No Fire Area. Message used to delineate an area into which no fire or effects of fire are allowed. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORBIT">
        <xs:annotation>
          <xs:documentation>Orbit Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PEL">
        <xs:annotation>
          <xs:documentation>Potential Evasion Locale. Country-specified geographical locales which have been surveyed and categorized relative to successful evasion potential during wartime operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PICKUP">
        <xs:annotation>
          <xs:documentation>Pickup Zone. A zone that has been designated for aircraft or helicopters to pick up personnel or other objects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESTRIC">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Plan. Airspace established for friendly aircraft, by a restrictive fire plan, that is reasonably safe from friendly surface-delivered non-nuclear fires.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFA">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Area. Message used to delineate an area in which specific restrictions are imposed and into which fires that exceed those restrictions will not be delivered without coordination with establishing HQ. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFL">
        <xs:annotation>
          <xs:documentation>Restrictive Fire Line. Message used to define a line established between converging friendly forces, one or both may be moving, that prohibits fires or effects from fires across the line without coordination with the affected force. (US only)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RFP">
        <xs:annotation>
          <xs:documentation>Restricted Fire Plan. An area through which an aircraft can fly and avoid artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAFCOR">
        <xs:annotation>
          <xs:documentation>Safe Corridor.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAFE">
        <xs:annotation>
          <xs:documentation>Selected Area for Evasion. A designated area in hostile territory that offers the evader or escapee a reasonable chance of avoiding capture and of surviving until evacuated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAFETY">
        <xs:annotation>
          <xs:documentation>Safety Sector.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SARAREA">
        <xs:annotation>
          <xs:documentation>Search and Rescue Area. An area established for search and rescue missions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAVAPLN">
        <xs:annotation>
          <xs:documentation>Save-A-Plane. An area through which artillery is being fired.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAREF">
        <xs:annotation>
          <xs:documentation>Sea Refueling Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPECIAL">
        <xs:annotation>
          <xs:documentation>Special Airspace Sector. Airspace designated for special use, usually restricted to only those aircraft involved in special activity in the airspace.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STAGING">
        <xs:annotation>
          <xs:documentation>Staging Area. An area designated for use by a unit for resupply, assembly of forces, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUCAP">
        <xs:annotation>
          <xs:documentation>Surface Combat Air Patrol Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SURV">
        <xs:annotation>
          <xs:documentation>Surveillance Area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XERCISE">
        <xs:annotation>
          <xs:documentation>Exercise Area. An area established for use during an operational exercise.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ZOF">
        <xs:annotation>
          <xs:documentation>Zone of Fire. An area within which a designated ground unit or fire support ship delivers, or is prepared to deliver, fire support. Fire may or may not be observed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
