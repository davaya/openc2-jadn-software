      <xs:enumeration value="-DZ">
        <xs:annotation>
          <xs:documentation>Drizzle, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-FG">
        <xs:annotation>
          <xs:documentation>Fog, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-FU">
        <xs:annotation>
          <xs:documentation>Smoke, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-FZDZ">
        <xs:annotation>
          <xs:documentation>Freezing Drizzle, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-FZFG">
        <xs:annotation>
          <xs:documentation>Ice Fog, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-FZRA">
        <xs:annotation>
          <xs:documentation>Freezing Rain, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-GS">
        <xs:annotation>
          <xs:documentation>Small Hail and/or Ice Pellets, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-HZ">
        <xs:annotation>
          <xs:documentation>Haze, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-PE">
        <xs:annotation>
          <xs:documentation>Ice Pellets, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-RA">
        <xs:annotation>
          <xs:documentation>Rain, Light. Precipitation of liquid water particles generally falling at a rate of a trace up to 0.10 inches (2.5 mm) per hour.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-SA">
        <xs:annotation>
          <xs:documentation>Sand, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-SN">
        <xs:annotation>
          <xs:documentation>Snow, Light. Precipitation of ice crystals, mostly branched in the form of six-pointed stars falling at a rate less than 0.10 inches (2.5 mm) per hour.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="-VA">
        <xs:annotation>
          <xs:documentation>Volcanic Ash, Light.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+DS">
        <xs:annotation>
          <xs:documentation>Duststorm, Heavy. A duststorm is reported as heavy when the prevailing visibility is reduced to less than 5/16 statute mile.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+DU">
        <xs:annotation>
          <xs:documentation>Widespread Dust, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+DZ">
        <xs:annotation>
          <xs:documentation>Drizzle, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FC">
        <xs:annotation>
          <xs:documentation>Tornado or Waterspout. A violent, rotating column of air, forming a pendant and touching the ground or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FG">
        <xs:annotation>
          <xs:documentation>Fog, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FU">
        <xs:annotation>
          <xs:documentation>Smoke, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FZDZ">
        <xs:annotation>
          <xs:documentation>Freezing Drizzle, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FZFG">
        <xs:annotation>
          <xs:documentation>Ice Fog, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+FZRA">
        <xs:annotation>
          <xs:documentation>Freezing Rain, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+GS">
        <xs:annotation>
          <xs:documentation>Heavy Small Hail and/or Ice Pellets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+HZ">
        <xs:annotation>
          <xs:documentation>Haze, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+PE">
        <xs:annotation>
          <xs:documentation>Ice Pellets, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+RA">
        <xs:annotation>
          <xs:documentation>Rain, Heavy. Intense precipitation of liquid water particles.  Rain seemingly falls in sheets at a rate greater than 0.30 inches (7.6 mm) per hour.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+SA">
        <xs:annotation>
          <xs:documentation>Sand, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+SHRA">
        <xs:annotation>
          <xs:documentation>Rain Shower, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+SHSN">
        <xs:annotation>
          <xs:documentation>Snow Shower, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+SN">
        <xs:annotation>
          <xs:documentation>Snow, Heavy. Intense precipitation of ice crystals falling at a rate greater than 0.30 inches (7.6 mm) per hour.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+SS">
        <xs:annotation>
          <xs:documentation>Sandstorm, Heavy. A sandstorm is reported as heavy when the prevailing visibility is reduced to less than 5/16 statute mile.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+TS">
        <xs:annotation>
          <xs:documentation>Thunderstorm, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="+VA">
        <xs:annotation>
          <xs:documentation>Volcanic Ash, Heavy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BCFG">
        <xs:annotation>
          <xs:documentation>Patchy Fog. When fog covers portions of the station and the apparent visibility in the fog or bank is less than 5/8 statute miles and visibility over the uncovered portions of the station is 5/8 statute miles or greater.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLDU">
        <xs:annotation>
          <xs:documentation>Blowing Dust. Dust raised by the wind to a height sufficient to reduce the horizontal visibility to below 7 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLPY">
        <xs:annotation>
          <xs:documentation>Blowing Spray. Water droplets torn by the wind from a body of water, generally from the crest of waves, and carried up into the air in such quantities that reduces the horizontal visibility to below 7 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLSA">
        <xs:annotation>
          <xs:documentation>Blowing Sand. Sand raised by the wind to a height sufficient to reduce the horizontal visibility to below 7 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLSN">
        <xs:annotation>
          <xs:documentation>Blowing Snow. Snow raised by the wind to a height sufficient to reduce the horizontal visibility to below 7 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BR">
        <xs:annotation>
          <xs:documentation>Mist. A visible aggregate of microscopic and more-or-less hygroscopic water droplets suspended in the atmosphere, based at the earth's surface, which reduces prevailing visibility to between 5/8 and 6 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DRDU">
        <xs:annotation>
          <xs:documentation>Low Drifting Dust. Dust raised by the wind to less than 6 feet above the ground. Visibility is not reduced below 7 statute miles at eye level although obstructions below this level may be veiled or hidden by the particles moving nearly horizontal to the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DRSA">
        <xs:annotation>
          <xs:documentation>Low Drifting Sand. Sand raised by the wind to less than 6 feet above the ground. Visibility is not reduced below 7 statute miles at eye level although obstructions below this level may be veiled or hidden by the particles moving nearly horizontal to the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DRSN">
        <xs:annotation>
          <xs:documentation>Low Drifting Snow. Snow raised by the wind to less than 6 feet above the ground. Visibility is not reduced below 7 statute miles at eye level although obstructions below this level may be veiled or hidden by the particles moving nearly horizontal to the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DS">
        <xs:annotation>
          <xs:documentation>Duststorm. An unusual, frequently severe weather condition characterized by strong winds and dust-filled air over an extensive area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DU">
        <xs:annotation>
          <xs:documentation>Widespread Dust. Fine particles of dust or sand suspended in the air by a duststorm or sandstorm that may have occurred at or far away from the station.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DZ">
        <xs:annotation>
          <xs:documentation>Drizzle. Fairly uniform precipitation composed exclusively of fine drops (diameter less than 0.02 inch) very close together.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FC">
        <xs:annotation>
          <xs:documentation>Funnel Cloud. A violent, rotating column of air which does not touch the surface, usually a pendant from a cumulonimbus cloud.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FG">
        <xs:annotation>
          <xs:documentation>Fog. A visible aggregate of minute water particles (droplets) which are based at the earth's surface. Fog reduces horizontal and vertical visibility, and may extend over a sizeable area. In surface reports, fog is recorded when the depth of the phenomena is greater than 20 feet and reduces prevailing visibility to less than 5/8 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FU">
        <xs:annotation>
          <xs:documentation>Smoke. A suspension of small particles in the air produced by combustion.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FZDZ">
        <xs:annotation>
          <xs:documentation>Freezing Drizzle. Drizzle which freezes upon impact with the ground or with objects in flight or on the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FZFG">
        <xs:annotation>
          <xs:documentation>Freezing Fog. A suspension of numerous minute ice crystals in the air, or water droplets at temperatures below 0 Celsius, based at the earth's surface, which reduces horizontal visibility to less than 7 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FZRA">
        <xs:annotation>
          <xs:documentation>Freezing Rain. Rain which freezes upon impact with the ground or with objects in flight or on the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GR">
        <xs:annotation>
          <xs:documentation>Hail. Precipitation in the form of small balls or other pieces of ice (hailstones) falling separately or frozen together in irregular lumps. Hailstones consist of alternate opaque and clear layers of ice in most cases.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GS">
        <xs:annotation>
          <xs:documentation>Small Hail and/or Ice Pellets. Precipitation of white, opaque grains of ice.  The grains are sometimes round and sometimes conical.  Diameters range from about 0.08 to 0.2 inch.  Snow pellets are brittle and easily crushed; when they fall on hard ground, they bounce and often break up.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HZ">
        <xs:annotation>
          <xs:documentation>Haze. A suspension in the air of extremely small, dry particles invisible to the naked eye and sufficiently numerous to give the air an opalescent appearance. This phenomenon resembles a uniform veil over the landscape that subdues all colors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IC">
        <xs:annotation>
          <xs:documentation>Ice Crystals. Unbranched ice crystals in the form of needles, columns, or plates.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MIFG">
        <xs:annotation>
          <xs:documentation>Shallow Ground Fog. When fog covers the surrounding area and visibility at 6 feet above the ground is (1) 7 statute miles or more and (2) the apparent visibility in the fog layer is less than 5/8 statute miles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PE">
        <xs:annotation>
          <xs:documentation>Ice Pellets. Precipitation of transparent or translucent pellets of ice, which are round or irregular, rarely conical, and which have a diameter of 0.2 inch, or less. They may be hard grains of ice consisting of frozen raindrops (sleet) or pellets of snow encased in a thin layer of ice.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PO">
        <xs:annotation>
          <xs:documentation>Well-Developed Dust/Sand Whirls. An ensemble of particles of dust or sand, sometimes accompanied by small litter, raised from ground in the form of a whirling column of varying height with a small diameter and an approximately vertical axis. Also known as dust devils.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PRFG">
        <xs:annotation>
          <xs:documentation>Partial Fog. When fog covers a substantial part of the station and visibility in the fog is less than 5/8 statute miles and visibility over the uncovered parts of the station is 5/8 statute miles or more.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PY">
        <xs:annotation>
          <xs:documentation>Spray. An ensemble of water droplets torn by the wind from the surface of an extensive body of water, generally from the crest of waves, and carried up a short distance in the air in such quantities as to reduce the horizontal visibility at eye level (6 feet).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RA">
        <xs:annotation>
          <xs:documentation>Rain. Precipitation of liquid water particles, either in the form of drops larger than 0.02 inch, or smaller drops which, in contrast to drizzle, are widely separated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SA">
        <xs:annotation>
          <xs:documentation>Sand. Sand raised by the wind to moderate heights above ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SG">
        <xs:annotation>
          <xs:documentation>Snow Grains. Precipitation of very small, white, opaque grains of ice. When the grains hit hard ground, they do not bounce or shatter. They usually fall in small quantities, mostly from stratus type clouds, and never as showers.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHGR">
        <xs:annotation>
          <xs:documentation>Hail Showers. Precipitation of hail that is showery in nature.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHGS">
        <xs:annotation>
          <xs:documentation>Small Hail/Snow Pellet Showers. Small hail/snow pellet events which start and stop abruptly.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHPE">
        <xs:annotation>
          <xs:documentation>Ice Pellet Showers. Precipitation of ice pellets that is showery in nature</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHRA">
        <xs:annotation>
          <xs:documentation>Rain Shower. Precipitation of liquid water particles which changes intensity or starts and stops abruptly.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHSN">
        <xs:annotation>
          <xs:documentation>Snow Shower. Precipitation of ice crystals which changes intensity or starts and stops abruptly.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SKC">
        <xs:annotation>
          <xs:documentation>Clear. Reported when 0/8 of the sky is covered.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SN">
        <xs:annotation>
          <xs:documentation>Snow. Precipitation of snow crystals, mostly branched in the form of six-pointed stars.  At temperatures higher than about -5 degrees Celsius, the crystals are generally clustered to form snowflakes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SQ">
        <xs:annotation>
          <xs:documentation>Squalls. A strong wind characterized by a sudden onset in which the wind speed increases at least 16 knots and is sustained at 22 knots or more for at least one minute.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SS">
        <xs:annotation>
          <xs:documentation>Sandstorm. Particles of sand that are carried aloft by strong wind. The sand particles are mostly confined to the lowest ten feet, and rarely rise more than fifty feet above the ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TS">
        <xs:annotation>
          <xs:documentation>Thunderstorm. A local storm produced by a cumulonimbus that is accompanied by lighting and/or thunder, usually with gusty winds, heavy rain, and sometimes, with hail.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VA">
        <xs:annotation>
          <xs:documentation>Volcanic Ash. Fine particles of rock powder that are blown out from a volcano and that may remain suspended in the atmosphere for long periods.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
