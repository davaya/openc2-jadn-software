  <xs:simpleType name="SpecificSpaceMissionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the specific type of space mission to be performed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AMC">
        <xs:annotation>
          <xs:documentation>Air Mobility Command Support Team. Used to identify specific team. GENTEXT section will elaborate on specific support team task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CENTAF">
        <xs:annotation>
          <xs:documentation>Central Air Forces Support Team. Used to identify specific team. GENTEXT section will elaborate on specific support team task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DCS">
        <xs:annotation>
          <xs:documentation>Defensive Counterspace. Operations to detect, identify, intercept, and destroy enemy space, air, and missile forces attempting to prevent friendly use of the space environment. Encompasses active and passive measure and generally reactive to enemy force initiative.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DELOG">
        <xs:annotation>
          <xs:documentation>Delog. Provide additional data not previously observed or reported.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIRSUP">
        <xs:annotation>
          <xs:documentation>Direct Support Operations. Unit is authorized to answer directly to supported forces' request for assistance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EVATES">
        <xs:annotation>
          <xs:documentation>Evaluation and Test. Provides test range support and documentation for identified activity as directed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXSUP">
        <xs:annotation>
          <xs:documentation>External Exercise Support. Provide required support to facilitate execution of exercise as defined in GENTEXT section.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXTESTSUP">
        <xs:annotation>
          <xs:documentation>External Test Support. Provide required support to facilitate execution of test as defined in GENTEXT section.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GLOOPT">
        <xs:annotation>
          <xs:documentation>Global Optimization. Provide greatest system accuracy for entire constellation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAUAUG">
        <xs:annotation>
          <xs:documentation>Launch to Augment. Provide launch to increase operational capability above the designed operational capability in response to war, crisis, or contingency. This includes launches considered in conjunction with non-space or non-launch alternatives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAUCAL">
        <xs:annotation>
          <xs:documentation>Launch Call. Standing order for spacelift operations for launches which are scheduled.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAUDEP">
        <xs:annotation>
          <xs:documentation>Launch to Deploy. Provide launch, or series of launches, required to initially achieve satellite systems' designed operational capability. This includes initial constellation deployments and research and development launches.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAUSUS">
        <xs:annotation>
          <xs:documentation>Launch to Sustain. Provide launch to replace satellites predicted to fail or that failed abruptly.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LSUP">
        <xs:annotation>
          <xs:documentation>Launch Support. Provide support for tracking and additional data in support of test and operational launches of space vehicles and terrestrial rockets and objects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NORSUP">
        <xs:annotation>
          <xs:documentation>Normal Support Operations. Conduct routine, daily operations in accordance with established regulations, operating instructions, and COMAFSPACE guidance. Note: expect guidance in STO Special Instructions (SPINS) section.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OCS">
        <xs:annotation>
          <xs:documentation>Offensive Counterspace. Operations conducted to destroy, disrupt, or limit enemy spacepower with objective of preventing enemy use of space environment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OUTLAU">
        <xs:annotation>
          <xs:documentation>Out of Cycle Launch. Launches which are not scheduled for an identified timeframe or changed in the standing launch call.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PACAF">
        <xs:annotation>
          <xs:documentation>Pacific Air Forces Support Team. Used to identify specific team. GENTEXT section will elaborate on specific support team task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POI">
        <xs:annotation>
          <xs:documentation>Period of Interest. Provide required support during a given time frame and defined area of interest to facilitate mission requirements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REA">
        <xs:annotation>
          <xs:documentation>Re-Entry Assessment. Provide support for identification and assessment of objects returning to the earth due to gravitational pull.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RECALL">
        <xs:annotation>
          <xs:documentation>Offline Recall. Provide tasked mission and special support to facilitate tasked requirements by ensuring resources are available to perform at the highest state of readiness to accomplish mission objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RECONFIG">
        <xs:annotation>
          <xs:documentation>Reconfigure. To change/manipulate the sensors/payloads on a bus/satellite (focus a sensor on a particular area, switch payloads off and on, etc.) and/or the terrestrial elements of the Air Force Space Control Network (AFSCN).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REGOPT">
        <xs:annotation>
          <xs:documentation>Regional Optimization. Provide greatest system accuracy for region identified in area section.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REPOS">
        <xs:annotation>
          <xs:documentation>Reposition. To maneuver a bus/satellite within its orbit, or to a different orbit, in order to optimize the use of its payload and/or to relocate a terrestrial element of the Air Force Space Control Network (AFSCN).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPESUP">
        <xs:annotation>
          <xs:documentation>Special Support Operations. Conduct operations as specifically directed. SPESUP OPS normally will enhance and optimize unit capabilities to support special tasking that applies for a limited area of interest, activity, and/or time. Note: SPESUP is a legal task. If used, the GENTEXT section will be used to amplify the task. Additionally, each mission area has unique special support tasks identified below.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TACOPT">
        <xs:annotation>
          <xs:documentation>Tactical Optimization. Provide greatest system accuracy for mission identified in ATO reference on TASKSYS line and/or GENTEXT line.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="USAFE">
        <xs:annotation>
          <xs:documentation>United States Air Forces Europe Support Team. Used to identify specific team. GENTEXT section will elaborate on specific support team task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
