      <xs:enumeration value="ARASLT">
        <xs:annotation>
          <xs:documentation>Assault, Air.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARRIVE">
        <xs:annotation>
          <xs:documentation>Aircraft Arrival. The arrival or landing of an aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATTACK">
        <xs:annotation>
          <xs:documentation>Attack.</xs:documentation>
