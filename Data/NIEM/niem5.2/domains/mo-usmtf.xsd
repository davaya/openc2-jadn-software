  <xs:simpleType name="MissileMissionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type or designation for a tasked missile mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ASUW">
        <xs:annotation>
          <xs:documentation>Anti-Surface Warfare/Anti-Surface Vessel Operations. Air operations conducted with the intention of denying the enemy the effective use of maritime surface assets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ATK">
        <xs:annotation>
          <xs:documentation>Attack. Any aerial mission meant to disrupt, neutralize, or destroy enemy forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEAD">
        <xs:annotation>
          <xs:documentation>Destruction Enemy Air Defenses (DEAD). An aerial mission that destroys surface-based enemy air defenses by any means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GASUW">
        <xs:annotation>
          <xs:documentation>Ground Alert Anti-Surface Warfare/Anti-Surface Vessel Operations. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to launch within a specified short period of time after receipt of a mission order, and perform operations conducted with the intention of denying the enemy the effective use of maritime surface assets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GATK">
        <xs:annotation>
          <xs:documentation>Ground Alert Attack. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to take off within a specified short period of time after receipt of a mission order, and are ready to employ various weapons to destroy enemy targets.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GDEAD">
        <xs:annotation>
          <xs:documentation>Ground Alert Destruction of Enemy Air Defenses. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to take off within a specified short period of time after receipt of a mission order, and perform a DEAD mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GINT">
        <xs:annotation>
          <xs:documentation>Ground Alert Interdiction. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to launch within a specified short period of time after receipt of a mission order, and perform an interdiction mission</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GOCA">
        <xs:annotation>
          <xs:documentation>Ground Alert Offensive Counterair. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to launch within a specified short period of time after receipt of a mission order, and perform offensive counterair operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSA">
        <xs:annotation>
          <xs:documentation>Ground Alert Strategic Attack. The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to launch within a specified short period of time after receipt of a mission order, and perform any long range air operation meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSEAD">
        <xs:annotation>
          <xs:documentation>Ground Alert Suppression Enemy Air Defense (SEAD). The status in which a missile on the ground/deck/aircraft is fully serviced and armed and is ready to take off within a specified short period of time after receipt of a mission order, and perform SEAD operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INT">
        <xs:annotation>
          <xs:documentation>Interdiction. Operations conducted to destroy, neutralize, or delay the enemy's military potential before it can be brought to bear effectively against friendly forces at such distance from friendly forces that detailed integration of each air mission with the fire and movement of friendly forces is not required.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OCA">
        <xs:annotation>
          <xs:documentation>Offensive Counterair. Offensive operations to destroy, disrupt, or neutralize enemy aircraft, missiles, launch platforms, and their supporting structures and systems both before and after launch, but as close to their source as possible. Offensive counterair operations range throughout enemy territory and are generally conducted at the initiative of friendly forces. These operations include attack operations, fighter sweep, escort, and suppression of enemy air defenses.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Indicates the mission is something other than any of the missions listed. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SA">
        <xs:annotation>
          <xs:documentation>Strategic Attack. Any long range air operation meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAD">
        <xs:annotation>
          <xs:documentation>Suppression Enemy Air Defense. An aerial mission conducted to neutralize, destroy, or temporarily degrade surface-based enemy air defenses by destructive and/or disruptive means.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
