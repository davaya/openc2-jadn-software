  <xs:simpleType name="RunwayOperationalStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the capability of a runway to support aircraft launch and recovery operations.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="LTD">
        <xs:annotation>
          <xs:documentation>Limited Operations. Aircraft launch and recovery operations from a runway are limited. Explain in subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOP">
        <xs:annotation>
          <xs:documentation>Not Operational. The runway is closed to all aircraft launch and recovery operations. Explain in subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OPR">
        <xs:annotation>
          <xs:documentation>Operational. The runway is open to all aircraft launch and recovery operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RNO">
        <xs:annotation>
          <xs:documentation>Reported Not Operational. The runway is reported closed to all aircraft launch and recovery operations but status has not been confirmed. Explain in subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROP">
        <xs:annotation>
          <xs:documentation>Reported Operational. The runway is reported open to all aircraft launch and recovery operations but status has not been confirmed. Explain in subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. Runway operational status is unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
