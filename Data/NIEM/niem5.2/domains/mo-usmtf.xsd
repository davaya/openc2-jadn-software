  <xs:simpleType name="ReliabilityEvaluationCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for an appraisal of the reliability of a source of information expressed in a graded term indicating the degree to which the source has been judged dependable or trustworthy.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:documentation>Completely Reliable. Completely reliable refers to a tried and trusted source which can be depended upon with confidence.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Usually Reliable. Usually reliable refers to a source which has been successful in the past but for which there is still some element of doubt in a particular case.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="C">
        <xs:annotation>
          <xs:documentation>Fairly Reliable. Fairly reliable refers to a source which has occasionally been used in the past and upon which some degree of confidence can be based.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation>
          <xs:documentation>Not Usually Reliable. Not usually reliable refers to a source which has been used in the past but has proved more often than not unreliable.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
