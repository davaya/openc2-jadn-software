  <xs:simpleType name="IsolatedPersonnelStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the status of an isolated person(s).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AKIA">
        <xs:annotation>
          <xs:documentation>Assumed Killed in Action. Due to the nature of the destruction of the aircraft, vehicle, or vessel; all personnel were assumed dead.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AWPU">
        <xs:annotation>
          <xs:documentation>Awaiting Pickup. Isolated personnel are awaiting SAR pickup.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHUT">
        <xs:annotation>
          <xs:documentation>Parachuted. Crew member(s) were observed parachuting from the plane prior to destruction or ground impact. Number of parachutes may be reported in free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CPTD">
        <xs:annotation>
          <xs:documentation>Captured. Isolated personnel were observed being taken into custody by enemy personnel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CPTI">
        <xs:annotation>
          <xs:documentation>Capture Appears Imminent. Isolated personnel were observed in or near vicinity of enemy personnel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CPTP">
        <xs:annotation>
          <xs:documentation>Probable Captured. Capture not confirmed, but situation such that isolated personnel were believed to have been captured.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EVAD">
        <xs:annotation>
          <xs:documentation>Evading. Isolated personnel are on the ground and evading the enemy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INJR">
        <xs:annotation>
          <xs:documentation>Injured. Isolated personnel have sustained injuries which may be a factor in their survival/rescue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="KIA">
        <xs:annotation>
          <xs:documentation>Killed in Action. Isolated personnel have been confirmed dead.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MIA">
        <xs:annotation>
          <xs:documentation>Missing in Action. Location and condition of isolated personnel unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOCH">
        <xs:annotation>
          <xs:documentation>No Chutes. Aircraft crash observed, but no chute(s) sighted.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESC">
        <xs:annotation>
          <xs:documentation>Rescued. Isolated personnel were rescued.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAFE">
        <xs:annotation>
          <xs:documentation>Safe From Capture. Isolated personnel observed not to be in or near vicinity of enemy personnel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. Disposition of isolated personnel is unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
