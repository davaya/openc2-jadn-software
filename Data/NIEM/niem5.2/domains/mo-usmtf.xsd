  <xs:simpleType name="NATOSubmarineCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the basic design, configuration, or primary function for which a NATO submarine was designed and constructed.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SG">
        <xs:annotation>
          <xs:documentation>Submarine, Guided/Cruise Missile.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SK">
        <xs:annotation>
          <xs:documentation>Submarine Hunter/Killer.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SR">
        <xs:annotation>
          <xs:documentation>Submarine, Research, Manned or Unmanned.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SS">
        <xs:annotation>
          <xs:documentation>Submarine, General. General designator for submarines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSA">
        <xs:annotation>
          <xs:documentation>Submarine, Auxiliary. Submarine used mainly in a non-combatant role which has at least a residual combat capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSAN">
        <xs:annotation>
          <xs:documentation>Submarine, Auxiliary Nuclear Powered. Same as for SSA but with nuclear power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSB">
        <xs:annotation>
          <xs:documentation>Submarine, Ballistic Missile. Submarine armed with ballistic missiles normally deployed on strategic missions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSBN">
        <xs:annotation>
          <xs:documentation>Submarine, Ballistic Missile, Nuclear. Same as for SSB but with nuclear power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSC">
        <xs:annotation>
          <xs:documentation>Submarine, Coastal. Submarine designed primarily for operations in coastal and shallow waters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSG">
        <xs:annotation>
          <xs:documentation>Submarine, Attack Missile. Submarine fitted with underwater to surface or surface to surface missiles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSGN">
        <xs:annotation>
          <xs:documentation>Submarine, Attack, Missile, Nuclear. Same as for SSG but with nuclear power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSK">
        <xs:annotation>
          <xs:documentation>Submarine, Patrol. Long range patrol submarine. May have primary anti-surface or anti-submarine role.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSN">
        <xs:annotation>
          <xs:documentation>Submarine, Attack, Nuclear. Nuclear propelled attack submarine with both anti-submarine and anti-surface capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SST">
        <xs:annotation>
          <xs:documentation>Submarine, Training. Submarine used primarily in a training role but with at least a residual combat capability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSU">
        <xs:annotation>
          <xs:documentation>Submarine, MILCAP Unknown. Submarine whose full military capability is unknown or has not been determined.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSUN">
        <xs:annotation>
          <xs:documentation>Submarine, MILCAP Unknown, Nuclear Powered. Same as for SSU but with nuclear power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SSW">
        <xs:annotation>
          <xs:documentation>Submarine, Midget, Swimmer. Midget submarine or submersible designed primarily for special operations and operated by naval forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSG">
        <xs:annotation>
          <xs:documentation>Submersible, Research, Commercial. Submersible with no combat capability used in research role.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="YSG">
        <xs:annotation>
          <xs:documentation>Submersible, Research, Military. Same as for TSG but military operated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="YSR">
        <xs:annotation>
          <xs:documentation>Submersible, Rescue, Naval. Same as for TSR but military operated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
