  <xs:simpleType name="CloudNameCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the name of the predominant cloud type.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AC">
        <xs:annotation>
          <xs:documentation>Altocumulus. A fleecy cloud formation consisting of large whitish globular cloudlets with shaded portions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AS">
        <xs:annotation>
          <xs:documentation>Altostratus. A cloud formation similar to cirrostratus but darker and at a lower level.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CB">
        <xs:annotation>
          <xs:documentation>Cumulonimbus. A cumulus cloud spread out in the shape of an anvil extending to great heights.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CC">
        <xs:annotation>
          <xs:documentation>Cirrocumulus. A cloud form of small rounded masses at high altitude usually in regular groupings forming a mackerel sky.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CI">
        <xs:annotation>
          <xs:documentation>Cirrus. A small white cloud of minute ice crystals formed at altitudes of 20,000 to 40,000 ft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CS">
        <xs:annotation>
          <xs:documentation>Cirrostratus. A uniform layer of high stratus cloud form.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CU">
        <xs:annotation>
          <xs:documentation>Cumulus. A massive cloud form having a flat base and rounded outlines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NS">
        <xs:annotation>
          <xs:documentation>Nimbostratus. A low dark gray rainy cloud layer.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SC">
        <xs:annotation>
          <xs:documentation>Stratocumulus. Rolls of dark cloud which often cover the whole sky especially in winter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ST">
        <xs:annotation>
          <xs:documentation>Stratus. A cloud form of greater horizontal extension and comparatively lower altitude (2000 to 7000 ft) than the cumulostratus or cirrostratus.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
