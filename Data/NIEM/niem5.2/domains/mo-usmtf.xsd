  <xs:simpleType name="AerialRefuelingSystemCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the system used by an aircraft for aerial refueling.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BDA">
        <xs:annotation>
          <xs:documentation>Boom Drogue Adapter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BOM">
        <xs:annotation>
          <xs:documentation>Boom. A refueling system by which a boom device on an aerial refueling tanker is inserted into a receptacle on a receiver aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BWD">
        <xs:annotation>
          <xs:documentation>Boom and Wingtip Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CBD">
        <xs:annotation>
          <xs:documentation>Boom and Centerline Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CDT">
        <xs:annotation>
          <xs:documentation>Centerline Drogue and Wingtip Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLD">
        <xs:annotation>
          <xs:documentation>Centerline Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CWT">
        <xs:annotation>
          <xs:documentation>Boom and Centerline Drogue, and Wingtip Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WTD">
        <xs:annotation>
          <xs:documentation>Wingtip Drogue.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
