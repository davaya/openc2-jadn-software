  <xs:simpleType name="MissionLocationCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type of mission location that is being described.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ANCHOR">
        <xs:annotation>
          <xs:documentation>Refueling Anchor. The point or set of points that establishes a refueling anchor.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAPPT">
        <xs:annotation>
          <xs:documentation>CAP Point. Combat Air Patrol (CAP) point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CENTER">
        <xs:annotation>
          <xs:documentation>Center. The center of a circle.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CSP">
        <xs:annotation>
          <xs:documentation>Commence Search Point. Point at which to start search.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DATUM">
        <xs:annotation>
          <xs:documentation>Datum. Last known position.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EP">
        <xs:annotation>
          <xs:documentation>End Point. The point an aircraft should cross to complete a mission track flown while employing special equipment (e.g., dispensers, emitters, sensors). Used in conjunction with initial point (IP) to depict a mission track.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HOLDPT">
        <xs:annotation>
          <xs:documentation>Holding Point. The point an aircraft should orbit at until instructed to proceed on the mission by the appropriate authority.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IP">
        <xs:annotation>
          <xs:documentation>Initial Point. The point an aircraft should cross when initiating the final phase of the mission. When used in conjunction with End Point (EP), IP refers to the start point of a mission track flown while employing special equipment (e.g., seeder of a chaff corridor).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ORBIT">
        <xs:annotation>
          <xs:documentation>Orbit Coordinates. The set of points that establishes the area within which an aircraft should orbit.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PUPNT">
        <xs:annotation>
          <xs:documentation>Survivor Pickup Point. The point established as a survivor pickup point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDZPT">
        <xs:annotation>
          <xs:documentation>Rendezvous Point. The point established as a rendezvous.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHIP">
        <xs:annotation>
          <xs:documentation>Naval Ship Coordinates. The set of points that establishes the location of a ship centrally involved in an air mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SRCHAR">
        <xs:annotation>
          <xs:documentation>Search Area. Area to be searched.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STRIP">
        <xs:annotation>
          <xs:documentation>Strip Coordinates. The set of points that establishes the strip of area to be reconnoitered.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TGTAR">
        <xs:annotation>
          <xs:documentation>Target Area Coordinates. The set of points that establishes a target area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TGTPT">
        <xs:annotation>
          <xs:documentation>Target Points. The individual points that should be reconnoitered, the points that allow for new pinpoint data coverage, or attack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
