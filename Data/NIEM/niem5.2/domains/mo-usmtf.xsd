  <xs:simpleType name="ObstructionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of terrain feature or object, natural or man-made, which may impede (stop, delay, divert, or channelize) free movement of vessels, vehicles, or land combat forces.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABATS">
        <xs:annotation>
          <xs:documentation>Abatis. A defensive obstacle formed by felled trees with sharpened branches facing the enemy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AFLD">
        <xs:annotation>
          <xs:documentation>Airfield. An area prepared for the accommodation (including any buildings, installations, and equipment), landing and take-off of aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARCH">
        <xs:annotation>
          <xs:documentation>Archipelago. A sea studded with islands, or the islands themselves, considered collectively.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BAR">
        <xs:annotation>
          <xs:documentation>Bar. An elongated offshore ridge or mound composed of unconsolidated material such as sand, gravel, or shells. Bars are usually submerged, parallel to and a short distance from the coastline, often at the mouth of a river or estuary.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BAR-RF">
        <xs:annotation>
          <xs:documentation>Barrier Reef. An elongated ridge or rock or coral and/or coral-like organisms, near and roughly parallel to the coast. It is separated from the shore by the deep water of a lagoon, and is cut through at intervals by channels or passes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BCH-SWL">
        <xs:annotation>
          <xs:documentation>Beach Swale. An elongated, sometimes marshy depression, between two ridges on the beach backshore (or on a sandpit), generally paralleling the shoreline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLDG">
        <xs:annotation>
          <xs:documentation>Building. A fixed construction, covering a space on land (or in the immediate nearshore), usually covered with a roof, enclosed by walls, or designed to stand more or less permanently.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRKWTR">
        <xs:annotation>
          <xs:documentation>Breakwater. A long, solid structure, sometimes attached to the shore, built to protect a shore area, harbor, anchorage, or basin from the impact of waves. A breakwater is usually made of stone, concrete blocks, rubble, or other material. Breakwaters are usually associated with harbors and anchorages exposed to open sea.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRSYS">
        <xs:annotation>
          <xs:documentation>Barrier System. A coordinated series of obstacles designed or employed to canalize, direct, restrict, delay, or stop the movement of an opposing force, and to impose additional losses in personnel, time, and equipment on the opposing force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUNKER">
        <xs:annotation>
          <xs:documentation>Bunker. A fortified chamber mostly below ground, often built with reinforced concrete and provided with embrasures.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUOY">
        <xs:annotation>
          <xs:documentation>Buoy. A floating object, anchored in a river or ocean bottom and used as a navigation aid to mark a channel, anchorage, or hazard. The buoy may be attached by a line or cable to an anchor or weight lying on the bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BWIRE">
        <xs:annotation>
          <xs:documentation>Barbed Wire. Twisted wires armed with barbs or sharp points.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CABLE">
        <xs:annotation>
          <xs:documentation>Cable. A strong rope, wire, or metal chain used for mooring vessels, buoys, etc., or an electric or communication wire.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CAVE">
        <xs:annotation>
          <xs:documentation>Cave. A natural underground chamber open to the surface.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHURCH">
        <xs:annotation>
          <xs:documentation>Church (Chapel, Temple). A building for public worship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CMTRY">
        <xs:annotation>
          <xs:documentation>Cemetery. A burial ground.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CONTAM">
        <xs:annotation>
          <xs:documentation>Contamination. The deposit and/or absorption of radioactive material, biological or chemical agents on or by structures, areas, personnel, or objects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRATR">
        <xs:annotation>
          <xs:documentation>Crater. The pit, depression, or cavity formed in the surface of the earth by an explosion. It may range from saucer shape to conical, depending largely on the depth of burst. In the case of a deep underground burst, no rupture of the surface may occur. The resulting cavity is termed a camouflet.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DAM">
        <xs:annotation>
          <xs:documentation>Dam. A barrier preventing the flow of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEPRS">
        <xs:annotation>
          <xs:documentation>Depression. A hollow in the terrain.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DITCH">
        <xs:annotation>
          <xs:documentation>Ditch, Tank. A barrier prepared to stop, impede, or divert movement of hostile tanks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EMPL">
        <xs:annotation>
          <xs:documentation>Emplacement. A prepared position for one or more weapons or pieces of equipment, for protection against hostile fire or bombardment, and from which they can execute their tasks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FENCE">
        <xs:annotation>
          <xs:documentation>Fence. A barrier, usually marking a boundary consisting of wooden or metal pickets, or else supporting wire or rail.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FHOLE">
        <xs:annotation>
          <xs:documentation>Foxhole. A pit dug usually hastily for individual cover against enemy fire.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FORT">
        <xs:annotation>
          <xs:documentation>Fortification/Structure. Works erected to defend a place or position.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSHNT">
        <xs:annotation>
          <xs:documentation>Fishnet. A fish-catching device which is a fabric made from such materials as string and cord, woven in an openwork pattern. It may be suspended over water and attached to poles or the fishnet may lie on the bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FSHSTK">
        <xs:annotation>
          <xs:documentation>Fishstake. Bamboo-like material used to channelize fish into a funnel-like trap.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GROIN">
        <xs:annotation>
          <xs:documentation>Groin. A one hundred to several hundred foot long, low, narrow, wall-like man-made protective structure. It is usually perpendicular to and extends from the backshore. It is designed to trap littoral drift or retard erosion. Groins are usually constructed of wood, masonry, steel reinforced concrete, or loosely piled rock and are spaced at intervals along the shore.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HDLD">
        <xs:annotation>
          <xs:documentation>Headland. A comparatively high, steep-faced promontory, which projects into a body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HELIP">
        <xs:annotation>
          <xs:documentation>Helipad. A prepared landing area designated and used for the takeoff and landing of helicopters (including touchdown and/or hover point).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HLTOP">
        <xs:annotation>
          <xs:documentation>Hilltop. The highest part of a hill.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ICE INLET">
        <xs:annotation>
          <xs:documentation>Ice Inlet. A narrow arm of sea which may extend a considerable distance inland. A short, narrow channel connecting a bay to a lagoon or a lagoon with the sea. A narrow strip of water between islands.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ISLD">
        <xs:annotation>
          <xs:documentation>Island. A land mass exposed during all tidal conditions which is completely surrounded by water, and whose longest axis is greater than 100 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JETTY">
        <xs:annotation>
          <xs:documentation>Jetty. A solid, linear, wall-like structure used to improve and stabilize tidal inlets and river mouths. Jetties project at an angle seaward from the shoreline through the normal surf zone. Usually constructed in pairs at the mouth of a river, inlet, or a harbor entrance. This is to prevent deposition of sand (shoaling) in the channel, regulate tides and river discharge, regulate, restrain and divert currents and protect vessels entering the channel against wave action.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAKE">
        <xs:annotation>
          <xs:documentation>Lake. A considerable inland body of standing water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LANDS">
        <xs:annotation>
          <xs:documentation>Landing Strip (Fixed Wing). An unimproved surface which has been adapted for takeoff and landing of fixed wing aircraft, usually having minimum facilities.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LANDSL">
        <xs:annotation>
          <xs:documentation>Landslide. A mass of rock, earth or artificial fill that has moved down a slope.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOG">
        <xs:annotation>
          <xs:documentation>Logs. A section of the trunk of a felled tree adrift in the water off a beach or shore or ensnared on the sea bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARSH">
        <xs:annotation>
          <xs:documentation>Marsh (Swamp). A track of soft, wet land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MEDFACILITY">
        <xs:annotation>
          <xs:documentation>Medical Facility. A structure or group of structures, permanent or temporary, which has a primary purpose of providing preventative or remedial medical treatment to personnel. Includes hospitals and aid stations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MINE">
        <xs:annotation>
          <xs:documentation>Mine. An encased explosive or other material (e.g., chemicals) designed to destroy material or to wound, kill or otherwise incapacitate personnel. Mines are laid on or below the surface of the ground and/or in inland waterways or the sea approach area, so as to stop, delay, or divert amphibious landing or ground force movement. In the sea approach, the fixed mine is either bottomlaid or moored by a cable to an anchor or weight in the water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MLTY-OBSTCL">
        <xs:annotation>
          <xs:documentation>Military Obstacle. Any man-made device (except mines) or passive defense works such as a barrier which is designed to stop, impede, or divert movement of amphibious or ground forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MNFLD">
        <xs:annotation>
          <xs:documentation>Minefield. An area of ground containing mines laid with or without pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOLE">
        <xs:annotation>
          <xs:documentation>Mole. A massive, solid fill structure projecting at an angle from the shore.  A mole protects a harbor from the force of waves and may serve as a pier or breakwater or both. Usually revetted with masonry or large stone. Its broad surface may support buildings, cargo handling equipment, rail spurs and roads.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NONE">
        <xs:annotation>
          <xs:documentation>None. There is no natural or man-made terrain feature or object which is likely to impede the free movement of forces moving toward an objective.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTHER">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PIER">
        <xs:annotation>
          <xs:documentation>Pier. A long, narrow structure which provides berthing for ships. It extends into a body of water at an angle to the shore and is made of piles, stone, or concrete. A pier may be straight, T-shaped, or L-shaped, with berthing along both sides and at its ends. It may support storage facilities, cargo handling equipment, and railroad tracks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PILBOX">
        <xs:annotation>
          <xs:documentation>Pillbox. A small, low fortification that houses machine guns, antitank weapons, etc. A pillbox is usually made of concrete, steel, or filled sandbags.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PIPLN">
        <xs:annotation>
          <xs:documentation>Pipeline. A line of pipe, including pumping machinery, servicing and supporting structures, used for conveying liquids, gases, or finely crushed solids (e.g., slurry).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLNG">
        <xs:annotation>
          <xs:documentation>Piling. Wood, metal or reinforced concrete poles driven into the land or sea bottom, singly or in clusters (dolphins). Pilings extend above water to serve as supports, as for a pier, protection for moorings, or to resist lateral pressure.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PT">
        <xs:annotation>
          <xs:documentation>Point. A small promontory which projects into a body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDBLK">
        <xs:annotation>
          <xs:documentation>Roadblock. A barrier or obstacle (usually covered by fire) used to block or limit movement of hostile vehicles along a route.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RDJCT">
        <xs:annotation>
          <xs:documentation>Junction, Road. An intersection of roads.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REEF">
        <xs:annotation>
          <xs:documentation>Reef. A low coastal ridge of rock or coral which is offshore (barrier reef) or closely attached to the shore (fringing reef). Most reefs extend upward from the sea floor and lie at or near the water surface at a depth which makes them a danger to surface vessels. Most reefs are submerged, especially at high tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REVET">
        <xs:annotation>
          <xs:documentation>Revetment. An embankment to provide shelter (as against bomb splinters or strafing).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIDGE">
        <xs:annotation>
          <xs:documentation>Ridge. An elongated crest or series of crests of hills or mountains.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER">
        <xs:annotation>
          <xs:documentation>River. A natural stream of water which flows permanently or seasonally. A river has greater volume than a creek or rivulet, flows in a more or less permanent bed or channel between defined banks or walls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RNL">
        <xs:annotation>
          <xs:documentation>Runnel. An elongated trough or depression of the beach on the foreshore or nearshore bottom, approximately parallel to the shoreline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROAD">
        <xs:annotation>
          <xs:documentation>Road. An open way for vehicles, persons, or animals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROCK">
        <xs:annotation>
          <xs:documentation>Rock. A consolidated or coherent and relatively hard, naturally formed mass of mineral matter. Also an aggregate of angular pieces of stone larger than 76 mm (3 inches) in diameter. Rock may occur as an isolated rocky formation or a single large stone. In the sea it may be submerged, uncovered, or alternatively covered and uncovered by the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RRCRS">
        <xs:annotation>
          <xs:documentation>Crossing, Railroad. A place where railroad track crosses a highway or street.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RRJCT">
        <xs:annotation>
          <xs:documentation>Junction, Railroad. An intersection of railroads.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RUIN">
        <xs:annotation>
          <xs:documentation>Ruin. The remains of a cultural feature such as a building, or an object that has been destroyed or has decayed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RVCRS">
        <xs:annotation>
          <xs:documentation>Crossing, River. A place where a river can be crossed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SADLE">
        <xs:annotation>
          <xs:documentation>Saddle. A ridge connecting two higher elevations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCHOOL">
        <xs:annotation>
          <xs:documentation>School. A building used to provide instruction.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHOAL">
        <xs:annotation>
          <xs:documentation>Shoal. A submerged ridge, bank or bar which is a detached elevation of the sea bottom. A shoal is composed of, or covered by sand, gravel, mud or other consolidated sediments. It is at or near enough to the water surface to constitute a danger to surface navigation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPIT">
        <xs:annotation>
          <xs:documentation>Spit. A low, elongated, exposed deposit of waterborne sediment, such as a reef, shoal or sandbank, which protrudes from the shore and terminates in the water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STAKE">
        <xs:annotation>
          <xs:documentation>Stake. A length of material, usually metal or wood, pointed at one end for driving into the ground. May be used for such purposes as anchoring a fish trap, as a boundary marker, or as a military obstacle. May be submerged.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STRM">
        <xs:annotation>
          <xs:documentation>Stream. A narrow body of flowing water or other fluid, great or small, occupying a channel on land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SWD">
        <xs:annotation>
          <xs:documentation>Seaweed. Underwater plant life such as seagrass and marine algae.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TDL-FLAT">
        <xs:annotation>
          <xs:documentation>Tidal Flat. A relatively broad, virtually level coastal flatland of sand, mud, or mudsand which is periodically covered and uncovered by the rise and fall of the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TERAIN">
        <xs:annotation>
          <xs:documentation>Terrain. The physical features of a tract of land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TOWER">
        <xs:annotation>
          <xs:documentation>Tower. A tall, vertical, obstruction, e.g., radio tower.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRACKS">
        <xs:annotation>
          <xs:documentation>Railroad (Tracks). The metal rails forming the path for a train.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRAIL">
        <xs:annotation>
          <xs:documentation>Trail. A marked path through forest or mountainous region.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TREEBD">
        <xs:annotation>
          <xs:documentation>Blowdown, Tree. Tree felled by wind.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRENCH">
        <xs:annotation>
          <xs:documentation>Trench. A long cut in the ground used for military defense, often with excavated dirt thrown up in front.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRLJCT">
        <xs:annotation>
          <xs:documentation>Junction, Trail. An intersection of trails.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TUNNEL">
        <xs:annotation>
          <xs:documentation>Tunnel. A horizontal passageway through or under an obstruction.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VALLEY">
        <xs:annotation>
          <xs:documentation>Valley. An elongated depression of the earth's surface usually between a range of hills or mountains.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WALL">
        <xs:annotation>
          <xs:documentation>Wall. A continuous, vertical structure, such as a concrete or rock wall serving to enclose, divide, support, or protect an area on land. Includes seawalls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WRK">
        <xs:annotation>
          <xs:documentation>Wreck. A hulk or ruin of a wrecked or stranded ship, either submerged or visible, which is attached to or foul of the bottom, or cast up on the shore. Includes abandoned, incapacitated vehicle hulls or airframes on land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
