  <xs:simpleType name="RunwayCompositionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the visible material or composition of the major landing portion of a runway.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ASPHALT">
        <xs:annotation>
          <xs:documentation>Asphalt.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BEDROCK">
        <xs:annotation>
          <xs:documentation>Bed Rock.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BIT">
        <xs:annotation>
          <xs:documentation>Bitumen. A coal tar or petroleum product binding, usually with sand and/or gravel.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BITHESS">
        <xs:annotation>
          <xs:documentation>Bithess.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BRICK">
        <xs:annotation>
          <xs:documentation>Brick. Laid and mortared.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CINDERS">
        <xs:annotation>
          <xs:documentation>Cinders.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY">
        <xs:annotation>
          <xs:documentation>Clay. A firm, fine-grained earth, plastic when wet, composed chiefly of hydrous aluminum silicate minerals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CONCR">
        <xs:annotation>
          <xs:documentation>Concrete. Stone, sand, cement, and water mixture.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORAL">
        <xs:annotation>
          <xs:documentation>Coral. A hard stony skeleton secreted by certain marine polyps and often deposited in extensive masses forming reefs and atolls in tropical seas.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EARTH">
        <xs:annotation>
          <xs:documentation>Earth. Unrefined soil; the soft granular or crumbly part of land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRASS">
        <xs:annotation>
          <xs:documentation>Grass. Ground covered with grass, i.e., surface covered by plants with typically long, narrow leaves that grow densely.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRAVEL">
        <xs:annotation>
          <xs:documentation>Gravel. Small pebbles or stones, may be crushed to achieve uniformity. (Spread and rolled, may be graded.)</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GYPSUM">
        <xs:annotation>
          <xs:documentation>Gypsum.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ICE">
        <xs:annotation>
          <xs:documentation>Ice. Water frozen, with thickness sufficient to bear weight of specific objects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LATERITE">
        <xs:annotation>
          <xs:documentation>Laterite. A residual product of rock decay that is red in color and has a high content of oxides of iron and low proportion of silica; a mottled quarriable type of clay which hardens on exposure to air.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LIMESTN">
        <xs:annotation>
          <xs:documentation>Limestone.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARBLE">
        <xs:annotation>
          <xs:documentation>Marble.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MCD">
        <xs:annotation>
          <xs:documentation>Macadam. Crushed stone rolled to form a smooth, hard surface and bound with clay, tar, or asphalt.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OIL">
        <xs:annotation>
          <xs:documentation>Oil. Surface covered with a substance having smooth, greasy consistency.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PAP">
