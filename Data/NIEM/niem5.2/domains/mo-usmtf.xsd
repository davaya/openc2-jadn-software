  <xs:simpleType name="AirliftMissionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the type of airlift mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AAR">
        <xs:annotation>
          <xs:documentation>Aerial Refueling. Refueling aircraft in flight, which extends presence, increases range, and serves as a force multiplier. May include bladder drop and refuel operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIREV">
        <xs:annotation>
          <xs:documentation>Aeromedical Evacuation. The movement of patients under medical supervision to and between medical treatment facilities by air transportation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CDS">
        <xs:annotation>
          <xs:documentation>Container Delivery System. An aerial mission, which focuses on the use of a system where containers are airdropped into a forward operating location.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CHANL">
        <xs:annotation>
          <xs:documentation>Channel Mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNTNG">
        <xs:annotation>
          <xs:documentation>Contingency. An aerial emergency mission involving military force caused by natural disasters, terrorists, subversives, or by required military operations. Due to the uncertainty of the situation, contingencies require plans, rapid response, and special procedures to ensure the safety and readiness of personnel, installations, and equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DVSPT">
        <xs:annotation>
          <xs:documentation>Distinguished Visitor Support. Air operations where military aircraft are used to transport distinguished visitors.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXER">
        <xs:annotation>
          <xs:documentation>Exercise. A military maneuver or simulated wartime operation involving planning, preparation, and execution. It is carried out for the purpose of training and evaluation. It may be a combined, joint, or single-service exercise, depending on participating organizations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FCF">
        <xs:annotation>
          <xs:documentation>Functional Check Flight. A flight conducted to confirm operational readiness of the flight crew or aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GAR">
        <xs:annotation>
          <xs:documentation>Ground Alert Aerial Refueling. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform aerial refueling operations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GDALT">
        <xs:annotation>
          <xs:documentation>Ground Alert. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GSAL">
        <xs:annotation>
          <xs:documentation>Ground Alert Strategic Airlift. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform strategic airlift operations. See strategic airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GTAL">
        <xs:annotation>
          <xs:documentation>Ground Alert Theater Airlift. The status in which aircraft on the ground/deck are fully serviced and armed, with combat crews in readiness to take off within a specified short period of time after receipt of a mission order, and perform theater airlift operations. See theater airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HVY">
        <xs:annotation>
          <xs:documentation>Heavy Equipment Airdrop. An aerial mission to unload heavy equipment from an aircraft in flight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JAATT">
        <xs:annotation>
          <xs:documentation>Joint Airborne Air Transportability Training. Training operations or exercises involving airborne and appropriate troop carrier units. This training includes: a. air delivery of personnel and equipment; b. assault operations by airborne troops and/or air transportable units; c. loading exercises and local orientation fights of short duration; and d. maneuvers and/or exercises as agreed upon by services concerned and/or as authorized by the Joint Chiefs of Staff.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAPES">
        <xs:annotation>
          <xs:documentation>Low Altitude Parachute Extraction System. An aerial mission which focuses on the use of self-contained system capable of a low-level delivering, heavy loads into an area where air landing is not feasible from an optimum aircraft wheel altitude of 5 to 10 feet above ground level. One or more platforms may be dropped.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTR">
        <xs:annotation>
          <xs:documentation>Other. Indicates the mission is something other than any of the missions listed. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PER">
        <xs:annotation>
          <xs:documentation>Personnel Airdrop. An aerial mission, which focuses on the delivery of personnel from an aircraft in flight.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAAM">
        <xs:annotation>
          <xs:documentation>Special Assignment Airlift Mission. An aerial mission which focuses on specific airlift requirements, that requires special consideration due to the number of passengers involved, weight or size of cargo, urgency of movement, sensitivity, or other valid factors that preclude the use of channel airlift.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SADP">
        <xs:annotation>
          <xs:documentation>Strategic Airdrop. An aerial mission, which focuses on long range airdrop operations, meant to strike an enemy at the sources of its military, economic, or political power.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAL">
        <xs:annotation>
          <xs:documentation>Strategic Airlift. The carriage of passengers and cargo between theatres by means of: a. scheduled service; b. special flight; c. air logistic support; d. aeromedical evacuation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPECL">
        <xs:annotation>
          <xs:documentation>Special. An aerial mission which may be further described in a free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUPT">
        <xs:annotation>
          <xs:documentation>Support. The action of a force, or portion thereof, which aids, protects, complements, or sustains any other force.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TADP">
        <xs:annotation>
          <xs:documentation>Tactical Airdrop. An aerial mission, which focuses on airdrop of troops or cargo into a hostile environment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TAL">
        <xs:annotation>
          <xs:documentation>Theater Airlift. That airlift assigned or attached to a Combatant Commander other than Commander, US Transportation Command, that provides air movement and delivery of personnel and equipment directly into objective areas through air landing, airdrop, extraction, or other delivery techniques; and the air logistic support of all theater forces, including those engaged in combat operations, to meet specific theater objectives and requirements.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TALD">
        <xs:annotation>
          <xs:documentation>Tactical Airland (Assault). An aerial mission, which focuses on cargo and/or passengers delivered by air-landing the aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRNG">
        <xs:annotation>
          <xs:documentation>Operational Training. Training that develops, maintains or improves the operational readiness of individuals or units.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRNSF">
        <xs:annotation>
          <xs:documentation>Transfer.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="XAR">
        <xs:annotation>
          <xs:documentation>Airborne Alert Aerial Refueling. A state of aircraft readiness wherein aircraft are airborne and ready to perform aerial refueling operations.  It is designed to reduce reaction time and to increase survivability.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
