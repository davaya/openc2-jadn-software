  <xs:simpleType name="SurroundingTerrainCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a tract of land as considered with reference to its natural features in, near or about the stated objective.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AIRFIELD">
        <xs:annotation>
          <xs:documentation>Airfield. An area prepared for the accommodation (including any buildings, installations, and equipment), landing, and takeoff of aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ARROYO">
        <xs:annotation>
          <xs:documentation>Arroyo. A water-carved gully or channel in an arid region.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BADLANDS">
        <xs:annotation>
          <xs:documentation>Badlands. A region nearly or completely devoid of vegetation, and where erosion has cut the land into narrow ravines and sharp-ridge crests and pinnacles.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BASIN">
        <xs:annotation>
          <xs:documentation>Basin. A broad depression in the land surface surrounded by higher ground. in arid regions, basins commonly include permanent or temporary salt lakes or salt flats. in areas of limestone bedrock, basins may be crossed by streams which emerge from an underground passage at one side and drain out through a continuation of this passage at the opposite end of the basin. This type is also referred to as a valley sink.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BAYOU">
        <xs:annotation>
          <xs:documentation>Bayou. A minor, slow-moving waterway or estuary creek that is tidal with a slow, imperceptible current.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLUFF, HIGH">
        <xs:annotation>
          <xs:documentation>Bluff, High. An abrupt slope, consisting of unconsolidated materials greater than 15 meters high, commonly borders a stream.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLUFF, LOW">
        <xs:annotation>
          <xs:documentation>Bluff, Low. An abrupt slope, consisting of unconsolidated materials less than 15 meters high, commonly borders a stream.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUTTE">
        <xs:annotation>
          <xs:documentation>Butte. An isolated, flat-topped hill or mountain located in an arid region. It is capped by a layer of hard rock and bounded for most or all of its circumference by an escarpment. It is not to be confused with a mesa.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANAL, DRAINAGE">
        <xs:annotation>
          <xs:documentation>Canal, Drainage. An artificial water channel designed for drainage. It has uniform depth and drainage width. It is a natural feature which has been improved specially for drainage of an area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANAL, IRRIGATION">
        <xs:annotation>
          <xs:documentation>Canal, Irrigation. An artificial water channel designed for irrigation. It has a uniform depth and width, designed for irrigation. It is a natural feature which has been improved specifically for irrigation of an area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANAL, NAVIGATION">
        <xs:annotation>
          <xs:documentation>Canal, Navigation. An artificial watercourse cut through land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CANYON">
        <xs:annotation>
          <xs:documentation>Canyon. A deep, narrow valley with steep sides. Canyons often have a stream flowing through it.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLIFF, HIGH">
        <xs:annotation>
          <xs:documentation>Cliff, High. A steep face of rock rising greater than 15 meters above the surrounding land or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLIFF, LOW">
        <xs:annotation>
          <xs:documentation>Cliff, Low. A steep face of rock rising less than 15 meters above surrounding land or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DELTA">
        <xs:annotation>
          <xs:documentation>Delta. A low, generally triangular, commonly marshy, alluvial deposit at the mouth of a river or a stream. It is often cut by tributaries of the main stream.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DESERT">
        <xs:annotation>
          <xs:documentation>Desert. A rocky, sandy area with wide spaces between plants or small groups of plants. Deserts develop as a result of deficient soil moisture associated with meager rainfall. Desert areas normally have a less than 10 inches of annual rainfall in the middle latitudes, and less than 15 inches in the tropics.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIKE">
        <xs:annotation>
          <xs:documentation>Dike. An artificial earth or stone embankment, causeway, or wall designated to contain or hold back water. It prevents flooding or delimiting of an area reclamation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DUNE, HIGH">
        <xs:annotation>
          <xs:documentation>Dune, High. A mound, ridge, or hill of wind-deposited sand. It is greater than 3 meters high.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DUNE, LOW">
        <xs:annotation>
          <xs:documentation>Dune, Low. A mound, ridge, or hill of wind-deposited sand. It is less than 3 meters high.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EMBANKMENT">
        <xs:annotation>
          <xs:documentation>Embankment. An artificial bank or mound built to hold back water or to support a roadway or railroad.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ESCARPMENT">
        <xs:annotation>
          <xs:documentation>Escarpment. A steep slope or long cliff formed by erosion or faulting and separating two level areas of different elevations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FAN, ALLUVIAL">
        <xs:annotation>
          <xs:documentation>Fan, Alluvial. A gentle sloping, fan-shaped mass of unconsolidated material deposited by a stream. It is usually located where the stream emerges from a highland, such as the mouth of a canyon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FISHPOND">
        <xs:annotation>
          <xs:documentation>Fishpond. A small, shallow, and artificially formed body of water used primarily for raising fish.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FJORD">
        <xs:annotation>
          <xs:documentation>Fjord. A narrow sea inlet located between cliffs or steep slopes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FOOTHILLS">
        <xs:annotation>
          <xs:documentation>Foothills. An area of transition from the higher elevation of a mountain range or higher hills, to adjacent lower terrain.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GLACIER">
        <xs:annotation>
          <xs:documentation>Glacier. A field of land ice and snow formed by snowfall in excess of melting. It often moves down a mountain slope or across a wide area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GORGE">
        <xs:annotation>
          <xs:documentation>Gorge. A deep, narrow, and extremely steep-sided valley. It is cut by a stream which occupies almost all of the valley floor. See ravine, arroyo, and gully.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GULLY">
        <xs:annotation>
          <xs:documentation>Gully. A small, steep-sided, v-shaped natural ditch. It is not occupied by a perennial stream. It is formed in clay or other easily eroded materials by the action of water during and immediately from an arroyo, which has perpendicular sides and a flat floor. See ravine.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL">
        <xs:annotation>
          <xs:documentation>Hill. A natural elevation of the terrain with a local relief between 150 and 600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL, HIGH">
        <xs:annotation>
          <xs:documentation>Hill, High. A natural elevation of the terrain with a local relief greater than 300 meters, but less than 600 meters. It has a surface slope of 30 percent or greater.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL, LOW">
        <xs:annotation>
          <xs:documentation>Hill, Low. A natural elevation of the terrain with a local relief greater than 150 meters, but less than 300 meters. It has a surface slope of less than 30 percent.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAGOON">
        <xs:annotation>
          <xs:documentation>Lagoon. A shallow sound, pond, or lake of salt or brackish water that is partly or completely separated from the sea by a bar, sand dunes, or a similar reef feature. Also, a body of water enclosed by the reefs or islands of an atoll.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAKEBED, DRY">
        <xs:annotation>
          <xs:documentation>Lakebed, Dry. An area occupied by a former lake in which the water has evaporated and/or seeped into porous surface materials. It is usually found in arid regions, and consists of flat to gently undulating deposits of well-sorted, fine textured materials.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOWLAND">
        <xs:annotation>
          <xs:documentation>Lowland. A small, flat area with a lower elevation than the surrounding or adjacent terrain. It is usually associated with coastal regions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARSH">
        <xs:annotation>
          <xs:documentation>Marsh. A low area of soft, wet, essentially treeless land. It is periodically inundated with water, and is covered by low rank vegetation such as cattails.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MESA">
        <xs:annotation>
          <xs:documentation>Mesa. A flat-topped, steep-sided hill or mountain smaller than a plateau and situated in an arid region. Although a mesa is generally an isolated feature, the term is also applied to any broad, flat, elevated arid surface which is bound at least on one side by a steep slope or escarpment. Not to be confused with a butte, which is almost entirely surrounded by escarpments.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MILITARY BASE">
        <xs:annotation>
          <xs:documentation>Military Base. A permanent or semi-permanent military facility located in a fixed or relatively fixed location, with its buildings, building equipment, and subsidiary facilities such as piers, spurs, and access roads. A base is used to perform military functions such as housing military personnel, logistics, or other support functions.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOUNTAIN, HIGH">
        <xs:annotation>
          <xs:documentation>Mountain, High. A natural land elevation with a local relief greater than 900 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOUNTAIN, LOW">
        <xs:annotation>
          <xs:documentation>Mountain, Low. A natural land elevation with a local relief between 600 and 900 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MUDFLATS">
        <xs:annotation>
          <xs:documentation>Mudflats. A deposit of fluid-to-plastic alluvium (commonly clay and silt) which is exposed or partially exposed at low tide along the coast, or in dry periods along inland rivers.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PADDY">
        <xs:annotation>
          <xs:documentation>Paddy. An irrigated field used for rice cultivation. It is bound by low ridges or dikes, and is completely covered by slow-moving water for considerable periods of time.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PARK">
        <xs:annotation>
          <xs:documentation>Park. A tract of ground kept in its natural state for game, or improved for recreational purposes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PETROLEUM STORAGE">
        <xs:annotation>
          <xs:documentation>Petroleum Storage. A facility for the storage of petroleum, oil, and lubricants.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN">
        <xs:annotation>
          <xs:documentation>Plain. An extensive, level, treeless region, such as a valley floor or a plateau summit. It has a local relief of less than 150 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, COASTAL">
        <xs:annotation>
          <xs:documentation>Plain, Coastal. An extensive level, rolling, or undulating area that extends from the sea to the nearest elevated land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, DISSECTED">
        <xs:annotation>
          <xs:documentation>Plain, Dissected. A plain cut extensively by watercourses, such as streams, streambeds, or rivers.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, FLAT">
        <xs:annotation>
          <xs:documentation>Plain, Flat. A plain with a local relief less than 15 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, FLOOD">
        <xs:annotation>
          <xs:documentation>Plain, Flood. An alluvial plain adjacent to a stream or river that is subject to flooding, which deposits soil on the plain.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, GENTLY ROLLING">
        <xs:annotation>
          <xs:documentation>Plain, Gently Rolling. A plain with a local relief between 45 to 89 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, ROLLING">
        <xs:annotation>
          <xs:documentation>Plain, Rolling. A plain with a local relief between 90 to 150 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN, UNDULATING">
        <xs:annotation>
          <xs:documentation>Plain, Undulating. A plain with a local relief between 15 to 44 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLATEAU">
        <xs:annotation>
          <xs:documentation>Plateau. A relatively level, elevated plain or tableland that is miles wide. It has a sharp drop of at least 90 meters on one side.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAYA">
        <xs:annotation>
          <xs:documentation>Playa. A nearly level area located at the bottom of a desert basin. It is sometimes temporarily covered with water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLODDER">
        <xs:annotation>
          <xs:documentation>Plodder. An area of low land reclaimed (usually by dikes or dams) from the sea or another body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POND">
        <xs:annotation>
          <xs:documentation>Pond. A body of water that is smaller than a lake. It is often constructed artificially.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="QUARRY">
        <xs:annotation>
          <xs:documentation>Quarry. An open pit used for excavating stone by digging, cutting, or blasting.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAVINE">
        <xs:annotation>
          <xs:documentation>Ravine. A deep, narrow cleft in the earth's surface. It is often created by the flow of water. Local relief is less than 90 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RESERVOIR">
        <xs:annotation>
          <xs:documentation>Reservoir. A natural or artificial lake or pond in which water is collected and stored for use.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER">
        <xs:annotation>
          <xs:documentation>River. A large natural surface stream that empties into an ocean, lake, or other body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SALTFLAT">
        <xs:annotation>
          <xs:documentation>Saltflat. A level salt-encrusted floor of a dried up lake, lagoon, or arm (bay, harbor, gulf, etc.) of the sea.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SALTPAN">
        <xs:annotation>
          <xs:documentation>Saltpan. A shallow, artificial pond used to naturally evaporate sea water to obtain salt.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SANDHILL">
        <xs:annotation>
          <xs:documentation>Sandhill. A hill or ridge composed of wind-deposited sand. It is stabilized by grass, scrub, or similar vegetation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAWALL">
        <xs:annotation>
          <xs:documentation>Seawall. An artificial structure that is built along part of the coast to prevent erosion by wave action.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPIT">
        <xs:annotation>
          <xs:documentation>Spit. A narrow point of land extending into a body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STREAM">
        <xs:annotation>
          <xs:documentation>Stream. A body of water that flows in a channel or bed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STREAM, INTERMITTENT">
        <xs:annotation>
          <xs:documentation>Stream, Intermittent. A stream located in a narrow channel. Its flow of water stops and starts at intervals.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SWAMP">
        <xs:annotation>
          <xs:documentation>Swamp. A lowland region saturated with water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SWAMP, MANGROVE">
        <xs:annotation>
          <xs:documentation>Swamp, Mangrove. An inundated tropical or subtropical coastal or riverside swamp that supports a dense growth of mangrove trees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TERRACE">
        <xs:annotation>
          <xs:documentation>Terrace. A raised bank of earth with vertical or sloping sides and a flat top.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TIDAL FLATS">
        <xs:annotation>
          <xs:documentation>Tidal Flats. A relatively broad, level flatland of sand, mud, or mud-sand which is periodically covered by the rise and fall of the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TOMBOLO">
        <xs:annotation>
          <xs:documentation>Tombolo. Unconsolidated material that is deposited by wave action or currents, such as a sand or gravel bar connecting an island with the mainland or another island.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TUNDRA">
        <xs:annotation>
          <xs:documentation>Tundra. A treeless area located between the arctic ice cap and treeline. It has a permanently frozen subsoil, and it supports low growing vegetation such as lichens, mosses, and stunted shrubs.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UPLAND">
        <xs:annotation>
          <xs:documentation>Upland. The higher elevation of a region or tract of land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VALLEY">
        <xs:annotation>
          <xs:documentation>Valley. An elongated, lowland area located between ranges of mountains, hills, or other uplands. It often has a river stream running along the bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WADI">
        <xs:annotation>
          <xs:documentation>Wadi. A valley, gully, or riverbed that remains dry except during the rainy season (such as in Northern Africa and Southwestern Asia).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
