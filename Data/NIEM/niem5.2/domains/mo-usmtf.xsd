  <xs:simpleType name="SecondaryStatusCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for a characteristic of a target/activity condition, occupancy status, amplifies an operational status or indicates a secondary status characteristic.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ABN">
        <xs:annotation>
          <xs:documentation>Abandoned. Target/installation appears devoid of all objects, vehicles, and equipment, and is not in condition to be of immediate use.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CCD">
        <xs:annotation>
          <xs:documentation>Camouflage Concealment, and Deception. Target/installations exhibit some form of camouflage, concealment, and deception activity. The Camouflage, Concealment, and Deception CCD status code will take precedence over all other secondary status codes that may apply. Add any amplifying remarks in another set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CEL">
        <xs:annotation>
          <xs:documentation>Capable of Emergency Launch. Target/installation has reached that point in construction where it is capable of launching its weapons in an emergency situation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLC">
        <xs:annotation>
          <xs:documentation>Cloud Covered. Target is completely obscured by clouds.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNA">
        <xs:annotation>
          <xs:documentation>Coverage Not Available. No imagery of the target is available.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COM">
        <xs:annotation>
          <xs:documentation>Complete. Target/installation appears to be externally complete. Appears capable of operating but operational status cannot be determined.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CVC">
        <xs:annotation>
          <xs:documentation>Conversion. Target is undergoing basic change from one activity to another (e.g., a missile site converting from an old to a new system).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEA">
        <xs:annotation>
          <xs:documentation>Deactivated. Targets that are no longer active, or have been dismantled.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DMG">
        <xs:annotation>
          <xs:documentation>Damaged. Target/installation has been damaged to some extent, but it may be restored to a usable status.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DMY">
        <xs:annotation>
          <xs:documentation>Dummy. An installation created solely for deception to look like an operational installation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DST">
        <xs:annotation>
          <xs:documentation>Destroyed. Target is so damaged that it cannot function as intended, nor be restored to a useable condition. In the case of buildings, all vertical supports and spanning members are damaged to an extent that nothing is salvageable. In the case of bridges, all spans must be dropped and all piers require replacement.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXS">
        <xs:annotation>
          <xs:documentation>Exercise. Target/installation is currently involved in an exercise condition.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LDG">
        <xs:annotation>
          <xs:documentation>Missile Loading and Unloading. Missile site is currently in the process of loading or unloading its weapons.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MNT">
        <xs:annotation>
          <xs:documentation>Periodic Maintenance. Target/installation is currently undergoing periodic maintenance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEG">
        <xs:annotation>
          <xs:documentation>Negated (Non-Existent). Target/installation does not exist at or near the coordinates given in the requirement.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOP">
        <xs:annotation>
          <xs:documentation>Not Operational. Essential elements of a target/installation are observed not to be in operation. Equipment essential to the operation of the installation is either missing or observed to be not operational.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NRL">
        <xs:annotation>
          <xs:documentation>Normal. Essential elements of a target/installation are observed with no unusual activity taking place based on a national statement of normal activity for that target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OCC">
        <xs:annotation>
          <xs:documentation>Occupied. A completed target/installation, and includes some but not all elements, objects, vehicles, and equipment essential for operational status. This term is also used in describing dummy installations that appear to be inhabited and contains some or all of the objects and equipment necessary to the accomplishment of its designed task.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OPR">
        <xs:annotation>
          <xs:documentation>Operational. Essential elements of a target/installation are observed in operation and/or key objects, vehicles, equipment, and other transportable items which are essential to the operation of the target/installation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RMV">
        <xs:annotation>
          <xs:documentation>Removed. Target/installation has been dismantled or removed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TRN">
        <xs:annotation>
          <xs:documentation>Transitory. Fleeting targets to include vehicles, equipment and/or personnel in transit as well as targets which appear to be only temporarily situated.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNC">
        <xs:annotation>
          <xs:documentation>Under Construction. Target/installation is being initially constructed or repaired, or construction action is underway that will structurally modify an established installation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown. Status of target cannot be determined. Term is used in describing a target/installation which may be interpreted to some degree, although the status/activity cannot be determined because of limiting factors, (e.g., imagery limitations, camouflage, jungle canopy, etc.).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNP">
        <xs:annotation>
          <xs:documentation>Unoccupied. Target/installation appears devoid of all objects, vehicles, or equipment, but remains in condition to be of immediate use.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
