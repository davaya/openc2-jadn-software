  <xs:simpleType name="BeachCompositionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the predominant material comprising the areas of the beach.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BOULDER">
        <xs:annotation>
          <xs:documentation>Boulder. A detached, rounded rock, 256 mm or more in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLAY">
        <xs:annotation>
          <xs:documentation>Clay. An aggregate of unconsolidated, flat, and extremely fine particles of mineral matter less than 0.005 mm in diameter. Commonly sticky and slippery when wet.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COBBLE">
        <xs:annotation>
          <xs:documentation>Cobble. Rounded rocks ranging from 76 to 256 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORAL">
        <xs:annotation>
          <xs:documentation>Coral. The calcareous skeletons of various forms of marine life.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GRAVEL">
        <xs:annotation>
          <xs:documentation>Gravel. An aggregate of loose pieces of rock ranging from 5 to 76 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MUD">
        <xs:annotation>
          <xs:documentation>Mud. A fine grained, fluid to plastic mixture of clay and/or silt and water which forms a wet, soft, sticky earth. Sometimes contains sand and/or organic materials.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PEBBLES">
        <xs:annotation>
          <xs:documentation>Pebbles. Usually smooth and rounded small stones ranging from 5 to 76 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROCK">
        <xs:annotation>
          <xs:documentation>Rock. A consolidated, coherent and relatively hard, naturally formed mass of mineral matter. Also an aggregate of angular pieces of stone larger than 76 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAND">
        <xs:annotation>
          <xs:documentation>Sand. A soil which is loose and single-grained, with individual grains ranging in size from 0.07 to 5 mm. Individual grains can readily be seen or felt. Squeezed when dry, the soil will fall apart. Squeezed when moist, the soil will form a cast, but the cast, but the cast will crumble when touched.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHELL">
        <xs:annotation>
          <xs:documentation>Shell. A hard ridged outer covering of an invertebrate marine animal.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHINGLE">
        <xs:annotation>
          <xs:documentation>Shingle. Larger and coarser than gravel. The space between fragments is not filled with finer materials.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SILT">
        <xs:annotation>
          <xs:documentation>Silt. A loose, fine sediment of natural mineral grains ranging from 0.005 to 0.07 mm in diameter, which lacks plasticity and has little or no cohesion when dry.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNKNOWN">
        <xs:annotation>
          <xs:documentation>Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VOLCANIC ASH">
        <xs:annotation>
          <xs:documentation>Volcanic Ash. Fine particles of lava (sand size) resembling ash which are ejected from volcanoes. Particles range from 0.25 to 5 mm in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
