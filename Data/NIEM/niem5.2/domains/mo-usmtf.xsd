  <xs:simpleType name="ControlMethodCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the method of controlling the fire mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AMC">
        <xs:annotation>
          <xs:documentation>At My Command. A portion of the method of fire and control message element which specifies the desire of the observer to control the time of delivery of fire during a mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AMF">
        <xs:annotation>
          <xs:documentation>At My Command, Fire for Effect. A method of control which specifies the desire of the spotter (observer) to control the time of delivery of fire of a Naval Surface Fire (NSF) immediate fire for effect mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ASA">
        <xs:annotation>
          <xs:documentation>At My Command, Spotter Adjust. A method of control which specifies the desire of the spotter (observer) to control the time of delivery of fire during a Naval Surface Fire (NSF) adjust fire mission.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNO">
        <xs:annotation>
          <xs:documentation>Cannot Observe. The observer cannot observe the fall of shot for the rounds or mission of concern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DNL">
        <xs:annotation>
          <xs:documentation>Do Not Load. A method of control used by a fire support facility exercising technical fire control to alert another facility that units under control of the second facility should follow adjustment commands but not load rounds.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SAD">
        <xs:annotation>
          <xs:documentation>Ship Adjust. A method of control in which a NSF ship adjusts its own fire on a target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPA">
        <xs:annotation>
          <xs:documentation>Spotter Adjust. A method of control in which the spotter (observer) adjusts the fire of a Naval Surface Fire (NSF) ship.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TOT">
        <xs:annotation>
          <xs:documentation>Time On Target. The method of control in which various artillery or Naval Surface Fire (NSF) ships so time their fire as to assure all projectiles reaching their target simultaneously.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WR">
        <xs:annotation>
          <xs:documentation>When Ready. The method of control in which rounds are fired when the guns are ready.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
