  <xs:simpleType name="IncidentCauseCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the cause of the incident.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AD-ARTY">
        <xs:annotation>
          <xs:documentation>Air Defense Artillery. Resulted from action by hostile land or naval air defense artillery.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AD-SAM">
        <xs:annotation>
          <xs:documentation>Air Defense Missile, Surface-to-Air. Resulted from action by hostile land or naval air defense surface-to-air missile(s).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIR-BOMBS">
        <xs:annotation>
          <xs:documentation>Bombs, Aerial. Resulted from aerial bombing by enemy aircraft (high explosive and incendiary type free fall and guided bombs).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AIR-STRFNG">
        <xs:annotation>
          <xs:documentation>Strafing, Aerial. Resulted from strafing by enemy aircraft using forward firing ordnance (bullets, shells, or rockets).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLSN-OBSTL">
        <xs:annotation>
          <xs:documentation>Collision, Obstacle. Resulted from damage sustained during collision with natural or man-made object (fixed or mobile).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CRASH">
        <xs:annotation>
          <xs:documentation>Impact, Surface. Resulted from crashing against a land or water surface.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FIELD-ARTY">
        <xs:annotation>
          <xs:documentation>Field Artillery. Resulted from artillery shelling.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FRND-FIRE">
        <xs:annotation>
          <xs:documentation>Friendly Fire. Resulted from friendly fire.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GND-ACDNT">
        <xs:annotation>
          <xs:documentation>Accident, Ground. Resulted from damage sustained during ground operations or maintenance.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GUN-AA">
        <xs:annotation>
          <xs:documentation>Gunnery, Air-to-Air. Resulted from hostile bullet or shell fire during air-to-air combat.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INTAC-URCVR">
        <xs:annotation>
          <xs:documentation>Intact but Unrecoverable. Resulted from aircraft landing in an area unsuitable for recovery due to political, military, or geographic/environmental considerations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MECHANICAL">
        <xs:annotation>
          <xs:documentation>Mechanical Problem. Resulted from mechanical problem.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MIDAIR">
        <xs:annotation>
          <xs:documentation>Collision, Mid-Air. Resulted from damage sustained during inflight collision with another aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MSLS-AG">
        <xs:annotation>
          <xs:documentation>Missiles, Air-to-Ground. Resulted from air-to-ground guided missile attack by hostile aircraft.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MSLS-RKT-AA">
        <xs:annotation>
          <xs:documentation>Missiles/Rockets, Air-to-Air. Resulted from missile or rocket attack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MSLS-RKT-SS">
        <xs:annotation>
          <xs:documentation>Missiles/Rockets, Surface-to-Surface. Resulted from surface-to-surface missile or rocket attack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NAV-SURFIRE">
        <xs:annotation>
          <xs:documentation>Naval Surface Fire. Resulted from naval shore bombardment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NUC-ACT">
        <xs:annotation>
          <xs:documentation>Nuclear Action. Resulted from nuclear blast, heat, radiation, or other nuclear effects.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SABOT-EXT">
        <xs:annotation>
          <xs:documentation>Sabotage, External. Resulted from sabotage by individual known or believed to be from outside the unit or installation affected.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
