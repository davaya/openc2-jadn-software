  <xs:simpleType name="HarborCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the part of a port which can accommodate business transactions between ship and shore. a port normally consists of a harbor plus terminal facilities. Harbors are classified according to location: bay, estuary, and river harbors.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CANAL">
        <xs:annotation>
          <xs:documentation>Canal. The facility is located within the boundaries of a canal.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COASTAL NATURAL">
        <xs:annotation>
          <xs:documentation>Coastal Natural. Located along the coastal region of an ocean or sea. The facility has no man-made structures to protect it from rough seas. All barriers are natural.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="COASTAL TIDE GATE">
        <xs:annotation>
          <xs:documentation>Coastal Tide Gate. Located along the coastal region of an ocean or sea. The facility uses a tide gate to negate the effects of the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAKE">
        <xs:annotation>
          <xs:documentation>Lake. The facility is located within the boundaries of a lake.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OPEN ROADSTEAD">
        <xs:annotation>
          <xs:documentation>Open Roadstead. A facility that is completely exposed and has no natural or artificial protection.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER BASIN">
        <xs:annotation>
          <xs:documentation>River Basin. Located along a river. This type of facility utilizes berths or rough seas.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER NATURAL">
        <xs:annotation>
          <xs:documentation>River Natural. Located along a river. The facility has no man-made structures to protect it from rough seas. All barriers are natural.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER TIDE GATE">
        <xs:annotation>
          <xs:documentation>River Tide Gate. Located along a river. The facility uses a tide gate to negate the effects of the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
