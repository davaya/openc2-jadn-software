  <xs:simpleType name="SearchPatternDesignatorCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for a coded system of letters used to designate search patterns.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Cross-Over Barrier. Search pattern used when target motion requires drift compensation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CS">
        <xs:annotation>
          <xs:documentation>Creeping Line Single-Unit. Search pattern where the commence search point is located one-half track spacing inside the corner of the search area. Distress is generally known to be between two points. Wider than trackline patterns.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CSC">
        <xs:annotation>
          <xs:documentation>Creeping Line Single-Unit Coordinated. Search pattern used when aircraft and either vessels or boats are available. Aircraft track is planned so that advance of successive legs of the search pattern equals that of the marine craft, and the aircraft passes over the vessel on each leg. Results in a more accurate search pattern, and enables quick rescue by marine craft once survivors are located.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FM">
        <xs:annotation>
          <xs:documentation>Flare Multiunit. Search pattern used only at night which is similar to the PMN pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FS">
        <xs:annotation>
          <xs:documentation>Flare Single-Unit. Search pattern used only at night and conducted by a single vessel or helicopter with an aircraft dropping flares. Effective mostly for large objects in well-defined search areas on flat land or at sea.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HMN">
        <xs:annotation>
          <xs:documentation>Homing Multiunit No Return. Same as HSA explanation. Electronic positioning used.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HSA">
        <xs:annotation>
          <xs:documentation>Homing Single-Unit Aural. Search pattern used to locate emergency transmitters or other radio or electronic emissions from survivors or distressed craft when the detected signal is too weak for homing equipment to receive or the SRU does not have homing equipment.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HSM">
        <xs:annotation>
          <xs:documentation>Homing Single-Unit Meter. Same as HSA explanation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OM">
        <xs:annotation>
          <xs:documentation>Contour Multiunit. Search pattern used in mountainous/hilly terrain by land search teams.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OS">
        <xs:annotation>
          <xs:documentation>Contour Single-Unit. Search pattern used in mountainous and hilly terrain. Adaptable to underwater SRUs for searching peaks on the ocean floor.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PD">
        <xs:annotation>
          <xs:documentation>Parallel Drift Compensated. Search pattern used when target motion requires drift compensation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PM">
        <xs:annotation>
          <xs:documentation>Parallel Track Multiunit. Same as PS explanation except that two or more SRUs search abeam each other separated by a distance equal to the track spacing. Provides accurate track spacing and fast area coverage, and an increased safety factor for aircraft over water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PMC">
        <xs:annotation>
          <xs:documentation>Parallel Multiunit Circle. Search pattern used by two or more underwater swimmers for search of small areas, generally less than 25 yards in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PMN">
        <xs:annotation>
          <xs:documentation>Parallel Track Multiunit Non-Return. Search pattern is similar to the PMR, except that SRUs continue to a destination other than the departure point. Normally used when en route vessels are available and will alter their tracks to provide uniform coverage of the search area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PMR">
        <xs:annotation>
          <xs:documentation>Parallel Track Multiunit Return. Search pattern used when simultaneous sweep of an area to maximum radius is desired; used for search of long rectangular area where only one track out and back is possible. Provides concentrated coverage of large areas in a minimum time period, and allows the use of aircraft with different speeds in a parallel search pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PS">
        <xs:annotation>
          <xs:documentation>Parallel Track Single-Unit. Search pattern used for large areas when the position of distress is unknown. Used for searching rectangular areas and is mostly used by fixed-wing aircraft. Search legs are oriented along the major axis, providing longer legs and fewer turns.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PSL">
        <xs:annotation>
          <xs:documentation>Parallel Track Single-Unit LORAN. Same as PS explanation except that SRU uses LORAN lines for greater navigational accuracy on tracks. Pattern must be oriented so legs flown by SRU are parallel to a system of LORAN lines which are selected at the track spacing desired. One of the most accurate search patterns for searching areas covered by LORAN, Omega, or similar navigational systems.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PSS">
        <xs:annotation>
          <xs:documentation>Parallel Single-Unit Spiral. Search pattern used by a single underwater swimmer for search of small areas, generally less than 25 yards in diameter.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SM">
        <xs:annotation>
          <xs:documentation>Square Multiunit. Same as SS explanation except two SRUs fly at different altitudes on tracks which differ by 45 degrees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SS">
        <xs:annotation>
          <xs:documentation>Square Single-Unit. Search pattern used where distress position is known within close limits or search area is not extensive.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TMN">
        <xs:annotation>
          <xs:documentation>Trackline Multiunit Non-Return. Same as TMR explanation except that search terminates at the opposite end of track from the commence search point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TMR">
        <xs:annotation>
          <xs:documentation>Trackline Multiunit Return. Same as TSR explanation except that two or more SRUs are used in an abeam formation to afford greater width coverage along track.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSN">
        <xs:annotation>
          <xs:documentation>Trackline Single-Unit Non-Return. Search pattern is along the track or datum line. SRU makes one or more searches along the track, but the search terminates at the opposite end of track from the commence search point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TSR">
        <xs:annotation>
          <xs:documentation>Trackline Single-Unit Return. Search pattern where the commence search point is offset one-half search track spacing from the trackline or datum. SRU runs up one side and down the other, ending one track space from where it began.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VS">
        <xs:annotation>
          <xs:documentation>Sector Single-Unit. Search pattern used where distress position is known within close limits or search area is not extensive.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VSR">
        <xs:annotation>
          <xs:documentation>Sector Single-Unit Radar. Same as VS explanation except that a radar-equipped marine craft takes station at the center of the pattern and provides radar navigation assistance to one aircraft completing a sector search pattern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
