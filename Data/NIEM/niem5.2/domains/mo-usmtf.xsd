  <xs:simpleType name="TaxiwayCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the type of taxiway at the airfield.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ALERT">
        <xs:annotation>
          <xs:documentation>Alert. A taxiway that provides clear and ready access to the runway for alert aircraft to takeoff.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CROSSOVER">
        <xs:annotation>
          <xs:documentation>Crossover. A more specific description of a link taxiway that only connects a parallel taxiway to the runway.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DISPERSAL">
        <xs:annotation>
          <xs:documentation>Dispersal. A taxiway, not fitting the other definitions, that allows aircraft to be located away from main aprons, parking facilities, and structures during times of emergency.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="END CONNECTING">
        <xs:annotation>
          <xs:documentation>End Connecting. A taxiway that connects the parallel taxiway to the runway at the end(s) of the runway.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LINK">
        <xs:annotation>
          <xs:documentation>Link. A taxiway that connects runways, taxiways, and parking facilities to each other.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LOOP">
        <xs:annotation>
          <xs:documentation>Loop. A taxiway that is normally located at one or both ends of the runway; starting at one end and returning to the runway, forming a loop, with parking facilities commonly located on the loop.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NONE">
        <xs:annotation>
          <xs:documentation>None.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PARALLEL">
        <xs:annotation>
          <xs:documentation>Parallel. A taxiway that parallels a runway or another taxiway, but is normally narrower than a runway. It may be of sufficient length and width to be used as a runway in an emergency.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PERIMETER">
        <xs:annotation>
          <xs:documentation>Perimeter. A taxiway that usually starts at one end of the runway and ends at the other. Perimeter taxiways are normally, but not necessarily, oval in shape. Perimeter taxiways may encompass the entire airfield, allowing access to refueling points, ammunition storage, and service areas.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TURNAROUND">
        <xs:annotation>
          <xs:documentation>Turnaround. A taxiway that is normally found at one of both ends of the runway that gives the aircraft the ability to do a u-turn. Aircraft may also be in a holding pattern on the turnaround apron. Unlike loop taxiways, a turnaround will not have a grass or earth center.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNKNOWN">
        <xs:annotation>
          <xs:documentation>Unknown.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
