        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HUNI">
        <xs:annotation>
          <xs:documentation>Horizontal Sector (Unidirectional). The uni-directional movement in a horizontal plane of emitted electromagnetic energy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IRR">
