  <xs:simpleType name="ResultDesiredCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the result desired from an air mission.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:documentation>Burn. Target or target elements are burning.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation>
          <xs:documentation>Destruction. Material attacked (or to be attacked) has been (or will be) destroyed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="F">
        <xs:annotation>
          <xs:documentation>Flak Suppression. Ordnance delivered (or to be delivered) have suppressed (or will suppress) antiaircraft fire immediately prior to and during an air attack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="H">
        <xs:annotation>
          <xs:documentation>Harassment. Ordnance delivered (or to be delivered) have disturbed (or will disturb) the rest, curtailed (or will curtail) the movement, and lowered (or will lower) the morale of enemy troops by threat of casualties or losses in material.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="I">
        <xs:annotation>
          <xs:documentation>Interdiction. Ordnance delivered (or to be delivered) have denied (or will deny) the enemy the unrestricted use of an area or point.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="L">
        <xs:annotation>
          <xs:documentation>Illumination. Ordnance delivered (or to be delivered) to provide illumination of an area during hours of darkness.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="N">
        <xs:annotation>
          <xs:documentation>Neutralization. Ordnance delivered (or to be delivered) have reduced (or will reduce) the combat effectiveness of the enemy by interrupting and hampering the fire of his weapons, by reducing his ability to inflict casualties on friendly forces and by severely reducing his movements within an area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="O">
        <xs:annotation>
          <xs:documentation>No Effect. Attack of the target had no significant effect on the target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Q">
        <xs:annotation>
          <xs:documentation>Search for. The desired result is to search for the SAR objective(s).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="R">
        <xs:annotation>
          <xs:documentation>Recover. The desired result is to recover the search and rescue (SAR) objectives.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="S">
        <xs:annotation>
          <xs:documentation>Smoke. Ordnance delivered (or to be delivered) to mark or obscure the target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
