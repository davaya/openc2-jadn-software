  <xs:simpleType name="HullProfileCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the surface ship hull profile, based upon the pattern of raised segments of hull profile.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="FLUSH">
        <xs:annotation>
          <xs:documentation>Flush Deck. No breaks in hull profile.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1">
        <xs:annotation>
          <xs:documentation>Raised 1. Hull profile shows distinct raised area at bow. Remainder of deck is flush.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1-2">
        <xs:annotation>
          <xs:documentation>Raised 1-2. Raised area at bow and midships, with a break between.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1-2-3">
        <xs:annotation>
          <xs:documentation>Raised 1-2-3. Distinct raised areas at bow, midships, and stern with breaks between each raise.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1-23">
        <xs:annotation>
          <xs:documentation>Raised 1-23. Raised areas at bow, midships, and stern. Midship and stern raises are continuous with break between bow and midship raises.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1-3">
        <xs:annotation>
          <xs:documentation>Raised 1-3. Raised area at bow and stern with break between.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 1-L2-3">
        <xs:annotation>
          <xs:documentation>Raised 1-Long 2-3. Raised areas at bow, midships, and stern with break between each raise. Midships raise is longer than that associated with raised 1-2-3.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 12">
        <xs:annotation>
          <xs:documentation>Raised 12. Continuous raised area encompassing both bow and midships.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 12-3">
        <xs:annotation>
          <xs:documentation>Raised 12-3. Raised areas at bow, midships, and stern. Bow and midship raises are continuous. Break between midship and stern raises.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 2">
        <xs:annotation>
          <xs:documentation>Raised 2. Hull profile shows distinct raised area amidships. Bow and stern are flush.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 23">
        <xs:annotation>
          <xs:documentation>Raised 23. Continuous raised area encompassing midship and stern.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RAISED 3">
        <xs:annotation>
          <xs:documentation>Raised 3. Hull profile shows distinct raised area at stern. Remainder of deck is flush.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
