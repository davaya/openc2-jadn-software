  <xs:simpleType name="MaritimeObstructionCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the feature or object, natural or man-made, which may impede free movement of landing craft or vehicles approaching the beach from the sea or moving on the beach.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ARCHIPELAGO">
        <xs:annotation>
          <xs:documentation>Archipelago. A sea studded with islands, or the islands themselves, considered collectively.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BAR">
        <xs:annotation>
          <xs:documentation>Bar. An elongated offshore ridge or mound composed of unconsolidated material such as sand, gravel, or shells. Bars are usually submerged, parallel to and a short distance from the coastline, often at the mouth of a river or estuary.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BARRIER REEF">
        <xs:annotation>
          <xs:documentation>Barrier Reef. An elongated ridge of rock or coral near and roughly parallel to the coast.  It is separated from the shore by the deep water of a lagoon, and is cut through at intervals by channels or passes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BEACH SWALE">
        <xs:annotation>
          <xs:documentation>Beach Swale. An elongated, sometimes marshy depression, between two ridges on the beach backshore (or on a sandspit) generally paralleling a shoreline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BREAKWATER">
        <xs:annotation>
          <xs:documentation>Breakwater. A long, solid, structure, sometimes attached to the shore, built to protect a shore area harbor, anchorage, or basin from the impact of waves.  A breakwater is usually made of stone, concrete blocks, rubble, or other material.  Breakwaters are usually associated with harbors and anchorages exposed to the open sea.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUILDING">
        <xs:annotation>
          <xs:documentation>Building. A fixed construction, covering a space on land (or in the immediate nearshore) usually covered with a roof, enclosed by walls, and designed to stand more or less permanently.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUOY">
        <xs:annotation>
          <xs:documentation>Buoy. A floating object, anchored in a river or ocean bottom and used as a navigation aid to mark a channel or hazard. The buoy may be attached by a line or cable to an anchor or weight lying on the bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CABANA">
        <xs:annotation>
          <xs:documentation>Cabana. A beach shelter, such as a cabin, hut, or bathhouse.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CABLE">
        <xs:annotation>
          <xs:documentation>Cable.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CORAL">
        <xs:annotation>
          <xs:documentation>Coral. A stony, solidified mass of calcareous skeletons from various forms of marine life.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FENCE">
        <xs:annotation>
          <xs:documentation>Fence. A barrier, usually marking a boundary consisting of wooden or metal pickets, or else supporting wire or rail.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FISHNET">
        <xs:annotation>
          <xs:documentation>Fishnet. A fish-catching device which is a fabric made from such materials as string and cord, woven in an open-work pattern.  It may be suspended over water and attached to poles or the fishnet may lie on the bottom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FISHSTAKE">
        <xs:annotation>
          <xs:documentation>Fishstake. Bamboo like material used to channel fish into a funnel-like trap.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GROIN">
        <xs:annotation>
          <xs:documentation>Groin. A shore protective structure (built usually perpendicular to the shore to trap littoral drift or retard erosion of the shore).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HEADLAND">
        <xs:annotation>
          <xs:documentation>Headland. A comparatively high, steep-faced promontory, which projects into a body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ICE">
        <xs:annotation>
          <xs:documentation>Ice. Frozen lake.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INLET">
        <xs:annotation>
          <xs:documentation>Inlet. A narrow arm of the sea, which may extend a considerable distance inland - a shore channel connecting a bay to a lagoon or a lagoon with the sea - a narrow strip between islands.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ISLAND">
        <xs:annotation>
          <xs:documentation>Island. A land mass completely surrounded by water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ISLET">
        <xs:annotation>
          <xs:documentation>Islet. A very small island, which is a land mass exposed during all tidal conditions, and its longest axis is 100 meters or less.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JETTY">
        <xs:annotation>
          <xs:documentation>Jetty. Usually constructed in pairs at the mouth of a river, inlet, or a harbor entrance. This is to prevent deposition of sand in the channel; regulate, restrain, and divert currents; and protect vessels.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MILITARY">
        <xs:annotation>
          <xs:documentation>Military. Any man-made device (except mines) or passive defense works such as a barrier which is designed to stop, impede, or divert movement of amphibious landing forces to or on the beach or shore.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MINE">
        <xs:annotation>
          <xs:documentation>Mine. An encased explosive or other material (e.g., chemicals) designed to destroy material or to wound, kill, or otherwise incapacitate personnel. Mines are laid on or below the surface of the ground and/or in inland waterways or the sea approach area, so as to stop, delay, or divert amphibious landing or ground force movement. In the sea approach, the fixed mine is either bottomlaid or moored by a cable to an anchor or weight in the water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MOLE">
        <xs:annotation>
          <xs:documentation>Mole. A massive, solid fill structure projecting at an angle from the shore.  A mole may serve as a pier or breakwater or both. It is usually quayed on one or more sides. Its broad surface may support buildings, cargo handling equipment, rail spurs, and roads.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MUDFLAT">
        <xs:annotation>
          <xs:documentation>Mudflat. A muddy or sandy coated strip usually submerged by high tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NONE">
        <xs:annotation>
          <xs:documentation>None. There is no amphibious landing obstruction on the beach or shore or its approach.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OTHER">
        <xs:annotation>
          <xs:documentation>Other. Explain the use of other in a subsequent free-text set.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PIER">
        <xs:annotation>
          <xs:documentation>Pier. A long, narrow structure which provides berthing for ships.  It extends into a body of water at an angle to the shore and is made of piles, stone, or concrete.  A pier may be straight, T-beachd, or L-beachd, with berthing along both sides and at its ends. It may support storage facilities, cargo handling equipment, and railroad tracks.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PILING">
        <xs:annotation>
          <xs:documentation>Piling. Wood, metal, or reinforced concrete poles driven into the land or sea bottom, singly, or in clusters (dolphins).  Pilings extend above water to serve as supports, as for a pier, protection for moorings, or to resist lateral pressure.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PIPELINE">
        <xs:annotation>
          <xs:documentation>Pipeline. A line of pipes, including pumping machinery, servicing, and supporting structures, used for conveying liquids, gases, or finely crushed solids (e.g., slurry).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="POINT">
        <xs:annotation>
          <xs:documentation>Point. A small promontory which projects into a body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REEF">
        <xs:annotation>
          <xs:documentation>Reef. A low coastal ridge of rock or coral which is offshore (barrier reef) or closely attached to the shore (fringing reef). Most reefs extend upward from the sea floor and lie at or near the water surface at a depth which makes them a danger to surface vessels. Most reefs are submerged, especially at high tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER">
        <xs:annotation>
          <xs:documentation>River. A natural stream of water which flows permanently or seasonally. A river has greater volume than a creek or rivulet, flows in a more or less permanent bed or channel between defined banks or walls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ROCK">
        <xs:annotation>
          <xs:documentation>Rock. A consolidated or coherent and relatively hard, naturally formed mass of mineral matter. Also an aggregate of angular pieces of stone larger than 76 mm (3 inches) in diameter. Rock may occur as an isolated rocky formation or a single large stone. In the sea it may be submerged, uncovered, or alternatively covered and uncovered by the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RUIN">
        <xs:annotation>
          <xs:documentation>Ruin. The remains of a cultural feature such as a building, or an object that has been destroyed or has decayed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RUNNEL">
        <xs:annotation>
          <xs:documentation>Runnel. An elongated trough or depression of the beach on the foreshore or near shore bottom, approximately parallel to the shoreline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAWALL">
        <xs:annotation>
          <xs:documentation>Seawall. A man-made structure, such as rock or concrete wall or embankment, built along a portion of coast.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SEAWEED">
        <xs:annotation>
          <xs:documentation>Seaweed. Underwater plant life such as seagrass and marine algae.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHOAL">
        <xs:annotation>
          <xs:documentation>Shoal. Part of a sea bottom below the surface of the sea composed of, or covered by, sand, gravel, or unconsolidated sediments which may endanger surface navigation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SPIT">
        <xs:annotation>
          <xs:documentation>Spit. A low, elongated, exposed deposit of waterborne sediment, such as a reef, shoal, or sandbank, which protrudes from the shore and terminates in the water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STAKE">
        <xs:annotation>
          <xs:documentation>Stake. A length of material, usually metal or wood, pointed at one end for driving into the ground. May be used for such purposes as anchoring a fish trap, as a boundary marker, or as a military obstacle. May be submerged.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STREAM">
        <xs:annotation>
          <xs:documentation>Stream. A narrow body of flowing water or other fluid, great or small, occupying a channel on land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TIDAL FLAT">
        <xs:annotation>
          <xs:documentation>Tidal Flat. A relatively broad, virtually level coastal flatland of sand, mud, or mudsand which is periodically covered and uncovered by the rise and fall of the tide.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WALL">
        <xs:annotation>
          <xs:documentation>Wall. A continuous, vertical structure, such as a concrete or rock wall serving to enclose, divide, support or protect an area on land. Includes seawalls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WRECK">
        <xs:annotation>
          <xs:documentation>Wreck. A hulk or ruin of a wrecked or stranded ship, either submerged or visible, which is attached to or foul on the bottom, or cast up on the shore.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
