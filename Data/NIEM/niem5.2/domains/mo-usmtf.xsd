  <xs:simpleType name="FriendlyFireSupportEffectCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code for the effect or result of friendly artillery fire, naval surface fire, or close air support, stated in terms of the type of fire employed to achieve those results.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BURN">
        <xs:annotation>
          <xs:documentation>Burn. Target or target elements are burning.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DEST">
        <xs:annotation>
          <xs:documentation>Destruction. Materiel attacked (or to be attacked) has been (or will be) destroyed.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FLKSUP">
        <xs:annotation>
          <xs:documentation>Flak Suppression. Fires delivered (or to be delivered) have suppressed (or will suppress) antiaircraft fire immediately prior to and during an air attack. Not currently used in NATO.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HRSSMT">
        <xs:annotation>
          <xs:documentation>Harassment. Fires delivered (or to be delivered) have disturbed (or will disturb) the rest, curtailed (or will curtail) the movement, and lowered (or will lower) the morale of enemy troops by threat of casualties or losses in material. Not currently used in NATO.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ILLUM">
        <xs:annotation>
          <xs:documentation>Illumination. Fires delivered (or to be delivered) to provide illumination of an area during hours of darkness. Not currently used in NATO.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="INT">
        <xs:annotation>
          <xs:documentation>Interdiction. Fires delivered (or to be delivered) have denied (or will deny) the enemy the unrestricted use of an area or point. Not currently used in NATO.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEBN">
        <xs:annotation>
          <xs:documentation>Neutralized, Burning. Fires delivered have neutralized the target and the target or target elements are burning.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NEUT">
        <xs:annotation>
          <xs:documentation>Neutralization. Fires delivered (or to be delivered) have reduced (or will reduce) the combat effectiveness of the enemy by interrupting and hampering the fire of his weapons, by reducing his freedom of action, by reducing his ability to inflict casualties on friendly forces and by severely reducing his movements within an area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOEF">
        <xs:annotation>
          <xs:documentation>No Effect. Attack of the target had no significant effect on the target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SMOKE">
        <xs:annotation>
          <xs:documentation>Smoke. Fires delivered (or to be delivered) to mark or obscure the target.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNK">
        <xs:annotation>
          <xs:documentation>Unknown Effect. The effect of attack of the target is not known.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
