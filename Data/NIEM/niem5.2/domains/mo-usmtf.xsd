          <xs:documentation>Constructing.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CTRATK">
        <xs:annotation>
          <xs:documentation>Counterattack.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DCA">
        <xs:annotation>
          <xs:documentation>Defensive Counterair. A term for air operations conducted to attain and maintain a desired degree of air superiority by the destruction or neutralization of enemy forces, conducted near to or over friendly territory and generally reactive to the initiative of the enemy air forces.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DECEPT">
