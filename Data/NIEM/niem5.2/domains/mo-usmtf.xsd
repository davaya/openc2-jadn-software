        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GANTRY CRANE">
        <xs:annotation>
          <xs:documentation>Gantry Crane. Cranes characterized by a massive, horizontal beam or bridge supported by one or two attached vertical uprights or elevated runways.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GIANT HAMMERHEAD CRANE">
        <xs:annotation>
          <xs:documentation>Giant Hammerhead Crane. A group of cranes characterized by a horizontal, counterbalanced beam or arm mounted on a tower.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GIN POLE DERRICK">
        <xs:annotation>
          <xs:documentation>Gin Pole Derrick. Cranes characterized by an apparatus consisting of a vertical mast held at top by guys or braces, with or without a boom (jib), and operated by a hoisting mechanism.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GUTTED CRANE">
        <xs:annotation>
          <xs:documentation>Gutted Crane. Cranes characterized by an apparatus consisting of a vertical mast held at top by guys or braces, with or without a boom (jib), and operated by a hoisting mechanism.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JIB CRANE">
        <xs:annotation>
          <xs:documentation>Jib Crane. Cranes characterized by an inclined jib or boom.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SHEARLEG CRANE">
        <xs:annotation>
          <xs:documentation>Shearleg Crane. A type of crane characterized by an a-frame secured to the ground and braced at the top by lines or a rigid member.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STIFF-LEG DERRICK">
        <xs:annotation>
          <xs:documentation>Stiff-Leg Derrick. Cranes characterized by an apparatus consisting of a vertical mast held at top by guys or braces, with or without a boom (jib), and operated by a hoisting mechanism.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TITAN CRANE">
        <xs:annotation>
          <xs:documentation>Titan Crane. A group of cranes characterized by a horizontal, counterbalanced beam or arm mounted on a tower.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TOWER HAMMERHEAD CRANE">
        <xs:annotation>
          <xs:documentation>Tower Hammerhead Crane. A group of cranes characterized by a horizontal, counterbalanced beam or arm mounted on a tower.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TOWER TRANSPORTER CRANE">
        <xs:annotation>
