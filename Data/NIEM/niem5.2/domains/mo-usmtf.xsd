  <xs:simpleType name="TerrainFeatureCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the predominant type of natural or man-made terrain feature (homogeneous major land form) forming a specific terrain feature zone.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ARYO">
        <xs:annotation>
          <xs:documentation>Arroyo. The course of an intermittent stream steep-cut in loose earth. Subject to sudden, temporary flooding.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BALD">
        <xs:annotation>
          <xs:documentation>Bald. A high, rounded knob or mountain top. Bare of forest and significant undergrowth.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLF-HI">
        <xs:annotation>
          <xs:documentation>Bluff, High. An abrupt slope consisting of relatively unconsolidated earth, more than 50 feet high, usually bordering a stream or body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BLF-LO">
        <xs:annotation>
          <xs:documentation>Bluff, Low. An abrupt slope consisting of relatively unconsolidated earth, less than 50 feet high, usually bordering a stream or body of water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BUTTE">
        <xs:annotation>
          <xs:documentation>Butte. A steep hill, usually flat-topped, standing alone in a plain, usually consists almost entirely of consolidated rock.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLDR">
        <xs:annotation>
          <xs:documentation>Caldera. A broad, crater-like basin of a volcano, formed by an explosion or collapse of the cone.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLF-HI">
        <xs:annotation>
          <xs:documentation>Cliff, High. A steep face of rock rising more than 50 feet above the surrounding land or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CLF-LOW">
        <xs:annotation>
          <xs:documentation>Cliff, Low. A steep face of rock rising to a maximum of 50 feet higher than the surrounding land or water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="CNYN">
        <xs:annotation>
          <xs:documentation>Canyon. A deep ravine or gorge with steep sides, usually located in arid or semi-arid area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DESERT">
        <xs:annotation>
          <xs:documentation>Desert. A region rendered barren or partially barren by environmental extremes such as low rainfall, and conforms to lands having discontinuous vegetation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DFL">
        <xs:annotation>
          <xs:documentation>Defile. A deep, narrow mountain pass.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DIKE">
        <xs:annotation>
          <xs:documentation>Dike. An artificial earth or stone embankment or wall constructed to contain or hold back water as a measure to prevent the flooding or delimiting of a reclaimed area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DN-HI">
        <xs:annotation>
          <xs:documentation>Dune, High. A mound, ridge, or hill of wind-deposited sand, 10 feet high or higher.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DN-LOW">
        <xs:annotation>
          <xs:documentation>Dune, Low. A mound, ridge, or hill of wind-deposited sand, less than 10 feet high.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ESCPMT">
        <xs:annotation>
          <xs:documentation>Escarpment. A more or less continuous line of cliffs, bluffs, or steep slopes along the margin of a plateau, mesa, terrace, or beach.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FN-ALVL">
        <xs:annotation>
          <xs:documentation>Fan, Alluvial. A gentle-sloping, fan-shaped mass of unconsolidated material deposited by a stream, usually at the place where the stream emerges from a highland. As at the mouth of a canyon.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="GLCR">
        <xs:annotation>
          <xs:documentation>Glacier. A field or mass of ice and snow formed on land by snowfall in excess of melting which moves down a mountain slope or over a wide area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL">
        <xs:annotation>
          <xs:documentation>Hill. A natural elevation of the terrain having local relief of from 150 to 600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL-H-G">
        <xs:annotation>
          <xs:documentation>Hill, High-Gentle. A natural elevation of terrain, having local relief of more than 300 meters, but less than 600 meters, and surface slope less than 30 percent (30-meter rise per 100-meter horizontal distance).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL-H-S">
        <xs:annotation>
          <xs:documentation>Hill, High-Steep. A natural elevation of the terrain having local relief of more than 300 meters, but less than 600 meters, and surface slopes 30 percent or steeper (30-meter rise per 100-meter horizontal distance).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL-L-G">
        <xs:annotation>
          <xs:documentation>Hill, Low-Gentle. A natural elevation of the terrain, having local relief from 150 to 300 meters, and surface slopes of less than 30 percent (30-meter rise per 100-meter horizontal distance).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HILL-L-S">
        <xs:annotation>
          <xs:documentation>Hill, Low-Steep. A natural elevation of the terrain, having local relief from 150 to 300 meters, and surface slopes 30 percent or steeper (30-meter rise per 100-meter horizontal distance).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ICE-FLD">
        <xs:annotation>
          <xs:documentation>Icefield. An area of sea ice more than five nautical miles in width.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="JUNGLE">
        <xs:annotation>
          <xs:documentation>Jungle. Land densely overgrown with thicket and growth, usually tropical vegetation and trees.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LAKE">
        <xs:annotation>
          <xs:documentation>Lake. A considerable inland body of standing water.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MARSH">
        <xs:annotation>
          <xs:documentation>Marsh (Swamp). A track of soft, wet land.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MESA">
        <xs:annotation>
          <xs:documentation>Mesa. An area of considerable elevation, usually flat-topped, with steep sides, generally located in an arid or semi-arid area.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MT">
        <xs:annotation>
          <xs:documentation>Mountain. A natural land elevation having local relief in excess of 600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MT-HI">
        <xs:annotation>
          <xs:documentation>Mountain, High. A natural land elevation having local relief in excess of 900 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MT-LOW">
        <xs:annotation>
          <xs:documentation>Mountain, Low. A natural land elevation having local relief from 600 to 900 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PEAK">
        <xs:annotation>
          <xs:documentation>Peak. A pointed mountain summit, including the topmost elevation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PLAIN">
        <xs:annotation>
          <xs:documentation>Plain. A relatively flat area of land having little or no change in gradient.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PNSLA">
        <xs:annotation>
          <xs:documentation>Peninsula. A body of land jutting into and nearly surrounded by water, usually connected to a larger body of land by a neck or isthmus.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="PRCPC">
        <xs:annotation>
          <xs:documentation>Precipice. A brink or edge of a high and very steep cliff.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIDGE">
        <xs:annotation>
          <xs:documentation>Ridge. The long, narrow top or crest of a hill or mountain.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="RIVER">
        <xs:annotation>
          <xs:documentation>River. A natural stream of water which flows permanently or seasonally. A river has greater volume than a creek or rivulet and flows in a more or less permanent bed or channel between defined banks or walls.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SCARP">
        <xs:annotation>
          <xs:documentation>Scarp. A steep slope, escarpment, or cliff extending along the edge of a plateau or mesa.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SLT-FLT">
        <xs:annotation>
          <xs:documentation>Salt Flat. The salt-encrusted, level floor of a dried-up salt lake.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SMIT">
        <xs:annotation>
          <xs:documentation>Summit. The highest point or peak of a mountain range (series of peaks).</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SNOFLD">
        <xs:annotation>
          <xs:documentation>Snowfield. A large expanse of snow, the duration of which may vary between extended and perpetual coverage.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VALLEY">
        <xs:annotation>
          <xs:documentation>Valley. A relatively wide, elongated lowland lying between hills, mountains, or other elevated landforms, commonly traversed by a stream.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="VLCNO">
        <xs:annotation>
          <xs:documentation>Volcano. An opening in the earth's crust through which hot lava and ash are ejected. A mountain (usually conical) formed wholly or in part by volcanic action.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="WADI">
        <xs:annotation>
          <xs:documentation>Wadi. A ravine or watercourse that is dry except during the rainy season.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
