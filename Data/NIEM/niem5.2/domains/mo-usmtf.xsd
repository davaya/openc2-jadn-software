  <xs:simpleType name="AffirmativeAbbreviatedCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the code to indicate if a decision, requirement, or condition is affirmative.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
