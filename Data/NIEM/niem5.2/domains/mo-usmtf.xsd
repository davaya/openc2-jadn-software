  <xs:simpleType name="CloudBaseHeightCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for the height, in tens of meters, of the base of the lowest cloud above the MET station altitude or Mean Datum Plane (MDP).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="000">
        <xs:annotation>
          <xs:documentation>Obscured. Sky obscured by fog.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="166">
        <xs:annotation>
          <xs:documentation>Visually Estimated Above 1600 Meters. Visual estimate is that base of lowest cloud is above 1600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="199">
        <xs:annotation>
          <xs:documentation>No Clouds. The sky is clear.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="466">
        <xs:annotation>
          <xs:documentation>Searchlight or Laser Estimated Above 1600 Meters. The base of the lowest cloud observed by searchlight or laser is above 1600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="477">
        <xs:annotation>
          <xs:documentation>Unreliable Searchlight or Laser Observation. Searchlight or laser observations are unreliable.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="499">
        <xs:annotation>
          <xs:documentation>Searchlight or Laser No Cloud. No cloud has been detected by searchlight or laser.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="666">
        <xs:annotation>
          <xs:documentation>Balloon Loss Above 1600 Meters. The height of the base of the lowest cloud in which a balloon was lost was above 1600 meters.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="677">
        <xs:annotation>
          <xs:documentation>Unreliable Balloon Observation. Balloon observations are unreliable.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
