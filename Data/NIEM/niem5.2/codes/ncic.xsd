  <xs:simpleType name="PCOCodeSimpleType">
    <xs:annotation>
      <xs:documentation>A data type for 19 - Protection Order Conditions (PCO) Field Codes</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="01">
        <xs:annotation>
          <xs:documentation>THE SUBJECT IS RESTRAINED FROM ASSAULTING, THREATENING, ABUSING, HARASSING, FOLLOWING, INTERFERING, OR STALKING THE PROTECTED PERSON AND/OR THE CHILD OF THE PROTECTED PERSON.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="02">
        <xs:annotation>
          <xs:documentation>THE SUBJECT MAY NOT THREATEN A MEMBER OF THE PROTECTED PERSON S FAMILY OR HOUSEHOLD.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="03">
        <xs:annotation>
          <xs:documentation>PROTECTED PERSON IS GRANTED EXCLUSIVE POSSESSION OF THE RESIDENCE OR HOUSEHOLD.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="04">
        <xs:annotation>
          <xs:documentation>THE SUBJECT IS REQUIRED TO STAY AWAY FROM THE RESIDENCE, PROPERTY, SCHOOL, OR PLACE OF EMPLOYMENT OF THE PROTECTED PERSON OR OTHER FAMILY OR HOUSEHOLD MEMBER.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="05">
        <xs:annotation>
          <xs:documentation>THE SUBJECT IS RESTRAINED FROM MAKING ANY COMMUNICATION WITH THE PROTECTED PERSON INCLUDING BUT NOT LIMITED TO, PERSONAL, WRITTEN, OR TELEPHONE CONTACT, OR THEIR EMPLOYERS, EMPLOYEES OR FELLOW WORKERS, OR OTHERS WITH WHOM THE COMMUNICATION WOULD BE LIKELY TO CAUSE ANNOYANCE OR ALARM THE VICTIM</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="06">
        <xs:annotation>
          <xs:documentation>THE SUBJECT HAS VISITATION OR CUSTODY RIGHTS OF THE CHILD(REN)NAMED.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="07">
        <xs:annotation>
          <xs:documentation>THE SUBJECT IS PROHIBITED FROM POSSESSING AND/OR PURCHASING A FIREARM OR OTHER WEAPONS AS IDENTIFIED IN THE MISCELLANEOUS FIELD.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="08">
        <xs:annotation>
          <xs:documentation>SEE THE MISCELLANEOUS FIELD FOR COMMENTS REGARDING THE TERMS AND CONDITIONS OF THE ORDER.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="09">
        <xs:annotation>
          <xs:documentation>THE PROTECTED PERSON IS AWARDED TEMPORARY EXCLUSIVE CUSTODY OF THE CHILD(REN) NAMED.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
